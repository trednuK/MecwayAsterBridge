ISO-10303-21;
HEADER;
/* Hand-written test file for section_step.py: POLYLINE, TRIMMED_CURVE,
   SEAM_CURVE, reversed ORIENTED_EDGE, FACE_SURFACE, POLY_LOOP, VERTEX_LOOP,
   comments, escaped quotes, centimetre unit. */
FILE_DESCRIPTION(('section_step test; it''s hand-written'),'2;1');
FILE_NAME('misc_entities.step','2026-01-01T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('origin; with ''quotes'' and #99 = X;',(0.,0.,0.));
#2 = DIRECTION('',(0.,0.,1.));
#3 = DIRECTION('',(1.,0.,0.));
#4 = AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5 = PLANE('',#4);
/* outer boundary: polyline (0,0)-(10,0)-(10,10), trimmed line to (0,10),
   seam curve back to (0,0) used reversed */
#10 = CARTESIAN_POINT('',(0.,0.,0.));
#11 = CARTESIAN_POINT('',(10.,0.,0.));
#12 = CARTESIAN_POINT('',(10.,10.,0.));
#13 = CARTESIAN_POINT('',(0.,10.,0.));
#20 = VERTEX_POINT('',#10);
#21 = VERTEX_POINT('',#12);
#22 = VERTEX_POINT('',#13);
#30 = POLYLINE('',(#10,#11,#12));
#31 = EDGE_CURVE('',#20,#21,#30,.T.);
#32 = DIRECTION('',(-1.,0.,0.));
#33 = VECTOR('',#32,1.);
#34 = LINE('',#12,#33);
#35 = TRIMMED_CURVE('',#34,(PARAMETER_VALUE(0.)),(PARAMETER_VALUE(10.)),
  .T.,.PARAMETER.);
#36 = EDGE_CURVE('',#21,#22,#35,.T.);
#37 = DIRECTION('',(0.,1.,0.));
#38 = VECTOR('',#37,1.);
#39 = LINE('',#10,#38);
#40 = SEAM_CURVE('',#39,(#5,#5),.CURVE_3D.);
#41 = EDGE_CURVE('',#20,#22,#40,.T.);
#50 = ORIENTED_EDGE('',*,*,#31,.T.);
#51 = ORIENTED_EDGE('',*,*,#36,.T.);
#52 = ORIENTED_EDGE('',*,*,#41,.F.);
#53 = EDGE_LOOP('',(#50,#51,#52));
#54 = FACE_OUTER_BOUND('',#53,.T.);
/* hole: full circle r=2 around (5,5) through a reversed TRIMMED_CURVE */
#60 = CARTESIAN_POINT('',(5.,5.,0.));
#61 = AXIS2_PLACEMENT_3D('',#60,#2,#3);
#62 = CIRCLE('',#61,2.);
#63 = CARTESIAN_POINT('',(7.,5.,0.));
#64 = VERTEX_POINT('',#63);
#65 = TRIMMED_CURVE('',#62,(#63),(#63),.F.,.CARTESIAN.);
#66 = EDGE_CURVE('',#64,#64,#65,.T.);
#67 = ORIENTED_EDGE('',*,*,#66,.T.);
#68 = EDGE_LOOP('',(#67));
#69 = FACE_BOUND('',#68,.T.);
/* degenerate vertex loop, ignored */
#70 = VERTEX_LOOP('',#20);
#71 = FACE_BOUND('',#70,.T.);
#80 = FACE_SURFACE('square with hole',(#54,#69,#71),#5,.T.);
/* triangle with a POLY_LOOP */
#90 = CARTESIAN_POINT('',(20.,0.,0.));
#91 = CARTESIAN_POINT('',(30.,0.,0.));
#92 = CARTESIAN_POINT('',(20.,10.,0.));
#93 = POLY_LOOP('',(#90,#91,#92));
#94 = FACE_OUTER_BOUND('',#93,.T.);
#95 = FACE_SURFACE('triangle',(#94),#5,.T.);
#100 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.CENTI.,.METRE.) );
#101 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#102 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101)) REPRESENTATION_CONTEXT('',
  '') );
ENDSEC;
END-ISO-10303-21;
