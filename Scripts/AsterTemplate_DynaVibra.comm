# 2. MODEL, SECTIONS, MATERIALS (as in MECA_STATIQUE)
# =====================================================
{model_block}

{cara_elem_block}

{materials_block}

{fieldmat_block}

# =====================================================
# 3. TIME FUNCTIONS AND LOADS
# =====================================================
{load_funcs_block}

{loads_block}

# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21) AND EIGENMODES (CALC_MODES, U4.52.02)
# =====================================================
{assemblage_block}

{calc_modes_block}

# =====================================================
