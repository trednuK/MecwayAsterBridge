# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for CALC_MODES: modal analysis (Mecway V30, natural frequencies
# and mode shapes) and linear buckling (Mecway B30, buckling load factors
# and buckling shapes). Filled in via str.format() from bridge_to_aster.py
# (_build_modal).
#
# Placeholders (name between single braces):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE (as in
#                        MECA_STATIQUE)
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (beams, shells, springs, point masses)
#   materials_block   -> DEFI_MATERIAU per material (with RHO)
#   fieldmat_block    -> AFFE_MATERIAU assignment
#   loads_block       -> AFFE_CHAR_MECA's: modal without prestress only
#                        the supports and couplings; buckling and modal with
#                        prestress also the loads
#   static_block      -> buckling and modal with prestress: MECA_STATIQUE with
#                        all loads and the stress field SIEF_ELGA from it;
#                        modal without prestress: comment
#   assemblage_block  -> ASSEMBLAGE: stiffness (RIGI_MECA) and mass
#                        (MASS_MECA) and/or geometric stiffness
#                        (RIGI_GEOM); with prestress also RIGI_ROTA
#                        (centrifugal) and COMB_MATR_ASSE K + Kg
#   calc_modes_block  -> res = CALC_MODES(...)
#   export_block      -> aster_results_export (Mecway results: one
#                        <mode> per mode shape/buckling shape)
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
# and the setting vtu_export (aster_vtu)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
_bridge_os.environ['BRIDGE_VTU'] = '0'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(NOM='BRMAIT1', MAILLE=('M29', 'M30', 'M31', 'M32',)),
    CREA_GROUP_NO=_F(NOM='BRESCL1', NOEUD=('N262', 'N265', 'N266', 'N269', 'N273', 'N274', 'N277', 'N281',
            'N282', 'N285', 'N286', 'N289', 'N293', 'N295', 'N297', 'N300',
            'N302', 'N305', 'N307', 'N309', 'N312',)),
)


# =====================================================
# 2. MODEL, SECTIONS, MATERIALS (as in MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='A', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='B', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


#-- not used in this analysis --


# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='A', MATER=MAT_1),
        _F(GROUP_MA='B', MATER=MAT_1),
    ),
)


# =====================================================
# 3. BOUNDARY CONDITIONS (and for buckling the loads)
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    LIAISON_MAIL=_F(GROUP_MA_MAIT='BRMAIT1', GROUP_NO_ESCL='BRESCL1', TYPE_RACCORD='MASSIF'),
)


# =====================================================
# 4. STATIC ANALYSIS AND STRESS FIELD (BUCKLING; MODAL WITH PRESTRESS)
# =====================================================
#-- not applicable (modal without prestress) --


# =====================================================
# 5. MATRICES (ASSEMBLAGE, U4.61.21)
# The supports (dualisation, Lagrange multipliers) enter the
# matrices via CHARGE; their value plays no role.
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CHARGE=(load_1,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


# =====================================================
# 6. EIGENVALUES (CALC_MODES, U4.52.02)
# =====================================================
# Free-free: search frequency below 0 (bridge_to_aster._FREE_SHIFT_BLOCK)
import numpy as _np
def _bridge_diag(_m):
    _v, _r, _c, _n = _m.getValuesWithDescription()
    _r, _c, _v = _np.asarray(_r), _np.asarray(_c), _np.asarray(_v)
    _d = _np.zeros(_n)
    _d[_r[_r == _c]] = _v[_r == _c]
    return _d
_kd, _md = _bridge_diag(rigidite), _bridge_diag(masse)
_ok = (_md > 0.0) & (_kd > 0.0)
bridge_fshift = 1.0
if _ok.any():
    bridge_fshift = max(1.0e-3, float(_np.sqrt(1.0e-8 * (_kd[_ok] / _md[_ok]).max())) / (2.0 * _np.pi))
print('BRIDGE_FREE_SHIFT', bridge_fshift)
res = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='CENTRE',
    CALC_FREQ=_F(FREQ=-bridge_fshift, NMAX_FREQ=8),
    CHAM_MATER=fieldmat,
    NORM_MODE=_F(NORME='MASS_GENE'),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)


# =====================================================
# 7. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.print_modes(res, mass=masse)
aster_results_export.export_results(
    res, '<WORKDIR>\\MO-10\\MO-10_verif_results.xml', '<WORKDIR>\\MO-10\\MO-10.liml',
    fields=['displacements'], precision='double')


#-- no MED export (setting med_export off) --


FIN()
