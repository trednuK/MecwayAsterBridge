# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for the response on a modal basis (Mecway Dynamic Response D30 with
# Mode superposition): eigenmodes (CALC_MODES), projection of mass,
# stiffness and loads onto the modes (PROJ_BASE), the modal equations
# in time (DYNA_VIBRA BASE_CALCUL='GENE') and back to the nodes
# (REST_GENE_PHYS). Filled in via str.format() from bridge_dyna_modal.py.
#
# Placeholders (name between single braces):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (beams, shells, springs, point masses)
#   materials_block   -> DEFI_MATERIAU per material (with RHO)
#   fieldmat_block    -> AFFE_MATERIAU assignment
#   load_funcs_block  -> DEFI_FONCTION per time-dependent component
#   loads_block       -> AFFE_CHAR_MECA(_F): supports and loads,
#                        plus the loads per time function (gload_*)
#   assemblage_block  -> ASSEMBLAGE: RIGI_MECA and MASS_MECA with the
#                        supports
#   calc_modes_block  -> modes = CALC_MODES(...) and the mode overview
#   projection_block  -> load vectors (CALC_VECT_ELEM, ASSE_VECTEUR)
#                        and PROJ_BASE
#   dyna_block        -> modal damping, time step, (static correction,)
#                        DYNA_VIBRA and REST_GENE_PHYS -> res
#   calc_champ_block  -> CALC_CHAMP (stresses) on res
#   export_block      -> aster_results_export (Mecway results per time step)
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# =====================================================
# 2. MODEL, SECTIONS, MATERIALS (as in MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Balk', PHENOMENE='MECANIQUE', MODELISATION='POU_D_E'),
    ),
)


cara = AFFE_CARA_ELEM(
    MODELE=model,
    POUTRE=_F(GROUP_MA='Balk',
           SECTION='RECTANGLE',
           CARA=('HY', 'HZ',),
           VALE=(0.02, 0.03,)),
    ORIENTATION=_F(GROUP_MA='BOR00001', CARA='VECT_Y', VALE=(0.0, 1.0, 0.0)),
)


# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Balk', MATER=MAT_1),
    ),
)


# =====================================================
# 3. TIME FUNCTIONS AND LOADS
# =====================================================
#-- no time-dependent loads in this model --


bridge_f0 = DEFI_CONSTANTE(VALE=0.0)
bridge_f1 = DEFI_CONSTANTE(VALE=1.0)
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_NO='Inklemming', BLOCAGE=('DEPLACEMENT', 'ROTATION')),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Tip', FY=100.0),
)



# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21) AND EIGENMODES (CALC_MODES, U4.52.02)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    CHARGE=(load_1,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=1),
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    NORM_MODE=_F(NORME='MASS_GENE'),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
# Mode overview (frequency, effective mass) in the .mess
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.print_modes(modes, mass=masse)


# =====================================================
# 5. PROJECTION ONTO THE MODES (PROJ_BASE, U4.63.11)
# =====================================================
vel_1 = CALC_VECT_ELEM(OPTION='CHAR_MECA', CHARGE=load_2, CHAM_MATER=fieldmat, CARA_ELEM=cara)
vec_1 = ASSE_VECTEUR(VECT_ELEM=vel_1, NUME_DDL=numedd)
PROJ_BASE(
    BASE=modes,
    STOCKAGE='DIAG',
    MATR_ASSE_GENE=(
        _F(MATRICE=CO('mgen'), MATR_ASSE=masse),
        _F(MATRICE=CO('kgen'), MATR_ASSE=rigidite),
    ),
    VECT_ASSE_GENE=(
        _F(VECTEUR=CO('fgen_1'), VECT_ASSE=vec_1, TYPE_VECT='FORC'),
    ),
)


# =====================================================
# 6. MODAL EQUATIONS IN TIME (DYNA_VIBRA GENE, U4.53.03) AND
#    BACK TO THE NODES (REST_GENE_PHYS, U4.63.31)
# =====================================================
# Modal damping: Mecway's Rayleigh damping C = alpha M + beta K is
# per mode xi_i = (alpha / w_i + beta w_i) / 2 (Mecway manual sec.
# 9.26), plus the setting modal_damping.
import math as _math
bridge_freqs = [float(_f) for _f in modes.getAccessParameters()['FREQ']]
bridge_alpha, bridge_beta, bridge_zeta = 20.0, 0.0, 0.0
bridge_xi = []
for _f in bridge_freqs:
    _w = 2.0 * _math.pi * _f
    if _w <= 0.0:
        # Rigid body motion or mechanism: Mecway does not allow it
        # either (manual sec. 6.4); bridge_run_aster reports the cause.
        print('BRIDGE_DYNA_MODAL_FOUT FREQ mode=%d f=%g' % (len(bridge_xi) + 1, _f))
        raise ValueError('mode superposition: mode met f <= 0')
    bridge_xi.append(0.5 * (bridge_alpha / _w + bridge_beta * _w) + bridge_zeta)
for _i, (_f, _x) in enumerate(zip(bridge_freqs, bridge_xi)):
    print('BRIDGE_DEMPING mode %d: %.6g Hz, xi = %.6g' % (_i + 1, _f, _x))
if max(bridge_xi) >= 1.0:
    # Mecway: xi < 1 for every mode (manual sec. 6.4, 9.26).
    print('BRIDGE_DYNA_MODAL_FOUT DEMPING mode=%d xi=%g' % (bridge_xi.index(max(bridge_xi)) + 1, max(bridge_xi)))
    raise ValueError('mode superposition: dempingsverhouding >= 1')

# Time step: 50 steps per period of the highest mode (NEWMARK,
# period error (w dt)^2 / 12), a whole number per output interval.
bridge_inc, bridge_nout = 0.01, 200
bridge_nsub = max(1, int(_math.ceil(bridge_inc * max(bridge_freqs) * 50)))
bridge_pas = bridge_inc / bridge_nsub
print('BRIDGE_DYNA_MODAL rekenstap %g s (%d per uitvoerinterval), %d stappen' % (bridge_pas, bridge_nsub, bridge_nsub * bridge_nout))

tran = DYNA_VIBRA(
    TYPE_CALCUL='TRAN',
    BASE_CALCUL='GENE',
    SCHEMA_TEMPS=_F(SCHEMA='NEWMARK'),
    MATR_MASS=mgen,
    MATR_RIGI=kgen,
    AMOR_MODAL=_F(AMOR_REDUIT=bridge_xi),
    INCREMENT=_F(PAS=bridge_pas, INST_FIN=bridge_inc * bridge_nout),
    ARCHIVAGE=_F(PAS_ARCH=bridge_nsub),
    EXCIT=(
        _F(VECT_ASSE_GENE=fgen_1, FONC_MULT=bridge_f1),
    ),
)

res = REST_GENE_PHYS(
    RESU_GENE=tran,
    TOUT_INST='OUI',
    NOM_CHAM=('DEPL', 'VITE', 'ACCE',),
)


# =====================================================
# 7. STRESSES AND RESULTS TO MECWAY
# =====================================================
# Stresses on the physical response (linear in the displacements)
# Beams: extreme axial stress in the cross-section.
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    GROUP_MA=('Balk',),
    CONTRAINTE=('SIPM_ELNO', ),
)



# Results in Mecway's own format (bridge: result_route='liml')
aster_results_export.export_results(
    res, '<WORKDIR>\\MD-06a\\MD-06a_verif_results.xml', '<WORKDIR>\\MD-06a\\MD-06a.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf')
                       if k in globals()),
    precision='single', static=False, fields=['displacements', 'velocities', 'stresses', 'vonmises'])


#-- no MED export (setting med_export off) --


FIN()
