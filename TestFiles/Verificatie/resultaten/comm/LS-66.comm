        _F(NOEUD=('N535', 'N142',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N535', 'N142',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N535', 'N142',), DDL=('DRX', 'DRX',), COEF_MULT=(-1.0, 1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N536', 'N141', 'N141',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, -0.001,), COEF_IMPO=0.0),
        _F(NOEUD=('N536', 'N141', 'N141',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, 0.001,), COEF_IMPO=0.0),
        _F(NOEUD=('N536', 'N141',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
