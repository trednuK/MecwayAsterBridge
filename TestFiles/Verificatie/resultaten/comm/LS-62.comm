        _F(NOEUD=('N65', 'N3', 'N3',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, -0.052500000000000005,), COEF_IMPO=0.0),
        _F(NOEUD=('N65', 'N3',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
