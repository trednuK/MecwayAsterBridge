# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor MECA_STATIQUE (lineair-statische analyse).
# Compatibel met Code-Aster v16 en v17.
# Invulling via Python str.format() vanuit bridge_to_aster.py
# (_build_lin_static).
#
# Placeholders (worden ingevuld door bridge_to_aster.py via str.format).
# In dit bronbestand staan ze als naam tussen enkele accolades; in de
# gegenereerde study.comm zijn ze vervangen door de werkelijke Code-Aster code:
#
#   defigroup_block   -> DEFI_GROUP (coupling-slaves, knoopgroepen per
#                        richting, groepen voor tabellen), evt. CREA_MAILLAGE
#                        en MODI_MAILLAGE ORIE_PEAU (of commentaar)
#   model_block       -> AFFE_MODELE per elset (POU_D_E / DKT / COQUE_3D /
#                        3D / DIS_T / DIS_TR)
#   cara_elem_block   -> AFFE_CARA_ELEM balk-, schaal-, veer- en POI1-
#                        eigenschappen (of commentaar)
#   materials_block   -> DEFI_MATERIAU per materiaal (incl. RHO)
#   fieldmat_block    -> AFFE_MATERIAU toewijzing
#   loads_block       -> AFFE_CHAR_MECA's: load_1 met randvoorwaarden en
#                        couplings, daarna een per belasting
#   excit_clause      -> EXCIT met alle lasten
#   cara_elem_ref     -> "    CARA_ELEM=cara,\n" of "" in MECA_STATIQUE
#   solveur_ref       -> "    SOLVEUR=_F(METHODE=.., ..),\n    INFO=2,\n"
#   calc_champ_block  -> CALC_CHAMP (+ POST_CHAMP voor schalen), velden
#                        afhankelijk van element-typen
#   postreleve_block  -> POST_RELEVE_T tabellen
#   impr_table_block  -> IMPR_TABLE aanroepen
#   impr_resu_block   -> IMPR_RESU MED (alleen met "med_export")
#
# LETOP accolades in dit bronbestand:
#   Code-Aster .comm-syntax gebruikt GEEN accolades, dus normaal hoeft
#   er niets ge-escaped te worden. Voeg je ooit een accolade toe die
#   GEEN placeholder is, verdubbel deze dan ({ of }) zodat str.format()
#   er geen KeyError op gooit.

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH INLEZEN
# FORMAT='ASTER': mesh rechtstreeks uit de .liml (bridge_mesh.py)
# UNITE=20 komt overeen met 'F mail ... D 20' in study.export
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. STANDAARD GROEPEN AANMAKEN (alle elementen / knopen)
# 'all_nodes' (afgeleid van 'all_elems') wordt door POST_RELEVE_T
# gebruikt om alle knopen te exporteren naar het .resu-bestand.
# DEFI_GROUP moet NA LIRE_MAILLAGE en VOOR AFFE_MODELE staan.
# =====================================================
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

# =====================================================
# 2b. KNOOPGROEPEN VOOR RANDVOORWAARDEN (en mesh-aanpassingen)
# Gegenereerd door _build_defigroup_block() in bridge_to_aster.py:
#   - CREA_GROUP_NO per coupling-slave op een faceselection
#     (GROUP_MA=vlakgroep) en voor balktabellen; de Mecway-selecties
#     zelf staan al als groep in het mesh (bridge_mesh.py)
#   - CREA_MAILLAGE MODI_MAILLE (QUAD8_9 / TRIA6_7) voor COQUE_3D
#   - MODI_MAILLAGE ORIE_PEAU voor drukvlakken op volume-elementen
# Meerdere entries staan als tuple: CREA_GROUP_NO=(_F(...), _F(...),)
# Is er niets van dit alles, dan staat hier:
#   #-- not used in this analysis --
# =====================================================
#-- not used in this analysis --


# =====================================================
# 3. MODEL DEFINITIE
# Gegenereerd door bridge_to_aster.py op basis van elset-dimensies.
# Per elset wordt de bijbehorende MODELISATION gekozen:
#   1D (line2)              -> POU_D_E   (Euler-balk; alleen SEG2)
#   2D lineair (tri3/quad4)       -> DKT
#   2D kwadratisch (tri6/quad8)   -> COQUE_3D (na CREA_MAILLAGE MODI_MAILLE)
#   veren (1D met veer-materiaal) -> DIS_T
#   vlakken met druk (op volume)  -> 3D (randelementen)
#   losse knopen (POI1)           -> DIS_T / DIS_TR (zie bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Zonder elsets, drukvlakken en POI1-knopen wordt TOUT='OUI',
# MODELISATION='3D' gebruikt.
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Flens', PHENOMENE='MECANIQUE', MODELISATION='DKT'),
        _F(GROUP_MA='Lijf', PHENOMENE='MECANIQUE', MODELISATION='POU_D_E'),
    ),
)


# =====================================================
# 3b. SECTIE-EIGENSCHAPPEN (balken, schalen, veren)
# Gegenereerd door bridge_to_aster.py op basis van Mecway <geometric>-data.
#
# POUTRE: balkdoorsneden (CERCLE, RECTANGLE, ...) per GROUP_MA
#   Voorbeeld: _F(GROUP_MA='Beam1', SECTION='CERCLE', CARA=('R',), VALE=(0.005,))
#   Balk-orientatie: balken met een eigen V-as in Mecway krijgen
#   ORIENTATION CARA='VECT_Y' (model_data["beam_vect_y"]); zonder eigen
#   orientatie zijn de standaarden van Mecway en Code-Aster gelijk.
#
# COQUE: plaat-/schaaldikten per GROUP_MA
#   Voorbeeld: _F(GROUP_MA='Plate1', EPAIS=0.001)
#
# DISCRET: veer-elementen (DIS_T met K_T_D_L stijfheidsmatrix) en
#          losse knopen (POI1, K_T_D_N / K_TR_D_N met stijfheid 0),
#          elk met een aparte massa-entry 0 (M_T_D_L / M_T_D_N / M_TR_D_N)
#   Voorbeeld: _F(GROUP_MA='Spring1', CARA='K_T_D_L', VALE=(4231.0, 0.0, 0.0))
#
# Zonder balk-, schaal- of veersecties en zonder POI1-knopen staat hier:
#   #-- not used in this analysis --
# =====================================================
cara = AFFE_CARA_ELEM(
    MODELE=model,
    COQUE=_F(GROUP_MA='Flens', EPAIS=0.005),
    POUTRE=_F(GROUP_MA='Lijf',
           SECTION='RECTANGLE',
           CARA=('HY', 'HZ',),
           VALE=(0.005, 0.1,)),
)


# =====================================================
# 4. MATERIAAL-DEFINITIE
# Gegenereerd door bridge_to_aster.py op basis van Mecway-materialen.
# Alle waarden in SI-eenheden (Pa, kg/m3, dimensieloos).
# RHO wordt altijd opgenomen (default 0.0) voor compatibiliteit met
# PESANTEUR.
# Conceptnamen MAT_1, MAT_2, ... met de Mecway-naam als commentaar erboven.
# Voorbeeld: MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)
# =====================================================
# materiaal 'Plaat5'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=0.0),)
# materiaal 'Lijf'
MAT_2 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=0.0),)


# =====================================================
# 5. MATERIAAL-TOEWIJZING
# Koppelt materialen aan element-sets (GROUP_MA) of, bij afwezigheid
# van elsets, het eerste materiaal aan alle elementen (TOUT='OUI').
# DISCRET-elsets (veren) worden overgeslagen; hun eigenschappen staan
# uitsluitend in AFFE_CARA_ELEM.
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Flens', MATER=MAT_1),
        _F(GROUP_MA='Lijf', MATER=MAT_2),
    ),
)


# =====================================================
# 6. RANDVOORWAARDEN EN BELASTINGEN
# Gegenereerd door bridge_to_aster.py vanuit model_data["bcs"] en
# model_data["couplings"]. Ondersteunde Code-Aster keywords:
#   DDL_IMPO       - inklemming, opgelegde verplaatsing/rotatie
#   FORCE_NODALE   - puntkrachten
#   PRES_REP       - oppervlaktedruk
#   PESANTEUR      - zwaartekracht (vereist RHO in materiaal)
#   LIAISON_SOLIDE - rigid body coupling (RBE2)
#   LIAISON_RBE3   - distributing coupling (RBE3)
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_NO='Inklemming_knopen', BLOCAGE=('DEPLACEMENT', 'ROTATION')),
    LIAISON_DDL=(
        _F(NOEUD=('N64', 'N4', 'N4',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, 0.052500000000000005,), COEF_IMPO=0.0),
        _F(NOEUD=('N64', 'N4', 'N4',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, -0.052500000000000005,), COEF_IMPO=0.0),
