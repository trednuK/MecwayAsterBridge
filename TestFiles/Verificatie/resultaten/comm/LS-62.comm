        _F(NOEUD=('N81', 'N53',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N81', 'N53',), DDL=('DRZ', 'DRZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N82', 'N56', 'N56',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, 0.052500000000000005,), COEF_IMPO=0.0),
        _F(NOEUD=('N82', 'N56', 'N56',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, -0.052500000000000005,), COEF_IMPO=0.0),
        _F(NOEUD=('N82', 'N56',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N82', 'N56',), DDL=('DRX', 'DRX',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N82', 'N56',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N82', 'N56',), DDL=('DRZ', 'DRZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N83', 'N59', 'N59',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, 0.052500000000000005,), COEF_IMPO=0.0),
        _F(NOEUD=('N83', 'N59', 'N59',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, -0.052500000000000005,), COEF_IMPO=0.0),
        _F(NOEUD=('N83', 'N59',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N83', 'N59',), DDL=('DRX', 'DRX',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N83', 'N59',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N83', 'N59',), DDL=('DRZ', 'DRZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N84', 'N62', 'N62',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, 0.052500000000000005,), COEF_IMPO=0.0),
        _F(NOEUD=('N84', 'N62', 'N62',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, -0.052500000000000005,), COEF_IMPO=0.0),
        _F(NOEUD=('N84', 'N62',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N84', 'N62',), DDL=('DRX', 'DRX',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N84', 'N62',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N84', 'N62',), DDL=('DRZ', 'DRZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
    ),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Tip', FZ=-100.0),
)


# =====================================================
# 7. SOLVER: LINEAIR STATISCH
# MECA_STATIQUE lost Ku=F op voor lineair elastisch gedrag.
# CARA_ELEM=cara staat erin zodra stap 3b een AFFE_CARA_ELEM bevat
# (balk-, schaal-, veersecties of POI1-knopen); anders weggelaten.
# SOLVEUR (instelling "lin_solver"): MUMPS (direct) met NPREC uit
# "solver_nprec" (Code-Aster-default 8) en RESI_RELA ("lin_solver_resi",
# default 1e-6) als grens voor de geschatte fout op de oplossing; of GCPC
# (iteratief, PRE_COND='LDLT_INC') met RESI_RELA als residu-criterium.
# INFO=2: statistiek van de oplosser in de .mess (convergentiescherm).
# =====================================================
res = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    EXCIT=(
        _F(CHARGE=load_1),
        _F(CHARGE=load_2),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8, RESI_RELA=1e-06, POSTTRAITEMENTS='FORCE'),
    INFO=2,
)

# =====================================================
# 8. POST-PROCESSING VELDEN BEREKENEN  (CALC_CHAMP)
# Gegenereerd door bridge_to_aster.py op basis van element-typen.
#
# REAC_NODA:
#   Eigen aanroep zonder GROUP_MA (alle knopen); met elastic support
#   zonder de veren (BRES*), zodat de veerkracht de reactie is.
#
# SIGM_NOEU / SIEQ_NOEU:
#   Alleen op de 3D-elsets (GROUP_MA). Schaalspanningen hebben
#   sub-punten (lagen) en passen niet in een NOEU-veld. Zonder
#   3D-elsets (ook bij AFFE_MODELE TOUT='OUI') vervalt deze aanroep.
#
# Schalen (DKT / COQUE_3D):
#   SIGM_ELNO -> POST_CHAMP EXTR_COQUE ('SUP', 'MOY' en 'INF')
#   -> SIEQ_ELNO -> SIEQ_NOEU in res_sup / res_moy / res_inf.
#
# Balken (POU_D_E, doorsnede RECTANGLE of CERCLE):
#   SIPM_ELNO = SIXXMIN / SIXXMAX in de doorsnede.
#
# Foutschatter (instelling error_estimator, alleen volume-elementen):
#   eigen model, last en resultaat res_err, dan CALC_ERREUR ERME_ELEM /
#   ERME_ELNO / ERME_NOEU; zie _error_estimator_block() en
#   docs/Foutschatter.md.
#
# Zie _build_calc_champ_block() in bridge_to_aster.py.
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Schalen: spanningen per laag (sub-punten) -> boven-, midden-
# en ondervlak apart extraheren (POST_CHAMP EXTR_COQUE).
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Flens',),
    CONTRAINTE=('SIGM_ELNO', ),
)

res_sup = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Flens',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='SUP',
    ),
)
res_sup = CALC_CHAMP(reuse=res_sup, RESULTAT=res_sup, GROUP_MA=('Flens',), CRITERES=('SIEQ_ELNO', ))
res_sup = CALC_CHAMP(reuse=res_sup, RESULTAT=res_sup, GROUP_MA=('Flens',), CRITERES=('SIEQ_NOEU', ))

res_moy = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Flens',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='MOY',
    ),
)
res_moy = CALC_CHAMP(reuse=res_moy, RESULTAT=res_moy, GROUP_MA=('Flens',), CRITERES=('SIEQ_ELNO', ))
res_moy = CALC_CHAMP(reuse=res_moy, RESULTAT=res_moy, GROUP_MA=('Flens',), CRITERES=('SIEQ_NOEU', ))

res_inf = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Flens',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='INF',
    ),
)
res_inf = CALC_CHAMP(reuse=res_inf, RESULTAT=res_inf, GROUP_MA=('Flens',), CRITERES=('SIEQ_ELNO', ))
res_inf = CALC_CHAMP(reuse=res_inf, RESULTAT=res_inf, GROUP_MA=('Flens',), CRITERES=('SIEQ_NOEU', ))

# Balken: extreme axiale spanning in de doorsnede.
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Lijf',),
    CONTRAINTE=('SIPM_ELNO', ),
)



# =====================================================
# 9. RESULTAAT-EXTRACTIE NAAR TABELLEN  (POST_RELEVE_T)
# Gegenereerd door bridge_to_aster.py op basis van element-typen.
# Verplaatsingen en reactiekrachten worden altijd geextraheerd.
# tab_sigm / tab_vmis : 3D-elsets
# tab_vmss / tab_vmsm / tab_vmsi : schalen, von Mises boven/midden/onder
# tab_sipm            : balken (RECTANGLE / CERCLE), SIXXMIN / SIXXMAX
# INTITULE is maximaal 16 tekens (Code-Aster kapt langere af).
#
# Aparte tabellen per veld zodat INTITULE (parts[0] in de parser)
# het veld uniek identificeert in AsterToMecway_results()
# in bridge_from_aster.py.
# =====================================================
#-- tabellen niet nodig (result_route='liml') --


# =====================================================
# 10. TABELLEN WEGSCHRIJVEN NAAR .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# Alleen de tabellen die in stap 9 zijn aangemaakt worden geschreven.
# =====================================================
# Resultaten in Mecway's eigen formaat (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\LS-62\\LS-62_verif_results.xml', '<WORKDIR>\\LS-62\\LS-62.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err')
                       if k in globals()),
    precision='double')


# =====================================================
# 11. EXPORT NAAR MED-FORMAAT (ParaView / Salome), alleen met de
# instelling "med_export" (bridge_to_aster._build_impr_resu_block;
# UNITE=80 -> 'F rmed ... R 80' in study.export). Mecway krijgt de
# resultaten via de .liml of de tabellen, niet via een exportbestand.
# =====================================================
