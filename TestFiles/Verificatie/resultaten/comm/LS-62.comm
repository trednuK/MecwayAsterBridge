        _F(NOEUD=('N65', 'N3',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N65', 'N3',), DDL=('DRZ', 'DRZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
