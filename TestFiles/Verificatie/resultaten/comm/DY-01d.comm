    ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE',
             SUBD_METHODE='MANUEL', SUBD_PAS=4,
             SUBD_NIVEAU=6),
)



# =====================================================
# 7. BOUNDARY CONDITIONS AND LOADS  (AFFE_CHAR_MECA / _F)
# load_1: boundary conditions (DDL_IMPO, LIAISON_*) and couplings; then one
# load per load case (FORCE_*, PRES_REP, PESANTEUR), because Code-Aster
# overwrites loads within one load instead of adding them. Components with
# a time history refer to the DEFI_FONCTION's from step 6a
# (AFFE_CHAR_MECA_F, or FONC_MULT in EXCIT for a moment on faces).
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO='Grond', DX=0.0, DY=0.0, DZ=0.0),
        _F(GROUP_NO='Massa', DY=0.0, SANS_GROUP_NO=('Grond',)),
        _F(GROUP_NO='Massa', DZ=0.0, SANS_GROUP_NO=('Grond',)),
    ),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Massa', FX=10.0),
)


# =====================================================
# 8. SOLVER: NONLINEAR DYNAMICS  (DYNA_NON_LINE)
# Implicit (HHT/NEWMARK): Newton-Raphson per time step; explicit
# (DIFF_CENT/TCHAMWA): diagonal mass, no iterations, STOP_CFL.
# Contact (DEFI_CONTACT, CONTINUE) and the initial velocity (ETAT_INIT VITE)
# are in this block if the model has them.
#
#   CARA_ELEM     - only if step 3b contains an AFFE_CARA_ELEM.
#   EXCIT         - all loads from step 7 (load_1, load_2, ...).
#   COMPORTEMENT  - per elset (and POI1 group): RELATION ('ELAS',
#                   'VMIS_ISOT_TRAC', 'VMIS_ISOT_LINE', 'VMIS_CINE_LINE',
#                   'CABLE' or for gaps 'DIS_CHOC') and DEFORMATION from
#                   CONFIG_BRIDGE ("deformation", default 'GROT_GDEP';
#                   per elset the form that Code-Aster accepts,
#                   bridge_to_aster._deformation_for). Without elsets:
#                   TOUT='OUI', 'ELAS'.
#   INCREMENT     - LIST_INST is linked to listinst (step 6b).
#   SOLVEUR       - MUMPS with NPREC from CONFIG_BRIDGE ("solver_nprec").
#   NEWTON        - REAC_ITER from CONFIG_BRIDGE ("newton_reac_iter",
#                   default 1 = tangent matrix every iteration).
#   CONVERGENCE   - RESI_GLOB_RELA and ITER_GLOB_MAXI from CONFIG_BRIDGE
#                   ("convergence_resi_rela", "newton_max_iter").
# =====================================================
try:
    res = DYNA_NON_LINE(
        MODELE=model,
        CHAM_MATER=fieldmat,
        CARA_ELEM=cara,
        EXCIT=(
            _F(CHARGE=load_1),
            _F(CHARGE=load_2),
        ),
        COMPORTEMENT=(
            _F(GROUP_MA='Veer', RELATION='ELAS', DEFORMATION='PETIT'),
            _F(GROUP_MA='BRMA1', RELATION='ELAS', DEFORMATION='PETIT'),
        ),
        INCREMENT=_F(LIST_INST=listinst),
        SCHEMA_TEMPS=_F(SCHEMA='NEWMARK', FORMULATION='DEPLACEMENT'),
        ARCHIVAGE=_F(LIST_INST=outlist),
        SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
        NEWTON=_F(REAC_ITER=1),
        CONVERGENCE=_F(RESI_GLOB_RELA=1e-05, ITER_GLOB_MAXI=20),
    )
except Exception as err:
    _pe_id = str(getattr(err, 'id_message', '') or '')
    try:
        _pe_inst = list(res.getAccessParameters()['INST'])
    except Exception:
        _pe_inst = []
    if not _pe_id or not _pe_inst or not (
            _pe_id.startswith('MECANONLINE') or len(_pe_inst) > 1):
        raise
    print('BRIDGE_FOUT_ID', _pe_id)
    print('BRIDGE_ONVOLLEDIG', _pe_inst[-1])
t_res = res.getAccessParameters()['INST'][-1]


# =====================================================
# 9. COMPUTE POST-PROCESSING FIELDS  (CALC_CHAMP)
# Same fields as MECA_STATIQUE; if at least one material has a
# hardening curve, the following are added on the 3D elsets:
#   EPSP_NOEU  - plastic strain tensor
#   VARI_NOEU  - internal variables (V1 = eq. plastic strain)
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)



# =====================================================
# 10. RESULT EXTRACTION
# All archived time steps: route 'liml' (default) via
# aster_results_export, route 'tabel' with POST_RELEVE_T TOUT_ORDRE='OUI'
# (the table has a column INST).
# =====================================================
#-- tables not needed (result_route='liml') --


# =====================================================
# 11. WRITE TABLES TO .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\DY-01d\\DY-01d_verif_results.xml', '<WORKDIR>\\DY-01d\\DY-01d.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    failures=globals().get('_bz_events'),
    precision='single')


# =====================================================
# 12. EXPORT TO MED FORMAT (ParaView / Salome), only with the
# setting "med_export" (bridge_to_aster._build_impr_resu_block;
# UNITE=80 -> 'F rmed ... R 80' in study.export). Mecway receives the
# results via the .liml or the tables, not via an export file.
# =====================================================
#-- no MED export (setting med_export off) --


