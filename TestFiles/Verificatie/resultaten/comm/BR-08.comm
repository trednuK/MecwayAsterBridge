            'N683', 'N685', 'N687', 'N690', 'N692', 'N695', 'N697', 'N699',
            'N702', 'N704', 'N706', 'N709', 'N711', 'N713', 'N716', 'N718',
            'N720', 'N723', 'N725', 'N728', 'N730', 'N732', 'N735', 'N737',
            'N739', 'N742', 'N744', 'N746', 'N749', 'N751', 'N753', 'N756',
            'N758', 'N761', 'N763', 'N765', 'N768', 'N770', 'N772', 'N775',
            'N777', 'N779', 'N782', 'N784', 'N786', 'N789', 'N791', 'N794',
            'N796', 'N798', 'N801', 'N803', 'N805', 'N808', 'N810', 'N812',
            'N815', 'N817', 'N819', 'N822', 'N824', 'N827', 'N829', 'N831',
            'N834', 'N836', 'N838', 'N841', 'N843', 'N845', 'N848', 'N850',
            'N852', 'N855', 'N857', 'N860', 'N862', 'N864', 'N867', 'N869',
            'N871', 'N874', 'N876', 'N878', 'N881', 'N883', 'N885', 'N888',
            'N890', 'N893', 'N895', 'N897', 'N900', 'N902', 'N904', 'N907',
            'N909', 'N911', 'N914', 'N916', 'N918', 'N921', 'N923', 'N926',
            'N928', 'N930', 'N933', 'N935', 'N937', 'N940', 'N942', 'N944',
            'N947', 'N949', 'N951', 'N954', 'N956', 'N959', 'N961', 'N963',
            'N966', 'N968', 'N970', 'N973', 'N975', 'N977', 'N980', 'N982',
            'N984', 'N987', 'N989', 'N992', 'N994', 'N996', 'N999', 'N1001',
            'N1003', 'N1006', 'N1008', 'N1010', 'N1013', 'N1015', 'N1017', 'N1020',
            'N1022', 'N1025', 'N1027', 'N1029', 'N1032', 'N1034', 'N1036', 'N1039',
            'N1041', 'N1043', 'N1046',)),
    ),
)

mesh = MODI_MAILLAGE(
    reuse=mesh,
    MAILLAGE=mesh,
    ORIE_PEAU=_F(GROUP_MA_PEAU=('Boven', 'Onder', 'BRERRVRIJ',)),
)


# =====================================================
# 3. MODEL DEFINITION
# Generated by bridge_to_aster.py based on elset dimensions.
# For each elset the matching MODELISATION is chosen:
#   1D (line2)              -> POU_D_E   (Euler beam; SEG2 only)
#   2D linear (tri3/quad4)        -> DKT
#   2D quadratic (tri6/quad8)     -> COQUE_3D (after CREA_MAILLAGE MODI_MAILLE)
#   springs (1D, spring material) -> DIS_T
#   faces with pressure (on vol.) -> 3D (boundary elements)
#   loose nodes (POI1)            -> DIS_T / DIS_TR (see bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Without elsets, pressure faces and POI1 nodes TOUT='OUI',
# MODELISATION='3D' is used.
# =====================================================
model_sain = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Plaat', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Boven', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Onder', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='BRERRVRIJ', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)

# =====================================================
# XFEM CRACKS (bridge: #ASTER-XFEM, bridge_xfem.py,
# docs/Breukmechanica.md par. 7): level sets in the sound
# model, then the XFEM model 'model' for loads and solve
# =====================================================
# Crack 1: vorm=HALFVLAK, front=(0.05, 0, 0), normaal=(0, 1, 0), richting=(1, 0, 0)
fiss_1 = DEFI_FISS_XFEM(
    MAILLAGE=mesh,
    TYPE_DISCONTINUITE='FISSURE',
    DEFI_FISS=_F(FORM_FISS='DEMI_PLAN', PFON=(0.05, 0.0, 0.0), NORMALE=(0.0, 1.0, 0.0),
                     DTAN=(1.0, 0.0, 0.0)),
)
model = MODI_MODELE_XFEM(MODELE_IN=model_sain, FISSURE=(fiss_1,))


# =====================================================
# 3b. SECTION PROPERTIES (beams, shells, springs)
# Generated by bridge_to_aster.py based on Mecway <geometric> data.
#
# POUTRE: beam cross-sections (CERCLE, RECTANGLE, ...) per GROUP_MA
#   Example: _F(GROUP_MA='Beam1', SECTION='CERCLE', CARA=('R',), VALE=(0.005,))
#   Beam orientation: every beam gets Mecway's V axis as
#   ORIENTATION CARA='VECT_Y' (model_data["beam_vect_y"]): own orientation
#   (element properties or Element orientation card) or Mecway's default.
#
# COQUE: plate/shell thicknesses per GROUP_MA
#   Example: _F(GROUP_MA='Plate1', EPAIS=0.001)
#
# DISCRET: spring elements (DIS_T with K_T_D_L stiffness matrix) and
#          loose nodes (POI1, K_T_D_N / K_TR_D_N with stiffness 0),
#          each with a separate mass entry 0 (M_T_D_L / M_T_D_N / M_TR_D_N)
#   Example: _F(GROUP_MA='Spring1', CARA='K_T_D_L', VALE=(4231.0, 0.0, 0.0))
#
# Without beam, shell or spring sections and without POI1 nodes this contains:
#   #-- not used in this analysis --
# =====================================================
#-- not used in this analysis --


# =====================================================
# 4. MATERIAL DEFINITION
# Generated by bridge_to_aster.py based on Mecway materials.
# All values in SI units (Pa, kg/m3, dimensionless).
# RHO is always included (default 0.0) for compatibility with
# PESANTEUR.
# Concept names MAT_1, MAT_2, ... with the Mecway name as a comment above.
# Example: MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)
# =====================================================
# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=0.0),)


# =====================================================
# 5. MATERIAL ASSIGNMENT
# Assigns materials to element sets (GROUP_MA) or, if there are
# no elsets, the first material to all elements (TOUT='OUI').
# DISCRET elsets (springs) are skipped; their properties are
# only in AFFE_CARA_ELEM.
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Plaat', MATER=MAT_1),
    ),
)


# =====================================================
# 6. BOUNDARY CONDITIONS AND LOADS
# Generated by bridge_to_aster.py from model_data["bcs"] and
# model_data["couplings"]. Supported Code-Aster keywords:
#   DDL_IMPO       - fixed support, prescribed displacement/rotation
#   FORCE_NODALE   - point forces
#   PRES_REP       - surface pressure
#   PESANTEUR      - gravity (requires RHO in the material)
#   LIAISON_SOLIDE - rigid body coupling (RBE2)
#   LIAISON_RBE3   - distributing coupling (RBE3)
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO='BRSY1', DZ=0.0),
        _F(GROUP_NO='BRSY2', DZ=0.0),
        _F(GROUP_NO='BRSY3', DX=0.0),
        _F(GROUP_NO='Anker', DY=0.0),
    ),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_FACE=_F(GROUP_MA='Boven', FY=100000000.0),
)

load_3 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_FACE=_F(GROUP_MA='Onder', FY=-100000000.0),
)


# =====================================================
# 7. SOLVER: LINEAR STATIC
# MECA_STATIQUE solves Ku=F for linear elastic behaviour.
# CARA_ELEM=cara is included as soon as step 3b contains an AFFE_CARA_ELEM
# (beam, shell, spring sections or POI1 nodes); otherwise omitted.
# SOLVEUR (setting "lin_solver"): MUMPS (direct) with NPREC from
# "solver_nprec" (Code-Aster default 8) and RESI_RELA ("lin_solver_resi",
# default 1e-6) as the limit for the estimated error of the solution; or GCPC
# (iterative, PRE_COND='LDLT_INC') with RESI_RELA as residual criterion.
# INFO=2: solver statistics in the .mess (convergence monitor).
# =====================================================
res = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    EXCIT=(
        _F(CHARGE=load_1),
        _F(CHARGE=load_2),
        _F(CHARGE=load_3),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8, RESI_RELA=1e-06),
    INFO=2,
)

# =====================================================
# 8. COMPUTE POST-PROCESSING FIELDS  (CALC_CHAMP)
# Generated by bridge_to_aster.py based on element types.
#
# REAC_NODA:
#   Separate call without GROUP_MA (all nodes); with elastic support
#   without the springs (BRES*), so that the spring force is the reaction.
#
# SIGM_NOEU / SIEQ_NOEU:
#   Only on the 3D elsets (GROUP_MA). Shell stresses have
#   sub-points (layers) and do not fit in a NOEU field. Without
#   3D elsets (also with AFFE_MODELE TOUT='OUI') this call is dropped.
#
# Shells (DKT / COQUE_3D):
#   SIGM_ELNO -> POST_CHAMP EXTR_COQUE ('SUP', 'MOY' and 'INF')
#   -> SIEQ_ELNO -> SIEQ_NOEU in res_sup / res_moy / res_inf.
#
# Beams (POU_D_E, cross-section RECTANGLE or CERCLE):
#   SIPM_ELNO = SIXXMIN / SIXXMAX in the cross-section.
#
# Error estimator (setting error_estimator, volume elements only):
#   separate model, load and result res_err, then CALC_ERREUR ERME_ELEM /
#   ERME_ELNO / ERME_NOEU; see _error_estimator_block() and
#   docs/Foutschatter.md.
#
# See _build_calc_champ_block() in bridge_to_aster.py.
# =====================================================

# =====================================================
# XFEM: results on the original mesh (bridge_xfem.result_block)
# The displacement of the XFEM model has extra degrees of freedom (H1X..,
# K1..) and at a node of a cut element it is not the physical
# displacement. POST_MAIL_XFEM makes a mesh that follows the crack,
# POST_CHAM_XFEM puts DEPL and SIEF_ELGA on it; every node of the
# original mesh is a node of that mesh, so PROJ_CHAMP
# COLLOCATION gives the value on its own side of the crack. The
# auxiliary model only gets the solid elsets (the mesh of POST_MAIL_XFEM
# keeps the groups; its front cells and edges without volume raised the
# alarm MODELE1_63). REAC_NODA comes from the XFEM result (DX, DY, DZ).
# =====================================================
res_xfem = res
res_xfem = CALC_CHAMP(reuse=res_xfem, RESULTAT=res_xfem, FORCE=('REAC_NODA',))
mesh_xvisu = POST_MAIL_XFEM(MODELE=model)
model_xvisu = AFFE_MODELE(
    MAILLAGE=mesh_xvisu,
    AFFE=_F(GROUP_MA=('Plaat',), PHENOMENE='MECANIQUE', MODELISATION='3D'),
)
res_xvisu = POST_CHAM_XFEM(MODELE_VISU=model_xvisu, RESULTAT=res_xfem)
res_xvisu = CALC_CHAMP(reuse=res_xvisu, RESULTAT=res_xvisu,
                       CONTRAINTE=('SIGM_NOEU',), CRITERES=('SIEQ_NOEU',))
res = PROJ_CHAMP(RESULTAT=res_xvisu, MODELE_1=model_xvisu,
                 MODELE_2=model_sain, METHODE='COLLOCATION',
                 NOM_CHAM=('DEPL', 'SIGM_NOEU', 'SIEQ_NOEU'))
reac_xfem = CREA_CHAMP(TYPE_CHAM='NOEU_DEPL_R', OPERATION='EXTR',
                       RESULTAT=res_xfem, NOM_CHAM='REAC_NODA', NUME_ORDRE=1)
reac_sain = CREA_CHAMP(TYPE_CHAM='NOEU_DEPL_R', OPERATION='ASSE',
                       MODELE=model_sain,
                       ASSE=_F(TOUT='OUI', CHAM_GD=reac_xfem,
                               NOM_CMP=('DX', 'DY', 'DZ')))
res = CREA_RESU(reuse=res, RESULTAT=res, OPERATION='AFFE',
                TYPE_RESU='EVOL_ELAS',
                AFFE=_F(NOM_CHAM='REAC_NODA', CHAM_GD=reac_sain, INST=0.0,
                        MODELE=model_sain))
model = model_sain


# =====================================================
# 9. RESULT EXTRACTION TO TABLES  (POST_RELEVE_T)
# Generated by bridge_to_aster.py based on element types.
# Displacements and reaction forces are always extracted.
# tab_sigm / tab_vmis : 3D elsets
# tab_vmss / tab_vmsm / tab_vmsi : shells, von Mises top/middle/bottom
# tab_sipm            : beams (RECTANGLE / CERCLE), SIXXMIN / SIXXMAX
# INTITULE is at most 16 characters (Code-Aster truncates longer ones).
#
# Separate tables per field so that INTITULE (parts[0] in the parser)
# uniquely identifies the field in AsterToMecway_results()
# in bridge_from_aster.py.
# =====================================================
#-- tables not needed (result_route='liml') --


# =====================================================
# 10. WRITE TABLES TO .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# Only the tables created in step 9 are written.
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\BR-08\\BR-08_verif_results.xml', '<WORKDIR>\\BR-08\\BR-08.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    failures=globals().get('_bz_events'),
    precision='double')


# =====================================================
# 11. EXPORT TO MED FORMAT (ParaView / Salome), only with the
# setting "med_export" (bridge_to_aster._build_impr_resu_block;
# UNITE=80 -> 'F rmed ... R 80' in study.export). Mecway receives the
# results via the .liml or the tables, not via an export file.
# =====================================================
#-- no MED export (setting med_export off) --

# =====================================================
# FRACTURE MECHANICS XFEM (bridge_xfem.k_block): K and G
# along the front of every #ASTER-XFEM crack, per front (NUME_FOND)
# =====================================================

def _bridge_xfem_fronts(fiss):
    return max(1, len(fiss.getCrackTipMultiplicity()) // 2)


def _bridge_xfem_csv(path, tables, columns):
    import io
    lines = [",".join(c[0] for c in columns)]
    for key, front, t_g, t_pk in tables:
        vg = t_g.EXTR_TABLE().values()
        vpk = {}
        if t_pk is not None:
            vp = t_pk.EXTR_TABLE().values()
            for i, num in enumerate(vp.get("NUM_PT", [])):
                vpk[int(num)] = dict((k, vp[k][i]) for k in vp
                                     if i < len(vp[k]))
        size = max([abs(v) for c in ("COOR_X", "COOR_Y", "COOR_Z")
                    for v in vg.get(c, []) if v is not None] + [1.0e-30])
        for i, num in enumerate(vg.get("NUM_PT", [])):
            pk = vpk.get(int(num), {})
            if pk and any(abs((pk.get(c) or 0.0) - (vg[c][i] or 0.0)) >
                          1.0e-6 * size for c in ("COOR_X", "COOR_Y",
                                                  "COOR_Z")):
                pk = {}
            row = []
            for n, (head, para) in enumerate(columns):
                if head == "crack":
                    v = key
                elif head == "front":
                    v = front
                elif head.endswith("_POST_K"):
                    v = pk.get(para)
                else:
                    v = vg.get(para, [None] * (i + 1))[i]
                if v is None:
                    row.append("")
                elif isinstance(v, float):
                    row.append("%.10g" % v)
                else:
                    row.append(str(v).strip())
            lines.append(",".join(row))
    with io.open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    print("BRIDGE_XFEM_CSV " + path)

_bridge_xfem_tabs = []
# Crack 1 (DEMI_PLAN)
for _k in range(1, _bridge_xfem_fronts(fiss_1) + 1):
    _tg = CALC_G_XFEM(RESULTAT=res_xfem, OPTION='CALC_K_G',
                      THETA=_F(FISSURE=fiss_1, NUME_FOND=_k),
                      LISSAGE=_F(LISSAGE_G='LAGRANGE', LISSAGE_THETA='LAGRANGE'))
    IMPR_TABLE(TABLE=_tg, UNITE=6)
    # POST_K1_K2_K3 (extrapolation of the jump in the
    # displacement across the lips) as a check; an error here
    # does not stop the table of CALC_G_XFEM
    try:
        _tp = POST_K1_K2_K3(RESULTAT=res_xfem, FISSURE=fiss_1, NUME_FOND=_k)
        IMPR_TABLE(TABLE=_tp, UNITE=6)
    except Exception as _e:
        _tp = None
        print('BRIDGE_XFEM_POSTK_FOUT 1/' + str(_k) + ' ' + str(_e).replace(chr(10), ' ')[:300])
    _bridge_xfem_tabs.append(('1', _k, _tg, _tp))
_bridge_xfem_csv('<WORKDIR>\\BR-08\\BR-08_verif_xfem.csv', _bridge_xfem_tabs, [['crack', None], ['front', None], ['point', 'NUM_PT'], ['x', 'COOR_X'], ['y', 'COOR_Y'], ['z', 'COOR_Z'], ['s', 'ABSC_CURV'], ['G', 'G'], ['K1', 'K1'], ['K2', 'K2'], ['K3', 'K3'], ['G_IRWIN', 'G_IRWIN'], ['K1_POST_K', 'K1'], ['K2_POST_K', 'K2'], ['K3_POST_K', 'K3'], ['G_POST_K', 'G']])


FIN()
