    extra_results=dict((k, globals()[k]) for k in
                       ('res_ther', 'res_flux') if k in globals()),
    precision='single', static=False, fields=['temperature', 'heat_flux', 'displacements', 'stresses', 'vonmises', 'reactions', 'plastic_strain', 'plastic_strain_eq'])


