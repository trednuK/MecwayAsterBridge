        _F(JUSQU_A=0.00039, NOMBRE=6),
        _F(JUSQU_A=0.000395, NOMBRE=6),
        _F(JUSQU_A=0.0004, NOMBRE=6),
        _F(JUSQU_A=0.000405, NOMBRE=6),
