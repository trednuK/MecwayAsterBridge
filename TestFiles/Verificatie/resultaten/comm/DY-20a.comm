# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for DYNA_NON_LINE (nonlinear dynamics, implicit HHT/NEWMARK
# or explicit DIFF_CENT/TCHAMWA; choice "schema" in CONFIG_BRIDGE).
# Filled in via Python str.format() from bridge_to_aster.py
# (_build_nonlin_static; same builder and placeholders as STAT_NON_LINE).
#
# Placeholders (see AsterTemplate_StatNonLine.comm for the shared ones):
#   listinst_block    -> outlist (output times from Mecway <timesteps>),
#                        listinst (implicit: DEFI_LIST_INST with automatic
#                        step cutting; explicit: per output interval equal
#                        steps below the estimated CFL limit, so that every
#                        output time is a computation step)
#                        and vite0 (initial velocity, CREA_CHAMP) if present
#   statnonline_block -> DEFI_CONTACT (if there is contact2) and the
#                        DYNA_NON_LINE call with SCHEMA_TEMPS, ETAT_INIT
#                        and ARCHIVAGE at the output times, or the failure loop
#                        (bridge_failure.build_solve_block)
#   postreleve_block  -> route 'tabel': POST_RELEVE_T over all
#                        archived time steps (TOUT_ORDRE), including
#                        velocity (VITE); route 'liml': aster_results_export
#
# NOTE braces: write a literal brace as { or }.

# Language of the messages of the job scripts (aster_*.py)
# and the setting vtu_export (aster_vtu)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
_bridge_os.environ['BRIDGE_VTU'] = '0'
DEBUT(LANG='EN')

# =====================================================
# 1. READ MESH
# FORMAT='ASTER': mesh directly from the .liml (bridge_mesh.py)
# UNITE=20 corresponds to 'F mail ... D 20' in study.export
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. CREATE STANDARD GROUPS (all elements / nodes)
# =====================================================
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

# =====================================================
# 2b. NODE GROUPS FOR BOUNDARY CONDITIONS (and mesh modifications)
# Generated by _build_defigroup_block(), same as MECA_STATIQUE.
# =====================================================
#-- not used in this analysis --

mesh = MODI_MAILLAGE(
    reuse=mesh,
    MAILLAGE=mesh,
    ORIE_PEAU=_F(GROUP_MA_PEAU=('Eindvlak',)),
)


# =====================================================
# 3. MODEL DEFINITION
# For each elset the matching MODELISATION is chosen:
#   1D (line2)              -> POU_D_E   (Euler beam; SEG2 only)
#   2D linear (tri3/quad4)        -> DKT
#   2D quadratic (tri6/quad8)     -> COQUE_3D (after CREA_MAILLAGE MODI_MAILLE)
#   springs (1D, spring material) -> DIS_T
#   faces with pressure (on vol.) -> 3D (boundary elements)
#   loose nodes (POI1)            -> DIS_T / DIS_TR (see bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Without elsets, pressure faces and POI1 nodes TOUT='OUI',
# MODELISATION='3D' is used.
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Staaf', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Eindvlak', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


# =====================================================
# 3b. SECTION PROPERTIES (beams, shells, springs)
# =====================================================
#-- not used in this analysis --


# =====================================================
# 3c. PLASTIC HARDENING CURVES  (DEFI_FONCTION)
# For each material with a <plastic> block in Mecway a traction function
# is defined. Code-Aster TRACTION / VMIS_ISOT_TRAC (U4.43.01 par. 5.1.1):
#   - NOM_PARA='EPSI' : TOTAL strain
#   - NOM_RESU='SIGM' : stress
#   - The ordinate of the first point is the elastic limit; a point
#     with abscissa zero is NOT allowed. The first point is therefore
#     (sigma_y / E, sigma_y).
#
# The conversion from Mecway is done in bridge_to_aster.py
# (_to_aster_traction_curve), controlled by 'plastic_strain_definition'
# in CONFIG_BRIDGE: 'plastic' -> EPSI = eps_p + sigma/E,
# 'total' -> start point (0, 0) is dropped, 'auto' -> derived from the
# first point. Invalid curves stop the generation with an ERROR in
# bridge_log.txt.
# =====================================================
#-- no plastic curves in this model --


# =====================================================
# 4. MATERIAL DEFINITION
# DEFI_MATERIAU with ELAS (always) and TRACTION (only for plastic
# materials). RHO is always included for PESANTEUR compatibility.
# =====================================================
# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.0, RHO=7850.0),)


# =====================================================
# 5. MATERIAL ASSIGNMENT
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Staaf', MATER=MAT_1),
    ),
)


# =====================================================
# 6a. TIME-DEPENDENT LOAD FUNCTIONS  (DEFI_FONCTION)
# For each <force> component with a time attribute a function of INST
# is defined. Extrapolation outside the defined time domain is
# constant on both sides.
# =====================================================
FN_Eindvlak_DNOR = DEFI_FONCTION(
    NOM_PARA='INST',
    VALE=(0.0, 599999.9999999999,
          8.33333333333e-07, 0.0),
    PROL_DROITE='CONSTANT',
    PROL_GAUCHE='CONSTANT',
)


# =====================================================
# 6b. TIME DISCRETISATION AND INITIAL VELOCITY
# outlist: output times (Mecway <timesteps>); listinst: computation steps
# (see the header of this file); vite0: initial velocity.
# =====================================================
outlist = DEFI_LIST_REEL(
    VALE=(5e-06, 1e-05, 1.5e-05, 2e-05, 2.5e-05, 3e-05, 3.5e-05, 4e-05, 4.5e-05, 5e-05, 5.5e-05, 6e-05, 6.5e-05, 7e-05, 7.5e-05, 8e-05, 8.5e-05, 9e-05, 9.5e-05, 0.0001, 0.000105, 0.00011, 0.000115, 0.00012, 0.000125, 0.00013, 0.000135, 0.00014, 0.000145, 0.00015, 0.000155, 0.00016, 0.000165, 0.00017, 0.000175, 0.00018, 0.000185, 0.00019, 0.000195, 0.0002, 0.000205, 0.00021, 0.000215, 0.00022, 0.000225, 0.00023, 0.000235, 0.00024, 0.000245, 0.00025, 0.000255, 0.00026, 0.000265, 0.00027, 0.000275, 0.00028, 0.000285, 0.00029, 0.000295, 0.0003, 0.000305, 0.00031, 0.000315, 0.00032, 0.000325, 0.00033, 0.000335, 0.00034, 0.000345, 0.00035, 0.000355, 0.00036, 0.000365, 0.00037, 0.000375, 0.00038, 0.000385, 0.00039, 0.000395, 0.0004, 0.000405, 0.00041, 0.000415, 0.00042, 0.000425, 0.00043, 0.000435, 0.00044, 0.000445, 0.00045, 0.000455, 0.00046, 0.000465, 0.00047, 0.000475, 0.00048, 0.000485, 0.00049, 0.000495, 0.0005, 0.000505, 0.00051, 0.000515, 0.00052, 0.000525, 0.00053, 0.000535, 0.00054, 0.000545, 0.00055, 0.000555, 0.00056, 0.000565, 0.00057, 0.000575, 0.00058, 0.000585, 0.00059, 0.000595, 0.0006),
)

listinst = DEFI_LIST_REEL(
    DEBUT=0.0,
    INTERVALLE=(
        _F(JUSQU_A=5e-06, NOMBRE=6),
        _F(JUSQU_A=1e-05, NOMBRE=6),
        _F(JUSQU_A=1.5e-05, NOMBRE=6),
        _F(JUSQU_A=2e-05, NOMBRE=6),
        _F(JUSQU_A=2.5e-05, NOMBRE=6),
        _F(JUSQU_A=3e-05, NOMBRE=6),
        _F(JUSQU_A=3.5e-05, NOMBRE=6),
        _F(JUSQU_A=4e-05, NOMBRE=6),
        _F(JUSQU_A=4.5e-05, NOMBRE=6),
        _F(JUSQU_A=5e-05, NOMBRE=6),
        _F(JUSQU_A=5.5e-05, NOMBRE=6),
        _F(JUSQU_A=6e-05, NOMBRE=6),
        _F(JUSQU_A=6.5e-05, NOMBRE=6),
        _F(JUSQU_A=7e-05, NOMBRE=6),
        _F(JUSQU_A=7.5e-05, NOMBRE=6),
        _F(JUSQU_A=8e-05, NOMBRE=6),
        _F(JUSQU_A=8.5e-05, NOMBRE=6),
        _F(JUSQU_A=9e-05, NOMBRE=6),
        _F(JUSQU_A=9.5e-05, NOMBRE=6),
        _F(JUSQU_A=0.0001, NOMBRE=6),
        _F(JUSQU_A=0.000105, NOMBRE=6),
        _F(JUSQU_A=0.00011, NOMBRE=6),
        _F(JUSQU_A=0.000115, NOMBRE=6),
        _F(JUSQU_A=0.00012, NOMBRE=6),
        _F(JUSQU_A=0.000125, NOMBRE=6),
        _F(JUSQU_A=0.00013, NOMBRE=6),
        _F(JUSQU_A=0.000135, NOMBRE=6),
        _F(JUSQU_A=0.00014, NOMBRE=6),
        _F(JUSQU_A=0.000145, NOMBRE=6),
        _F(JUSQU_A=0.00015, NOMBRE=6),
        _F(JUSQU_A=0.000155, NOMBRE=6),
        _F(JUSQU_A=0.00016, NOMBRE=6),
        _F(JUSQU_A=0.000165, NOMBRE=6),
        _F(JUSQU_A=0.00017, NOMBRE=6),
        _F(JUSQU_A=0.000175, NOMBRE=6),
        _F(JUSQU_A=0.00018, NOMBRE=6),
        _F(JUSQU_A=0.000185, NOMBRE=6),
        _F(JUSQU_A=0.00019, NOMBRE=6),
        _F(JUSQU_A=0.000195, NOMBRE=6),
        _F(JUSQU_A=0.0002, NOMBRE=6),
        _F(JUSQU_A=0.000205, NOMBRE=6),
        _F(JUSQU_A=0.00021, NOMBRE=6),
        _F(JUSQU_A=0.000215, NOMBRE=6),
        _F(JUSQU_A=0.00022, NOMBRE=6),
        _F(JUSQU_A=0.000225, NOMBRE=6),
        _F(JUSQU_A=0.00023, NOMBRE=6),
        _F(JUSQU_A=0.000235, NOMBRE=6),
        _F(JUSQU_A=0.00024, NOMBRE=6),
        _F(JUSQU_A=0.000245, NOMBRE=6),
        _F(JUSQU_A=0.00025, NOMBRE=6),
        _F(JUSQU_A=0.000255, NOMBRE=6),
        _F(JUSQU_A=0.00026, NOMBRE=6),
        _F(JUSQU_A=0.000265, NOMBRE=6),
        _F(JUSQU_A=0.00027, NOMBRE=6),
        _F(JUSQU_A=0.000275, NOMBRE=6),
        _F(JUSQU_A=0.00028, NOMBRE=6),
        _F(JUSQU_A=0.000285, NOMBRE=6),
        _F(JUSQU_A=0.00029, NOMBRE=6),
        _F(JUSQU_A=0.000295, NOMBRE=6),
        _F(JUSQU_A=0.0003, NOMBRE=6),
        _F(JUSQU_A=0.000305, NOMBRE=6),
        _F(JUSQU_A=0.00031, NOMBRE=6),
        _F(JUSQU_A=0.000315, NOMBRE=6),
        _F(JUSQU_A=0.00032, NOMBRE=6),
        _F(JUSQU_A=0.000325, NOMBRE=6),
