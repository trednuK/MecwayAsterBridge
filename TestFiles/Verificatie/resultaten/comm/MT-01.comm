    720.0, 2127130000.0,
    740.0, 2029200000.0,
    760.0, 1931170000.0,
    780.0, 1833040000.0,
    800.0, 1734820000.0,
    820.0, 1636500000.0,
    840.0, 1538080000.0,
    860.0, 1439560000.0,
    880.0, 1340950000.0,
    900.0, 1242240000.0,
), PROL_GAUCHE='CONSTANT', PROL_DROITE='CONSTANT')
# Metallurgical law (#ASTER-METALLURGIE mechanica=ja; ELAS_META_FO + META_ECRO_LINE,
# hsnv101a): per phase yield strength and slope, linear mixing rule (SY_MELANGE)
MAT_1 = DEFI_MATERIAU(
    ELAS_META_FO=_F(
        E=MAT_1_E,
        NU=MAT_1_NU,
        F_ALPHA=MAT_1_AF,
        C_ALPHA=MAT_1_AC,
        PHASE_REFE='CHAUD',
        EPSF_EPSC_TREF=0.00252,
        TEMP_DEF_ALPHA=900.0,
        F1_SY=MAT_1_SYF,
        F2_SY=MAT_1_SYP,
        F3_SY=MAT_1_SYB,
        F4_SY=MAT_1_SYM,
        C_SY=MAT_1_SYA,
        SY_MELANGE=MAT_1_MEL,
    ),
    META_ECRO_LINE=_F(
        F1_D_SIGM_EPSI=MAT_1_ETF,
        F2_D_SIGM_EPSI=MAT_1_ETP,
        F3_D_SIGM_EPSI=MAT_1_ETB,
        F4_D_SIGM_EPSI=MAT_1_ETM,
        C_D_SIGM_EPSI=MAT_1_ETA,
    ),
)

fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Staaf', MATER=MAT_1),
    ),
    AFFE_VARC=(
        _F(TOUT='OUI', NOM_VARC='TEMP', EVOL=res_ther, NOM_CHAM='TEMP', VALE_REF=900.0),
        _F(GROUP_MA=('Staaf',), NOM_VARC='M_ACIER', EVOL=res_ther, NOM_CHAM='META_ELNO'),
    ),
)


# =====================================================
# 11. MECHANICAL BOUNDARY CONDITIONS, LOADS AND TIME STEPS
# =====================================================
FN_XL_FX = DEFI_FONCTION(
    NOM_PARA='INST',
    VALE=(0.0, 0.0,
          60.0, 360000000.0),
    PROL_DROITE='CONSTANT',
    PROL_GAUCHE='CONSTANT',
)
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_MA='X0', DX=0.0),
        _F(GROUP_MA='Y0', DY=0.0),
        _F(GROUP_MA='Z0', DZ=0.0),
    ),
)

load_2 = AFFE_CHAR_MECA_F(
    MODELE=model,
    FORCE_FACE=_F(GROUP_MA='XL', FX=FN_XL_FX),
)

# Mechanical steps = the thermal times; on divergence cut the step (ECHEC DECOUPE)
listinst = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=times),
    ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE',
             SUBD_METHODE='MANUEL', SUBD_PAS=4, SUBD_NIVEAU=6),
)


# =====================================================
# 12. MECHANICAL SOLVE (STAT_NON_LINE at the thermal times)
# =====================================================
try:
    res = STAT_NON_LINE(
        MODELE=model,
        CHAM_MATER=fieldmat,
        EXCIT=(
            _F(CHARGE=load_1),
            _F(CHARGE=load_2),
        ),
        COMPORTEMENT=_F(GROUP_MA='Staaf', RELATION='META_P_IL', RELATION_KIT=('ACIER',), DEFORMATION='PETIT'),
        INCREMENT=_F(LIST_INST=listinst),
        ARCHIVAGE=_F(LIST_INST=times),
        SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
        NEWTON=_F(REAC_ITER=1),
        RECH_LINEAIRE=_F(ITER_LINE_MAXI=5),
        CONVERGENCE=_F(RESI_GLOB_RELA=1e-06, ITER_GLOB_MAXI=20),
    )
except Exception as err:
    _pe_id = str(getattr(err, 'id_message', '') or '')
    try:
        _pe_inst = list(res.getAccessParameters()['INST'])
    except Exception:
        _pe_inst = []
    if not _pe_id or not _pe_inst or not (
            _pe_id.startswith('MECANONLINE') or len(_pe_inst) > 1):
        raise
    print('BRIDGE_FOUT_ID', _pe_id)
    print('BRIDGE_ONVOLLEDIG', _pe_inst[-1])
t_res = res.getAccessParameters()['INST'][-1]


# =====================================================
# 13. STRESSES, PLASTIC STRAIN AND SUMMARY
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Stresses per element node for Mecway (result_route 'liml').
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CONTRAINTE=('SIGM_ELNO', ),
)
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CRITERES=('SIEQ_ELNO', ),
)

res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CONTRAINTE=('SIGM_NOEU', ),
    CRITERES=('SIEQ_NOEU', ),
    DEFORMATION=('EPSP_NOEU', ),
    VARI_INTERNE=('VARI_NOEU', ),
)

# Thermomechanical summary (bridge_thermomech): residual stress and
# deformation at the last time, lines BRIDGE_THERMOMECA in the .mess.
def _bridge_tm_report(res, res_ther, n_nodes):
    import numpy as np
    out = []
    try:
        acc = res.getAccessParameters()
        idx, t = acc['NUME_ORDRE'][-1], acc['INST'][-1]
        out.append(('t', t))
        acc_t = res_ther.getAccessParameters()
        ok = list(acc_t['INST'][:len(acc['INST'])]) == list(acc['INST'])
        if not ok:
            print('BRIDGE_THERMOMECA_TIJDEN', len(acc['INST']),
                  len(acc_t['INST']))
        idx_t = acc_t['NUME_ORDRE'][acc_t['INST'].index(t)] \
            if t in acc_t['INST'] else acc_t['NUME_ORDRE'][-1]

        def vals(r, name, i):
            sf = r.getField(name, i).toSimpleFieldOnNodes()
            v, m = sf.getValues()
            return list(sf.getComponents()), v[:n_nodes], m[:n_nodes]
        c, v, m = vals(res_ther, 'TEMP', idx_t)
        k = c.index('TEMP')
        out += [('T_min', float(v[m[:, k], k].min()) + 273.15),
                ('T_max', float(v[m[:, k], k].max()) + 273.15)]
        c, v, m = vals(res, 'DEPL', idx)
        uu = np.zeros(v.shape[0])
        for name in ('DX', 'DY', 'DZ'):
            k = c.index(name)
            out += [(name + '_min', float(v[m[:, k], k].min())),
                    (name + '_max', float(v[m[:, k], k].max()))]
            uu += np.where(m[:, k], v[:, k], 0.0) ** 2
        out.append(('U_max', float(np.sqrt(uu.max()))))
        c, v, m = vals(res, 'SIGM_NOEU', idx)
        for name in ('SIXX', 'SIYY', 'SIZZ'):
            k = c.index(name)
            out += [(name + '_min', float(v[m[:, k], k].min())),
                    (name + '_max', float(v[m[:, k], k].max()))]
        c, v, m = vals(res, 'SIEQ_NOEU', idx)
        k = c.index('VMIS')
        out.append(('VMIS_max', float(v[m[:, k], k].max())))
        if '' and 'VARI_NOEU' in res.getFieldsNames():
            c, v, m = vals(res, 'VARI_NOEU', idx)
            k = c.index('')
            out.append(('P_max', float(v[m[:, k], k].max())))
            vmax = 0.0
            for i in acc['NUME_ORDRE']:
                c, v, m = vals(res, 'VARI_NOEU', i)
                vmax = max(vmax, float(v[m[:, k], k].max()))
            out.append(('P_max_all', vmax))
    except Exception as exc:
        print('BRIDGE_THERMOMECA_FOUT', repr(exc))
    for key, value in out:
        print('BRIDGE_THERMOMECA %s %r' % (key, value))
_bridge_tm_report(res, res_ther, 20)


# =====================================================
# 14. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (mechanical + thermal)
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\MT-01\\MT-01_verif_results.xml', '<WORKDIR>\\MT-01\\MT-01.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_ther', 'res_flux') if k in globals()),
    precision='single', static=False, fields=['temperature', 'heat_flux', 'metallurgy', 'displacements', 'stresses', 'vonmises', 'reactions', 'plastic_strain'])


