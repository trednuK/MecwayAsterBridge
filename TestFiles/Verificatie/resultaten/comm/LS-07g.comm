        _F(NOEUD=('N182', 'N162', 'N163',), DDL=('DZ', 'DZ', 'DZ',), COEF_MULT=(1, -0.667622690236214, -0.332377309763786,), COEF_IMPO=0.0),
        _F(NOEUD=('N182', 'N162', 'N163',), DDL=('DRX', 'DRX', 'DRX',), COEF_MULT=(1, -0.667622690236214, -0.332377309763786,), COEF_IMPO=0.0),
        _F(NOEUD=('N182', 'N182', 'N162', 'N162', 'N163', 'N163',), DDL=('DRY', 'DRZ', 'DRY', 'DRZ', 'DRY', 'DRZ',), COEF_MULT=(-0.555570233021558, 0.831469612301238, 0.370911293585013, -0.555107979414214, 0.184658939436545, -0.276361632887024,), COEF_IMPO=0.0),
        _F(NOEUD=('N184', 'N163',), DDL=('DX', 'DX',), COEF_MULT=(1, -1,), COEF_IMPO=0.0),
        _F(NOEUD=('N184', 'N163',), DDL=('DY', 'DY',), COEF_MULT=(1, -1,), COEF_IMPO=0.0),
        _F(NOEUD=('N184', 'N163',), DDL=('DZ', 'DZ',), COEF_MULT=(1, -1,), COEF_IMPO=0.0),
        _F(NOEUD=('N184', 'N163',), DDL=('DRX', 'DRX',), COEF_MULT=(1, -1,), COEF_IMPO=0.0),
