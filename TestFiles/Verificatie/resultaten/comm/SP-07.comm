# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for the response spectrum analysis (earthquake, shock): eigenmodes
# (CALC_MODES), the spectral response per mode and the combination over the
# modes and the directions (COMB_SISM_MODAL), back to Mecway as one step
# with the maxima. Filled in via str.format() from bridge_spectrum.py.
#
# Placeholders (name between single braces):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (beams, shells, springs, point masses)
#   materials_block   -> DEFI_MATERIAU per material (with RHO)
#   fieldmat_block    -> AFFE_MATERIAU assignment
#   loads_block       -> AFFE_CHAR_MECA: the supports (and #ASTER code)
#   assemblage_block  -> ASSEMBLAGE: RIGI_MECA and MASS_MECA with the
#                        supports
#   calc_modes_block  -> modes = CALC_MODES(...), the mode overview and the
#                        modal fields (CALC_CHAMP)
#   spectrum_block    -> spectra per direction, damping per mode,
#                        pseudo-modes (missing mass) and COMB_SISM_MODAL
#   result_block      -> the maxima as one result (aster_spectrum) and
#                        CALC_CHAMP (stresses)
#   export_block      -> aster_results_export (Mecway result, one step)
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# =====================================================
# 2. MODEL, SECTIONS, MATERIALS (as in MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Balk', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


#-- not used in this analysis --


# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Balk', MATER=MAT_1),
    ),
)


# =====================================================
# 3. SUPPORTS
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_MA='Inklemming', DX=0.0, DY=0.0, DZ=0.0),
)


# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21) AND EIGENMODES (CALC_MODES, U4.52.02)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CHARGE=(load_1,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=1),
    CHAM_MATER=fieldmat,
    NORM_MODE=_F(NORME='MASS_GENE'),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
# Mode overview (frequency, effective mass) in the .mess
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
import aster_spectrum
aster_results_export.print_modes(modes, mass=masse)
# Modal fields for COMB_SISM_MODAL
modes = CALC_CHAMP(reuse=modes, RESULTAT=modes, FORCE=('REAC_NODA',))
modes = CALC_CHAMP(reuse=modes, RESULTAT=modes, GROUP_MA=('Balk',), CONTRAINTE=('SIGM_ELNO', 'SIGM_NOEU'))


# =====================================================
# 5. SPECTRA AND COMBINATION (COMB_SISM_MODAL, comb_sism_modal_ops.py)
# =====================================================
# Spectrum Y: Mecway gravity, period [s] -> acceleration [m/s2],
# linear between the points, constant outside the table.
bridge_xs_Y = [0.0]
bridge_ys_Y = [1.0]
bridge_spec_Y = FORMULE(
    VALE='bridge_table(1.0 / FREQ, bridge_xs_Y, bridge_ys_Y)',
    bridge_table=aster_spectrum.table, bridge_xs_Y=bridge_xs_Y,
    bridge_ys_Y=bridge_ys_Y, NOM_PARA=('AMOR', 'FREQ'))

# Modal damping: Mecway's Rayleigh damping C = alpha M + beta K is
# per mode xi_i = (alpha / w_i + beta w_i) / 2 (Mecway manual par.
# 9.26), plus the setting spectrum_damping.
import math as _math
bridge_freqs = [float(_f) for _f in modes.getAccessParameters()['FREQ']]
bridge_alpha, bridge_beta, bridge_zeta = 0.0, 0.0, 0.05
bridge_xi = []
for _f in bridge_freqs:
    _w = 2.0 * _math.pi * _f
    if _w <= 0.0:
        print('BRIDGE_SPECTRUM_FOUT FREQ mode=%d f=%g' % (len(bridge_xi) + 1, _f))
        raise ValueError('spectrum: mode met f <= 0')
    bridge_xi.append(0.5 * (bridge_alpha / _w + bridge_beta * _w) + bridge_zeta)
if max(bridge_xi) >= 1.0:
    print('BRIDGE_SPECTRUM_FOUT DEMPING mode=%d xi=%g' % (bridge_xi.index(max(bridge_xi)) + 1, max(bridge_xi)))
    raise ValueError('spectrum: dempingsverhouding >= 1')
bridge_specs = [
    dict(dir='Y', spec=bridge_spec_Y, scale=1.0, nature='ACCE', corr_freq='NON'),
]

sism = COMB_SISM_MODAL(
    MODE_MECA=modes,
    AMOR_REDUIT=bridge_xi,
    TYPE_ANALYSE='MONO_APPUI',
    SPECTRE=(
        _F(LIST_AXE=('Y',), SPEC_OSCI=bridge_spec_Y),
    ),
    COMB_MODE=_F(TYPE='CQC'),
    COMB_DIRECTION='QUAD',
    OPTION=('DEPL', 'ACCE_ABSOLU', 'REAC_NODA', 'SIGM_ELNO',),
    TYPE_RESU=(_F(TYPE='VALE_TOTA'),),
    INFO=2,
)
aster_spectrum.report(modes, bridge_specs, bridge_xi, 'CQC', 'QUAD')


# =====================================================
# 6. MAXIMA AS RESULT AND STRESSES
# =====================================================
# The maxima as one result (one index; ACCE_ABSOLU -> ACCE)
res = aster_spectrum.maxima(sism, ['DEPL', 'ACCE_ABSOLU', 'REAC_NODA', 'SIGM_ELNO'], 'SRSS', ['Y'], MODELE=model, CHAM_MATER=fieldmat)
res = CALC_CHAMP(reuse=res, RESULTAT=res, MODELE=model, CHAM_MATER=fieldmat, GROUP_MA=('Balk',), CONTRAINTE=('SIGM_NOEU',))
# von Mises computed per mode and combined (aster_spectrum)
bridge_vm = aster_spectrum.von_mises(modes, bridge_specs, bridge_xi, 'CQC', 'QUAD')
res_mecway = aster_spectrum.Result(res, dict([('SIEQ_NOEU', bridge_vm)] if bridge_vm is not None else []))


# =====================================================
# 7. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml'), one step with the maxima
aster_results_export.export_results(
    res_mecway, '<WORKDIR>\\SP-07\\SP-07_verif_results.xml', '<WORKDIR>\\SP-07\\SP-07.liml',
    precision='single', static=True, fields=['displacements', 'accelerations', 'stresses', 'vonmises', 'reactions'])


#-- no MED export (setting med_export off) --


FIN()
