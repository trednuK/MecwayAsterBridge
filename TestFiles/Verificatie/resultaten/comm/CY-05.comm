        _F(NOEUD=('N127', 'N118', 'N118'), DDL=('DY', 'DX', 'DY'), COEF_MULT=(1.0, -0.49999999999999994, -0.8660254037844387), COEF_IMPO=0.0),
        _F(NOEUD=('N127', 'N118'), DDL=('DZ', 'DZ'), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0),
    ),
)


# =====================================================
# 4. PRESTRESS (STATIC, CYCLICALLY SYMMETRIC)
# =====================================================
# Prestress: stress state under the applied loads
# (Mecway manual v33 par. 6.3, stress stiffening).
stat = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    EXCIT=(
        _F(CHARGE=load_1),
        _F(CHARGE=load_2),
        _F(CHARGE=cycl_rel),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
sig = CREA_CHAMP(OPERATION='EXTR', TYPE_CHAM='ELGA_SIEF_R',
                 RESULTAT=stat, NUME_ORDRE=1, NOM_CHAM='SIEF_ELGA')


# =====================================================
# 5. MATRICES OF THE SECTOR WITH FIXED CUT FACES (ASSEMBLAGE)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CHARGE=(load_1, load_2, cycl_if,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigi_ela'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
        _F(MATRICE=CO('rigi_geo'), OPTION='RIGI_GEOM', SIEF_ELGA=sig),
        _F(MATRICE=CO('rigi_rot'), OPTION='RIGI_ROTA'),
    ),
)
# Prestressed stiffness (stress stiffening)
rigidite = COMB_MATR_ASSE(COMB_R=(
    _F(MATR_ASSE=rigi_ela, COEF_R=1.0),
    _F(MATR_ASSE=rigi_geo, COEF_R=1.0),
    _F(MATR_ASSE=rigi_rot, COEF_R=1.0),
))


# =====================================================
# 6. BASIS OF THE SECTOR (CALC_MODES, DEFI_INTERF_DYNA, DEFI_BASE_MODALE)
# =====================================================
# Sector modes with fixed cut faces (basis for the cyclic
# substructuring)
modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=20),
    CHAM_MATER=fieldmat,
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
lint = DEFI_INTERF_DYNA(
    NUME_DDL=numedd,
    INTERFACE=(
        _F(NOM='DROITE', TYPE='CRAIGB', GROUP_NO='BRCYC_D'),
        _F(NOM='GAUCHE', TYPE='CRAIGB', GROUP_NO='BRCYC_G'),
    ),
)
# Basis: the sector modes plus the static modes of the cut faces
bamo = DEFI_BASE_MODALE(CLASSIQUE=_F(INTERF_DYNA=lint, MODE_MECA=modes, NMAX_MODE=20))


# =====================================================
# 7. CYCLIC MODES (MODE_ITER_CYCL, U4.52.05)
# =====================================================
modcyc = MODE_ITER_CYCL(
    BASE_MODALE=bamo,
    NB_MODE=20,
    NB_SECTEUR=12,
    LIAISON=_F(DROITE='DROITE', GAUCHE='GAUCHE'),
    CALCUL=_F(NB_DIAM=(0, 1, 2, 3, 4, 5, 6), NMAX_FREQ=2),
)
# Modes on sector 1 (field DEPL per mode)
modsec = REST_SOUS_STRUC(RESU_GENE=modcyc, SECTEUR=1, NOM_CHAM='DEPL')
# The whole wheel (setting cyclic_full_wheel): skeleton with the N
# sectors and the modes on it; otherwise only the sector.
try:
    squel = DEFI_SQUELETTE(CYCLIQUE=_F(MODE_CYCL=modcyc),
                           SECTEUR=_F(TOUT='OUI'))
    modwiel = REST_SOUS_STRUC(RESU_GENE=modcyc, SQUELETTE=squel,
                              NOM_CHAM='DEPL')
except Exception as exc:
    print('aster_cyclic: WAARSCHUWING: skelet van het hele wiel niet gemaakt: %r' % (exc,))
    squel = modwiel = None
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_cyclic
res = aster_cyclic.collect(modsec, mesh, numedd, 12, 2, [0, 1, 2, 3, 4, 5, 6], axis='Y', angle=120.0, wheel=modwiel, skeleton=squel, liml='<WORKDIR>\\CY-05\\CY-05.liml')


# =====================================================
# 8. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\CY-05\\CY-05_verif_results.xml', '<WORKDIR>\\CY-05\\CY-05.liml',
    fields=['displacements'], precision='double',
    cyclic={'axis': 1, 'segments': 12})


#-- no MED export (setting med_export off) --


FIN()
