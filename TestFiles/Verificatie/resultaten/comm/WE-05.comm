    res, '<WORKDIR>\\WE-05\\WE-05_verif_results.xml', '<WORKDIR>\\WE-05\\WE-05.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    failures=globals().get('_bz_events'),
    precision='single', static=False, fields=['temperature', 'heat_flux'])


