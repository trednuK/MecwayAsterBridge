# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for DYNA_NON_LINE (nonlinear dynamics, implicit HHT/NEWMARK
# or explicit DIFF_CENT/TCHAMWA; choice "schema" in CONFIG_BRIDGE).
# Filled in via Python str.format() from bridge_to_aster.py
# (_build_nonlin_static; same builder and placeholders as STAT_NON_LINE).
#
# Placeholders (see AsterTemplate_StatNonLine.comm for the shared ones):
#   listinst_block    -> outlist (output times from Mecway <timesteps>),
#                        listinst (implicit: DEFI_LIST_INST with automatic
#                        step cutting; explicit: per output interval equal
#                        steps below the estimated CFL limit, so that every
#                        output time is a computation step)
#                        and vite0 (initial velocity, CREA_CHAMP) if present
#   statnonline_block -> DEFI_CONTACT (if there is contact2) and the
#                        DYNA_NON_LINE call with SCHEMA_TEMPS, ETAT_INIT
#                        and ARCHIVAGE at the output times, or the failure loop
#                        (bridge_failure.build_solve_block)
#   postreleve_block  -> route 'tabel': POST_RELEVE_T over all
#                        archived time steps (TOUT_ORDRE), including
#                        velocity (VITE); route 'liml': aster_results_export
#
# NOTE braces: write a literal brace as { or }.

# Language of the messages of the job scripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. READ MESH
# FORMAT='ASTER': mesh directly from the .liml (bridge_mesh.py)
# UNITE=20 corresponds to 'F mail ... D 20' in study.export
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. CREATE STANDARD GROUPS (all elements / nodes)
# =====================================================
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

# =====================================================
# 2b. NODE GROUPS FOR BOUNDARY CONDITIONS (and mesh modifications)
# Generated by _build_defigroup_block(), same as MECA_STATIQUE.
# =====================================================
#-- not used in this analysis --


# =====================================================
# 3. MODEL DEFINITION
# For each elset the matching MODELISATION is chosen:
#   1D (line2)              -> POU_D_E   (Euler beam; SEG2 only)
#   2D linear (tri3/quad4)        -> DKT
#   2D quadratic (tri6/quad8)     -> COQUE_3D (after CREA_MAILLAGE MODI_MAILLE)
#   springs (1D, spring material) -> DIS_T
#   faces with pressure (on vol.) -> 3D (boundary elements)
#   loose nodes (POI1)            -> DIS_T / DIS_TR (see bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Without elsets, pressure faces and POI1 nodes TOUT='OUI',
# MODELISATION='3D' is used.
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Balk', PHENOMENE='MECANIQUE', MODELISATION='POU_D_E'),
        _F(GROUP_MA='BRMA1', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
    ),
)


# =====================================================
# 3b. SECTION PROPERTIES (beams, shells, springs)
# =====================================================
cara = AFFE_CARA_ELEM(
    MODELE=model,
    POUTRE=_F(GROUP_MA='Balk',
           SECTION='RECTANGLE',
           CARA=('HY', 'HZ',),
           VALE=(0.02, 0.03,)),
    DISCRET=(
        _F(GROUP_MA='BRMA1', CARA='K_T_D_N', VALE=(0.0, 0.0, 0.0,)),
        _F(GROUP_MA='BRMA1', CARA='M_T_D_N', VALE=(10.0,)),
    ),
)


# =====================================================
# 3c. PLASTIC HARDENING CURVES  (DEFI_FONCTION)
# For each material with a <plastic> block in Mecway a traction function
# is defined. Code-Aster TRACTION / VMIS_ISOT_TRAC (U4.43.01 par. 5.1.1):
#   - NOM_PARA='EPSI' : TOTAL strain
#   - NOM_RESU='SIGM' : stress
#   - The ordinate of the first point is the elastic limit; a point
#     with abscissa zero is NOT allowed. The first point is therefore
#     (sigma_y / E, sigma_y).
#
# The conversion from Mecway is done in bridge_to_aster.py
# (_to_aster_traction_curve), controlled by 'plastic_strain_definition'
# in CONFIG_BRIDGE: 'plastic' -> EPSI = eps_p + sigma/E,
# 'total' -> start point (0, 0) is dropped, 'auto' -> derived from the
# first point. Invalid curves stop the generation with an ERROR in
# bridge_log.txt.
# =====================================================
#-- no plastic curves in this model --


# =====================================================
# 4. MATERIAL DEFINITION
# DEFI_MATERIAU with ELAS (always) and TRACTION (only for plastic
# materials). RHO is always included for PESANTEUR compatibility.
# =====================================================
# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=1.0),)


# =====================================================
# 5. MATERIAL ASSIGNMENT
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Balk', MATER=MAT_1),
    ),
)


# =====================================================
# 6a. TIME-DEPENDENT LOAD FUNCTIONS  (DEFI_FONCTION)
# For each <force> component with a time attribute a function of INST
# is defined. Extrapolation outside the defined time domain is
# constant on both sides.
# =====================================================
#-- no time-dependent loads in this model --


# =====================================================
# 6b. TIME DISCRETISATION AND INITIAL VELOCITY
# outlist: output times (Mecway <timesteps>); listinst: computation steps
# (see the header of this file); vite0: initial velocity.
# =====================================================
outlist = DEFI_LIST_REEL(
    VALE=(0.02, 0.04, 0.06, 0.08, 0.1, 0.12, 0.14, 0.16, 0.18, 0.2, 0.22, 0.24, 0.26, 0.28, 0.3, 0.32, 0.34, 0.36, 0.38, 0.4, 0.42, 0.44, 0.46, 0.48, 0.5, 0.52, 0.54, 0.56, 0.58, 0.6, 0.62, 0.64, 0.66, 0.68, 0.7, 0.72, 0.74, 0.76, 0.78, 0.8, 0.82, 0.84, 0.86, 0.88, 0.9, 0.92, 0.94, 0.96, 0.98, 1.0),
)

times = DEFI_LIST_REEL(
    DEBUT=0.0,
    INTERVALLE=(
        _F(JUSQU_A=0.02, NOMBRE=1),
        _F(JUSQU_A=0.04, NOMBRE=1),
        _F(JUSQU_A=0.06, NOMBRE=1),
        _F(JUSQU_A=0.08, NOMBRE=1),
        _F(JUSQU_A=0.1, NOMBRE=1),
        _F(JUSQU_A=0.12, NOMBRE=1),
        _F(JUSQU_A=0.14, NOMBRE=1),
        _F(JUSQU_A=0.16, NOMBRE=1),
        _F(JUSQU_A=0.18, NOMBRE=1),
        _F(JUSQU_A=0.2, NOMBRE=1),
        _F(JUSQU_A=0.22, NOMBRE=1),
        _F(JUSQU_A=0.24, NOMBRE=1),
        _F(JUSQU_A=0.26, NOMBRE=1),
        _F(JUSQU_A=0.28, NOMBRE=1),
        _F(JUSQU_A=0.3, NOMBRE=1),
        _F(JUSQU_A=0.32, NOMBRE=1),
        _F(JUSQU_A=0.34, NOMBRE=1),
        _F(JUSQU_A=0.36, NOMBRE=1),
        _F(JUSQU_A=0.38, NOMBRE=1),
        _F(JUSQU_A=0.4, NOMBRE=1),
        _F(JUSQU_A=0.42, NOMBRE=1),
        _F(JUSQU_A=0.44, NOMBRE=1),
        _F(JUSQU_A=0.46, NOMBRE=1),
        _F(JUSQU_A=0.48, NOMBRE=1),
        _F(JUSQU_A=0.5, NOMBRE=1),
        _F(JUSQU_A=0.52, NOMBRE=1),
        _F(JUSQU_A=0.54, NOMBRE=1),
        _F(JUSQU_A=0.56, NOMBRE=1),
        _F(JUSQU_A=0.58, NOMBRE=1),
        _F(JUSQU_A=0.6, NOMBRE=1),
        _F(JUSQU_A=0.62, NOMBRE=1),
        _F(JUSQU_A=0.64, NOMBRE=1),
        _F(JUSQU_A=0.66, NOMBRE=1),
        _F(JUSQU_A=0.68, NOMBRE=1),
        _F(JUSQU_A=0.7, NOMBRE=1),
        _F(JUSQU_A=0.72, NOMBRE=1),
        _F(JUSQU_A=0.74, NOMBRE=1),
        _F(JUSQU_A=0.76, NOMBRE=1),
        _F(JUSQU_A=0.78, NOMBRE=1),
        _F(JUSQU_A=0.8, NOMBRE=1),
        _F(JUSQU_A=0.82, NOMBRE=1),
        _F(JUSQU_A=0.84, NOMBRE=1),
        _F(JUSQU_A=0.86, NOMBRE=1),
        _F(JUSQU_A=0.88, NOMBRE=1),
        _F(JUSQU_A=0.9, NOMBRE=1),
        _F(JUSQU_A=0.92, NOMBRE=1),
        _F(JUSQU_A=0.94, NOMBRE=1),
        _F(JUSQU_A=0.96, NOMBRE=1),
        _F(JUSQU_A=0.98, NOMBRE=1),
        _F(JUSQU_A=1.0, NOMBRE=1),
    ),
)

listinst = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=times),
    ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE',
             SUBD_METHODE='MANUEL', SUBD_PAS=4,
             SUBD_NIVEAU=6),
)



# =====================================================
# 7. BOUNDARY CONDITIONS AND LOADS  (AFFE_CHAR_MECA / _F)
# load_1: boundary conditions (DDL_IMPO, LIAISON_*) and couplings; then one
# load per load case (FORCE_*, PRES_REP, PESANTEUR), because Code-Aster
# overwrites loads within one load instead of adding them. Components with
# a time history refer to the DEFI_FONCTION's from step 6a
# (AFFE_CHAR_MECA_F, or FONC_MULT in EXCIT for a moment on faces).
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_NO='Inklemming', BLOCAGE=('DEPLACEMENT', 'ROTATION')),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Tip', FY=100.0),
)


# =====================================================
# 8. SOLVER: NONLINEAR DYNAMICS  (DYNA_NON_LINE)
# Implicit (HHT/NEWMARK): Newton-Raphson per time step; explicit
# (DIFF_CENT/TCHAMWA): diagonal mass, no iterations, STOP_CFL.
# Contact (DEFI_CONTACT, CONTINUE) and the initial velocity (ETAT_INIT VITE)
# are in this block if the model has them.
#
#   CARA_ELEM     - only if step 3b contains an AFFE_CARA_ELEM.
#   EXCIT         - all loads from step 7 (load_1, load_2, ...).
#   COMPORTEMENT  - per elset (and POI1 group): RELATION ('ELAS',
#                   'VMIS_ISOT_TRAC', 'VMIS_ISOT_LINE', 'VMIS_CINE_LINE',
#                   'CABLE' or for gaps 'DIS_CHOC') and DEFORMATION from
#                   CONFIG_BRIDGE ("deformation", default 'GROT_GDEP';
#                   per elset the form that Code-Aster accepts,
#                   bridge_to_aster._deformation_for). Without elsets:
#                   TOUT='OUI', 'ELAS'.
#   INCREMENT     - LIST_INST is linked to listinst (step 6b).
#   SOLVEUR       - MUMPS with NPREC from CONFIG_BRIDGE ("solver_nprec").
#   NEWTON        - REAC_ITER from CONFIG_BRIDGE ("newton_reac_iter",
#                   default 1 = tangent matrix every iteration).
#   CONVERGENCE   - RESI_GLOB_RELA and ITER_GLOB_MAXI from CONFIG_BRIDGE
#                   ("convergence_resi_rela", "newton_max_iter").
# =====================================================
try:
    res = DYNA_NON_LINE(
        MODELE=model,
        CHAM_MATER=fieldmat,
        CARA_ELEM=cara,
        EXCIT=(
            _F(CHARGE=load_1),
            _F(CHARGE=load_2),
        ),
        COMPORTEMENT=(
            _F(GROUP_MA='Balk', RELATION='ELAS', DEFORMATION='PETIT'),
            _F(GROUP_MA='BRMA1', RELATION='ELAS', DEFORMATION='PETIT'),
        ),
        INCREMENT=_F(LIST_INST=listinst),
        SCHEMA_TEMPS=_F(SCHEMA='NEWMARK', FORMULATION='DEPLACEMENT'),
        ARCHIVAGE=_F(LIST_INST=outlist),
        SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
        NEWTON=_F(REAC_ITER=1),
        CONVERGENCE=_F(RESI_GLOB_RELA=1e-05, ITER_GLOB_MAXI=20),
    )
except Exception as err:
    if not str(getattr(err, 'id_message', '')).startswith('MECANONLINE'):
        raise
    print('BRIDGE_ONVOLLEDIG', res.getAccessParameters()['INST'][-1])
t_res = res.getAccessParameters()['INST'][-1]


# =====================================================
# 9. COMPUTE POST-PROCESSING FIELDS  (CALC_CHAMP)
# Same fields as MECA_STATIQUE; if at least one material has a
# hardening curve, the following are added on the 3D elsets:
#   EPSP_NOEU  - plastic strain tensor
#   VARI_NOEU  - internal variables (V1 = eq. plastic strain)
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Beams: extreme axial stress in the cross-section.
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Balk',),
    CONTRAINTE=('SIPM_ELNO', ),
)

# Section forces of beams (result field beam_forces).
res = CALC_CHAMP(reuse=res, RESULTAT=res, GROUP_MA=('Balk',), CONTRAINTE=('EFGE_ELNO', 'EFGE_NOEU', ))



# =====================================================
# 10. RESULT EXTRACTION
# All archived time steps: route 'liml' (default) via
# aster_results_export, route 'tabel' with POST_RELEVE_T TOUT_ORDRE='OUI'
# (the table has a column INST).
# =====================================================
#-- tables not needed (result_route='liml') --


# =====================================================
# 11. WRITE TABLES TO .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\MD-07\\MD-07_verif_results.xml', '<WORKDIR>\\MD-07\\MD-07.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    precision='single', opt_in=['beam_forces'])


# =====================================================
# 12. EXPORT TO MED FORMAT (ParaView / Salome), only with the
# setting "med_export" (bridge_to_aster._build_impr_resu_block;
# UNITE=80 -> 'F rmed ... R 80' in study.export). Mecway receives the
# results via the .liml or the tables, not via an export file.
# =====================================================
#-- no MED export (setting med_export off) --


FIN()
