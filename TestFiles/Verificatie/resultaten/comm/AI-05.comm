# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for acoustic cavity modes (Mecway A30, Acoustic Resonance
# 3D): PHENOMENE='ACOUSTIQUE', ASSEMBLAGE RIGI_ACOU/MASS_ACOU and
# CALC_MODES. Filled in via str.format() from bridge_acoustic.py
# (build_acoustic_modes).
#
# Placeholders (name between single braces):
#   model_block       -> AFFE_MODELE (volumes, ACOUSTIQUE / 3D)
#   materials_block   -> DEFI_MATERIAU FLUIDE per material
#   fieldmat_block    -> AFFE_MATERIAU assignment
#   loads_block       -> AFFE_CHAR_ACOU PRES_IMPO (pressure nodes) + #ASTER code
#   assemblage_block  -> ASSEMBLAGE and the real matrices (COMB_MATR_ASSE)
#   calc_modes_block  -> res = CALC_MODES(...)
#   export_block      -> aster_results_export (one <mode> per cavity mode)
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
# and the setting vtu_export (aster_vtu)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
_bridge_os.environ['BRIDGE_VTU'] = '0'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. MODEL AND MATERIALS (air/fluid)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('Lucht',), PHENOMENE='ACOUSTIQUE', MODELISATION='3D'),
        _F(GROUP_MA=('Absorbeerder',), PHENOMENE='ACOUSTIQUE', MODELISATION='3D_ABSO'),
    ),
)


# material 'Lucht'
MAC1 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.2, CELE_R=340.0))
# Impedance faces: CELE_R = 1 gives AMOR_ACOU = int N N dA (bridge_acoustic,
# complex modes); the other impedance faces in the same matrix ~0.
MAZ1 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.0, CELE_R=1.0))
MAZ0 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.0, CELE_R=1.0e+30))


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Lucht', MATER=MAC1),
        _F(GROUP_MA='Absorbeerder', MATER=MAC1),
    ),
)


# =====================================================
# 3. PRESSURE NODES (p = 0); faces without a condition are rigid walls
# =====================================================
#-- pressure nodes: eliminated in aster_acoustic_complex (none) --


# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigi_c'), OPTION='RIGI_ACOU'),
        _F(MATRICE=CO('mass_c'), OPTION='MASS_ACOU'),
    ),
)
# Impedance Absorbeerder: Z = 2000-1000i
chz1 = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Lucht', MATER=MAC1),
        _F(GROUP_MA='Absorbeerder', MATER=MAZ1),
    ),
)
mez1 = CALC_MATR_ELEM(OPTION='AMOR_ACOU', MODELE=model, CHAM_MATER=chz1)
amz1 = ASSE_MATRICE(MATR_ELEM=mez1, NUME_DDL=numedd)


# =====================================================
# 5. CAVITY MODES (CALC_MODES, U4.52.02)
# =====================================================
# Complex modes (impedance): quadratic eigenvalue problem
# (K + l C + l^2 M) P = 0, C = sum rho/Z int N N dA (Mecway manual
# par. 6.9.2), solved with scipy in aster_acoustic_complex
# (CALC_MODES does not take MATR_AMOR for pressure matrices).
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_acoustic_complex
aster_acoustic_complex.solve_modes(
    rigi_c, mass_c, [
        (amz1, complex(0.00048, 0.00024), 'Absorbeerder: Z = 2000-1000i'),
    ],
    numedd, mesh, '<WORKDIR>\\AI-05\\AI-05_verif_results.xml', '<WORKDIR>\\AI-05\\AI-05.liml',
    n_modes=6, dirichlet=[],
    shift_hz=0.0, free_shift_hz=-16.8325082306035, c_ref=340.0, size_ref=1.00995049383621,
    tolerance=1e-06, precision='double')


# =====================================================
# 6. RESULTS TO MECWAY
# =====================================================
#-- no #ASTER-POST --


#-- no MED export (complex modes: no Code-Aster result) --


FIN()
