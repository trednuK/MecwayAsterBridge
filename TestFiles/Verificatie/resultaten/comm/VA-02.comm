# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for vibro-acoustics: coupled eigenmodes of a structure
# and an air or liquid volume (Mecway Frequency model V30 with a
# fluid part). PHENOMENE='MECANIQUE' with 3D_FLUIDE (fluid),
# FLUI_STRU (coupling face) and the ordinary mechanical elements, FORMULATION
# 'U_P_PHI' (test case adlv100a). Filled in via str.format() from
# bridge_vibroacoustic.build_vibroacoustic_modes.
#
# Placeholders (name between single braces):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#                        (structure, as in modal) and ORIE_PEAU of the
#                        coupling faces (normal out of the fluid)
#   model_block       -> AFFE_MODELE: structure, 3D_FLUIDE, FLUI_STRU
#   cara_elem_block   -> AFFE_CARA_ELEM (beams, shells, springs, masses)
#   materials_block   -> DEFI_MATERIAU: ELAS (structure), FLUIDE (RHO,
#                        CELE_R)
#   fieldmat_block    -> AFFE_MATERIAU (coupling faces get the fluid)
#   loads_block       -> supports of the structure and pressure nodes
#                        (DDL_IMPO PRES = 0, PHI = 0)
#   assemblage_block  -> ASSEMBLAGE RIGI_MECA and MASS_MECA
#   calc_modes_block  -> band search (INFO_MODE), CALC_MODES BANDE,
#                        EXTR_MODE -> res
#   export_block      -> aster_results_export (one <mode> per mode with
#                        displ and pressure)
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
# and the setting vtu_export (aster_vtu)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
_bridge_os.environ['BRIDGE_VTU'] = '0'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --

# Coupling faces: normal out of the fluid (ORIE_PEAU with GROUP_MA_INTERNE,
# as in adlv100b/adls102a)
mesh = MODI_MAILLAGE(
    reuse=mesh,
    MAILLAGE=mesh,
    ORIE_PEAU=(
        _F(GROUP_MA_PEAU='BRFSI1', GROUP_MA_INTERNE='Water'),
    ),
)


# =====================================================
# 2. MODEL, SECTIONS, MATERIALS
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Staaf', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Water', PHENOMENE='MECANIQUE', MODELISATION='3D_FLUIDE', FORMULATION='U_P_PHI'),
        _F(GROUP_MA='BRFSI1', PHENOMENE='MECANIQUE', MODELISATION='FLUI_STRU', FORMULATION='U_P_PHI'),
    ),
)


#-- not used in this analysis --


# material 'PVC'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=3000000000.0, NU=0.0, RHO=1400.0),)
# material 'Water'
MAF1 = DEFI_MATERIAU(FLUIDE=_F(RHO=1000.0, CELE_R=1480.0))


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Staaf', MATER=MAT_1),
        _F(GROUP_MA='Water', MATER=MAF1),
        _F(GROUP_MA='BRFSI1', MATER=MAF1),
    ),
)


# =====================================================
# 3. BOUNDARY CONDITIONS (supports, pressure nodes)
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO='Inklemming', DX=0.0, DY=0.0, DZ=0.0),
        _F(GROUP_NO='Staafknopen', DY=0.0, SANS_GROUP_NO=('Inklemming',)),
        _F(GROUP_NO='Staafknopen', DZ=0.0, SANS_GROUP_NO=('Inklemming',)),
    ),
)


# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CHARGE=(load_1,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


# =====================================================
# 5. COUPLED EIGENMODES (INFO_MODE, CALC_MODES BANDE)
# =====================================================
# Coupled modes (U_P_PHI): every PHI degree of freedom gives a
# spurious mode at 0 Hz; hence the band [f_min, f_max] with at least
# bridge_n modes (Sturm count INFO_MODE) and CALC_MODES BANDE
# (bridge_vibroacoustic._mode_search_block).
bridge_n = 4
bridge_fmin = 0.1

def _bridge_count(_fhi):
    _t = INFO_MODE(TYPE_MODE='DYNAMIQUE', MATR_RIGI=rigidite,
                   MATR_MASS=masse, FREQ=(bridge_fmin, _fhi),
                   SOLVEUR=_F(METHODE='MUMPS', NPREC=8))
    return int(_t.EXTR_TABLE().values()['NB_MODE'][0])

_lo, _hi = bridge_fmin, max(10.0 * bridge_fmin, 1.0)
_nhi = _bridge_count(_hi)
while _nhi < bridge_n and _hi < 1.0e7:
    _lo, _hi = _hi, 4.0 * _hi
    _nhi = _bridge_count(_hi)
for _k in range(2):
    _mid = (_lo * _hi) ** 0.5
    if _mid <= _lo * 1.0001:
        break
    _nmid = _bridge_count(_mid)
    if _nmid >= bridge_n:
        _hi, _nhi = _mid, _nmid
    else:
        _lo = _mid
print('BRIDGE_VIBRO_BAND', bridge_fmin, _hi, _nhi)
if _nhi < 1:
    raise ValueError('BRIDGE_VIBRO: geen modes tussen %g en %g Hz' % (bridge_fmin, _hi))
# Without NORM_MODE: BANDE can also return a spurious mode outside
# the band (seen: 3e-5 Hz with MASS_GENE < 0); normalizing on
# MASS_GENE gave <EXCEPTION> DVP_2. Filter first, then normalize.
res_band = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='BANDE',
    CALC_FREQ=_F(FREQ=(bridge_fmin, _hi)),
    SOLVEUR_MODAL=_F(COEF_DIM_ESPACE=4),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
_tb = RECU_TABLE(CO=res_band, NOM_PARA=('FREQ', 'MASS_GENE')).EXTR_TABLE().values()
_good = [_i for _i, _f, _m in zip(_tb['NUME_ORDRE'], _tb['FREQ'],
                                  _tb['MASS_GENE'])
         if _f >= bridge_fmin * (1.0 - 1.0e-6) and _m > 0.0]
_spur = len(_tb['NUME_ORDRE']) - len(_good)
if _spur:
    print('BRIDGE_VIBRO_VALS', _spur)
if len(_good) < bridge_n:
    print('BRIDGE_VIBRO_TEKORT', len(_good), bridge_n)
if not _good:
    raise ValueError('BRIDGE_VIBRO: geen bruikbare modes tussen %g en %g Hz' % (bridge_fmin, _hi))
res = EXTR_MODE(FILTRE_MODE=_F(MODE=res_band,
                               NUME_ORDRE=tuple(_good[:bridge_n])))
res = NORM_MODE(reuse=res, MODE=res, NORME='MASS_GENE')


# =====================================================
# 6. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (result_route 'liml')
_tf = RECU_TABLE(CO=res, NOM_PARA=('FREQ',)).EXTR_TABLE().values()
for _i, _f in zip(_tf['NUME_ORDRE'], _tf['FREQ']):
    print('BRIDGE_MODE {0} FREQ={1!r}'.format(_i, _f))
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\VA-02\\VA-02_verif_results.xml', '<WORKDIR>\\VA-02\\VA-02.liml',
    fields=['displacements', 'pressure'], precision='double')


#-- no MED export (setting med_export off) --


FIN()
