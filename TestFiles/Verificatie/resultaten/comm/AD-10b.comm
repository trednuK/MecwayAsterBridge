# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for thermal analyses (Mecway T30 steady state / T31 transient):
# THER_LINEAIRE, or THER_NON_LINE with radiation or convection/radiation on
# shell faces. Filled in via str.format() from bridge_thermal.py
# (build_thermal).
#
# Temperatures are in degrees CELSIUS (RAYONNEMENT computes with T + 273.15,
# U4.44.02); aster_results_export.py converts 'temperature' back to Kelvin.
#
# Placeholders (name between single braces):
#   defigroup_block   -> MODI_MAILLAGE ROTATION (shells outside Z = constant),
#                        DEFI_GROUP (subgroups per face type and per
#                        shell thickness, node groups for node temperatures)
#                        and MODI_MAILLAGE ORIE_PEAU
#   model_block       -> AFFE_MODELE: volumes '3D', flat shells and their
#                        edges 'PLAN', faces of volumes '3D'
#   materials_block   -> DEFI_MATERIAU THER (linear) or THER_NL
#   fieldmat_block    -> AFFE_MATERIAU per elset
#   funcs_block       -> DEFI_FONCTION / DEFI_CONSTANTE (time tables,
#                        sources as a function of TEMP), FORMULE of INST
#                        (shell face convection/radiation with a time table)
#   listinst_block    -> DEFI_LIST_REEL (+ CREA_CHAMP initial temperature)
#   loads_block       -> AFFE_CHAR_THER(_F) load_1, load_2, ...; heatflow on
#                        nodes: source field M^-1 F (loadqn_1, ...)
#   solve_block       -> THER_LINEAIRE / THER_NON_LINE
#   calc_champ_block  -> res_flux = CALC_CHAMP FLUX_ELGA, FLUX_ELNO, FLUX_NOEU
#                        (rotated mesh: flux and mesh rotated back)
#   export_block      -> aster_results_export (Mecway results)
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
# and the setting vtu_export (aster_vtu)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
_bridge_os.environ['BRIDGE_VTU'] = '0'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(NOM='all_elems', TOUT='OUI'),
    CREA_GROUP_NO=_F(NOM='all_nodes', GROUP_MA='all_elems'),
)

#-- no extra groups --


# ---- BRIDGE_ADAPT_BEGIN: with adaptive refinement (adapt_homard) the part up to
# ===== Adaptive refinement with HOMARD (bridge_homard.py, step S35b) =====
# Each loop: the whole solve below on the current mesh, a ZZ indicator
# (aster_adapt.py; the native ERTH/ERZ1/ERZ2/ERME stop on HOMARD's
# transition cells, S35a), Doerfler selection 0.5 -> group BRADAP<k>
# -> 0/1 field CART_NEUT_R -> MACR_ADAP_MAIL RAFFINEMENT
# CRIT_RAFF_ABS=0.5 (pattern of test case forma07b). After the loop the
# result is projected onto the original mesh (PROJ_CHAMP with MODELE_1/2,
# U4.72.05; node fields exact at the original nodes, element-node fields
# from one neighbouring element: S35a) for aster_results_export.
import sys as _adapt_sys
_adapt_sys.path.insert(0, '<REPO>\\Scripts')
import aster_adapt as _adapt_mod
_adapt_run = _adapt_mod.Loop(target=0.15, max_loops=10, max_elements=200000, fraction=0.5, solids=('Plaat',))
_adapt_mesh0 = mesh
for _adapt_k in range(10 + 1):
    if _adapt_k > 0:
        pass
    # end marker below runs in a loop over the refined meshes (bridge_homard.py) ----

    # =====================================================
    # 2. MODEL (PHENOMENE='THERMIQUE')
    # =====================================================
    model = AFFE_MODELE(
        MAILLAGE=mesh,
        AFFE=(
            _F(GROUP_MA=('Plaat',), PHENOMENE='THERMIQUE', MODELISATION='3D'),
        ),
    )


    # =====================================================
    # 3. MATERIALS
    # THER: LAMBDA (conductivity) and RHO_CP (density x specific heat).
    # Shells as PLAN: both times f = t / t_ref (see bridge_thermal.py).
    # =====================================================
    # material 'Staal'
    MTH1 = DEFI_MATERIAU(THER=_F(LAMBDA=50.0, RHO_CP=0.0))

    fieldmat = AFFE_MATERIAU(
        MAILLAGE=mesh,
        MODELE=model,
        AFFE=(
            _F(GROUP_MA='Plaat', MATER=MTH1),
        ),
    )


    # =====================================================
    # 4. FUNCTIONS (time: PROL CONSTANT; temperature: PROL LINEAIRE)
    # =====================================================
    #-- no functions --


    # =====================================================
    # 5. TIME STEPS (steady state: only 0.0) AND INITIAL TEMPERATURE
    # =====================================================
    times = DEFI_LIST_REEL(VALE=(0.0,))


    # =====================================================
    # 6. BOUNDARY CONDITIONS AND LOADS
    # Each Mecway load gets its own load (EXCIT adds them up); prescribed
    # temperatures together in the first load(s). All sources as a function
    # (SOURCE in AFFE_CHAR_THER_F) together in one load, per part of the mesh the
    # sum (Code-Aster 17.4 computes two such loads as the first;
    # bridge_thermal._Thermal.add_func_source).
    # =====================================================
    load_1 = AFFE_CHAR_THER(
        MODELE=model,
        TEMP_IMPO=(
            _F(GROUP_MA='Koud', TEMP=0.0),
            _F(GROUP_MA='Warm', TEMP=100.0),
        ),
    )


    # =====================================================
    # 7. SOLVE
    # =====================================================
    res = THER_LINEAIRE(
        MODELE=model,
        CHAM_MATER=fieldmat,
        EXCIT=(
            _F(CHARGE=load_1),
        ),
        TYPE_CALCUL='STAT',
        INCREMENT=_F(LIST_INST=times),
        SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
    )


    # =====================================================
    # 8. HEAT FLUX
    # =====================================================
    res_flux = CALC_CHAMP(
        RESULTAT=res,
        GROUP_MA=('Plaat',),
        THERMIQUE=('FLUX_ELGA',),
    )
    res_flux = CALC_CHAMP(
        reuse=res_flux,
        RESULTAT=res_flux,
        GROUP_MA=('Plaat',),
        THERMIQUE=('FLUX_ELNO', 'FLUX_NOEU'),
    )


    if _adapt_k == 0:
        _adapt_model0 = model
    _adapt_f = CALC_CHAMP(RESULTAT=res, GROUP_MA=('Plaat',), THERMIQUE=('FLUX_ELNO', 'FLUX_NOEU'))
    _adapt_sel = _adapt_run.after_solve(_adapt_k, _adapt_f, 'FLUX_ELNO', 'FLUX_NOEU', mesh)
    if _adapt_sel is None:
        break
    _adapt_grp = 'BRADAP%d' % _adapt_k
    mesh.setGroupOfCells(_adapt_grp, _adapt_sel)
    _adapt_ind = CREA_CHAMP(TYPE_CHAM='CART_NEUT_R', OPERATION='AFFE', MAILLAGE=mesh, AFFE=(
        _F(TOUT='OUI', NOM_CMP='X1', VALE=0.0),
        _F(GROUP_MA=_adapt_grp, NOM_CMP='X1', VALE=1.0)))
    _adapt_name = 'bradap%d' % (_adapt_k + 1)
    MACR_ADAP_MAIL(
        ADAPTATION='RAFFINEMENT', CHAM_GD=_adapt_ind, CRIT_RAFF_ABS=0.5,
        MAILLAGE_N=mesh, MAILLAGE_NP1=CO(_adapt_name),
        FRONTIERE_ANALYTIQUE=(
            _F(NOM='R1', TYPE='CYLINDRE', GROUP_MA='BRRAND1', X_CENTRE=0.0, Y_CENTRE=0.0, Z_CENTRE=0.0, X_AXE=0.0, Y_AXE=0.0, Z_AXE=1.0, RAYON=0.01),
        ))
    # HOMARD can fail without an exception (no new mesh; S35a)
    if _adapt_name not in globals():
        _adapt_run.homard_failed(_adapt_k)
        break
    mesh = globals()[_adapt_name]
_adapt_run.summary()
_adapt_fine = dict((k, globals()[k]) for k in ('res', 'res_flux') if k in globals())
if 'res' in _adapt_fine:
    res = PROJ_CHAMP(RESULTAT=_adapt_fine['res'], MODELE_1=model,
        MODELE_2=_adapt_model0,
        NOM_CHAM=_adapt_mod.projected_fields(_adapt_fine['res']))
if 'res_flux' in _adapt_fine:
    res_flux = PROJ_CHAMP(RESULTAT=_adapt_fine['res_flux'], MODELE_1=model,
        MODELE_2=_adapt_model0,
        NOM_CHAM=_adapt_mod.projected_fields(_adapt_fine['res_flux']))
model = _adapt_model0
mesh = _adapt_mesh0
# ===== end of the adaptive refinement =====
# ---- BRIDGE_ADAPT_END ----

# =====================================================
# 9. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\AD-10b\\AD-10b_verif_results.xml', '<WORKDIR>\\AD-10b\\AD-10b.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    failures=globals().get('_bz_events'),
    precision='double', static=True, fields=['temperature', 'heat_flux'])


# =====================================================
# 10. MED (ParaView / Salome), only with the setting "med_export";
# UNITE=80 = 'F rmed ... R 80'
# =====================================================
#-- no MED export (setting med_export off) --


FIN()
