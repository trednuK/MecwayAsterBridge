# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for thermal analyses (Mecway T30 steady state / T31 transient):
# THER_LINEAIRE, or THER_NON_LINE with radiation or convection/radiation on
# shell faces. Filled in via str.format() from bridge_thermal.py
# (build_thermal).
#
# Temperatures are in degrees CELSIUS (RAYONNEMENT computes with T + 273.15,
# U4.44.02); aster_results_export.py converts 'temperature' back to Kelvin.
#
# Placeholders (name between single braces):
#   defigroup_block   -> MODI_MAILLAGE ROTATION (shells outside Z = constant),
#                        DEFI_GROUP (subgroups per face type and per
#                        shell thickness, node groups for node temperatures)
#                        and MODI_MAILLAGE ORIE_PEAU
#   model_block       -> AFFE_MODELE: volumes '3D', flat shells and their
#                        edges 'PLAN', faces of volumes '3D'
#   materials_block   -> DEFI_MATERIAU THER (linear) or THER_NL
#   fieldmat_block    -> AFFE_MATERIAU per elset
#   funcs_block       -> DEFI_FONCTION / DEFI_CONSTANTE (time tables,
#                        sources as a function of TEMP), FORMULE of INST
#                        (shell face convection/radiation with a time table)
#   listinst_block    -> DEFI_LIST_REEL (+ CREA_CHAMP initial temperature)
#   loads_block       -> AFFE_CHAR_THER(_F) load_1, load_2, ...; heatflow on
#                        nodes: source field M^-1 F (loadqn_1, ...)
#   solve_block       -> THER_LINEAIRE / THER_NON_LINE
#   calc_champ_block  -> res_flux = CALC_CHAMP FLUX_ELGA, FLUX_ELNO, FLUX_NOEU
#                        (rotated mesh: flux and mesh rotated back)
#   export_block      -> aster_results_export (Mecway results)
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
# and the setting vtu_export (aster_vtu)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
_bridge_os.environ['BRIDGE_VTU'] = '0'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(NOM='all_elems', TOUT='OUI'),
    CREA_GROUP_NO=_F(NOM='all_nodes', GROUP_MA='all_elems'),
)

mesh = MODI_MAILLAGE(
    reuse=mesh,
    MAILLAGE=mesh,
    ORIE_PEAU=_F(GROUP_MA_PEAU=('Warm',)),
)


# =====================================================
# 2. MODEL (PHENOMENE='THERMIQUE')
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('Staaf',), PHENOMENE='THERMIQUE', MODELISATION='3D'),
        _F(GROUP_MA=('Warm',), PHENOMENE='THERMIQUE', MODELISATION='3D'),
    ),
)


# =====================================================
# 3. MATERIALS
# THER: LAMBDA (conductivity) and RHO_CP (density x specific heat).
# Shells as PLAN: both times f = t / t_ref (see bridge_thermal.py).
# =====================================================
MTH1_L = DEFI_FONCTION(NOM_PARA='TEMP', VALE=(
    -273.15, 50.0,
    26.85, 50.0,
    1026.85, 25.0,
    11026.85, 25.0,
), PROL_GAUCHE='CONSTANT', PROL_DROITE='CONSTANT')
MTH1_C = DEFI_FONCTION(NOM_PARA='TEMP', VALE=(
    -273.15, 3510000.0,
    26.85, 3510000.0,
    36.85, 3533400.0,
    46.85, 3556800.0,
    56.85, 3580200.0,
    66.85, 3603600.0,
    76.85, 3627000.0,
    86.85, 3650400.0,
    96.85, 3673800.0,
    106.85, 3697200.0,
    116.85, 3720600.0,
    126.85, 3744000.0,
    136.85, 3767400.0,
