    676.85, 5031000.0,
    686.85, 5054400.0,
    696.85, 5077800.0,
    706.85, 5101200.0,
    716.85, 5124600.0,
    726.85, 5148000.0,
    736.85, 5171400.0,
    746.85, 5194800.0,
    756.85, 5218200.0,
    766.85, 5241600.0,
    776.85, 5265000.0,
    786.85, 5288400.0,
    796.85, 5311800.0,
    806.85, 5335200.0,
    816.85, 5358600.0,
    826.85, 5382000.0,
    836.85, 5405400.0,
    846.85, 5428800.0,
    856.85, 5452200.0,
    866.85, 5475600.0,
    876.85, 5499000.0,
    886.85, 5522400.0,
    896.85, 5545800.0,
    906.85, 5569200.0,
    916.85, 5592600.0,
    926.85, 5616000.0,
    936.85, 5639400.0,
    946.85, 5662800.0,
    956.85, 5686200.0,
    966.85, 5709600.0,
    976.85, 5733000.0,
    986.85, 5756400.0,
    996.85, 5779800.0,
    1006.85, 5803200.0,
    1016.85, 5826600.0,
    1026.85, 5850000.0,
    11026.85, 5850000.0,
), PROL_GAUCHE='CONSTANT', PROL_DROITE='CONSTANT')
# material 'Staal'
MTH1 = DEFI_MATERIAU(THER_NL=_F(LAMBDA=MTH1_L, RHO_CP=MTH1_C))

fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Staaf', MATER=MTH1),
    ),
)


# =====================================================
# 4. FUNCTIONS (time: PROL CONSTANT; temperature: PROL LINEAIRE)
# =====================================================
#-- no functions --


# =====================================================
# 5. TIME STEPS (steady state: only 0.0) AND INITIAL TEMPERATURE
# =====================================================
times = DEFI_LIST_REEL(VALE=(
    0.0, 0.02, 0.04, 0.06, 0.08, 0.1, 0.12, 0.14,
    0.16, 0.18, 0.2, 0.22, 0.24, 0.26, 0.28, 0.3,
    0.32, 0.34, 0.36, 0.38, 0.4, 0.42, 0.44, 0.46,
    0.48, 0.5, 0.52, 0.54, 0.56, 0.58, 0.6, 0.62,
    0.64, 0.66, 0.68, 0.7, 0.72, 0.74, 0.76, 0.78,
    0.8, 0.82, 0.84, 0.86, 0.88, 0.9, 0.92, 0.94,
    0.96, 0.98, 1.0, 1.02, 1.04, 1.06, 1.08, 1.1,
    1.12, 1.14, 1.16, 1.18, 1.2, 1.22, 1.24, 1.26,
    1.28, 1.3, 1.32, 1.34, 1.36, 1.38, 1.4, 1.42,
    1.44, 1.46, 1.48, 1.5, 1.52, 1.54, 1.56, 1.58,
    1.6, 1.62, 1.64, 1.66, 1.68, 1.7, 1.72, 1.74,
    1.76, 1.78, 1.8, 1.82, 1.84, 1.86, 1.88, 1.9,
    1.92, 1.94, 1.96, 1.98, 2.0,
))
temp0 = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MODELE=model,
    AFFE=(
        _F(TOUT='OUI', NOM_CMP='TEMP', VALE=-273.15),
        _F(GROUP_NO='Alle', NOM_CMP='TEMP', VALE=20.0),
    ),
)


# =====================================================
# 6. BOUNDARY CONDITIONS AND LOADS
# Each Mecway load gets its own load (EXCIT adds them up); prescribed
# temperatures together in the first load(s). All sources as a function
# (SOURCE in AFFE_CHAR_THER_F) together in one load, per part of the mesh the
# sum (Code-Aster 17.4 computes two such loads as the first;
# bridge_thermal._Thermal.add_func_source).
# =====================================================
load_1 = AFFE_CHAR_THER(
    MODELE=model,
    FLUX_REP=(
        _F(GROUP_MA='Warm', FLUN=10000000.0),
    ),
)


# =====================================================
# 7. SOLVE
# =====================================================
res = THER_NON_LINE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    EXCIT=(
        _F(CHARGE=load_1),
    ),
    TYPE_CALCUL='TRAN',
    ETAT_INIT=_F(CHAM_NO=temp0),
    SCHEMA_TEMPS=_F(SCHEMA='THETA', THETA=0.57),
    INCREMENT=_F(LIST_INST=times),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
    NEWTON=_F(REAC_ITER=1),
    CONVERGENCE=_F(RESI_GLOB_RELA=1.0e-06, ITER_GLOB_MAXI=20),
)


# =====================================================
# 8. HEAT FLUX
# =====================================================
res_flux = CALC_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    THERMIQUE=('FLUX_ELGA',),
)
res_flux = CALC_CHAMP(
    reuse=res_flux,
    RESULTAT=res_flux,
    GROUP_MA=('Staaf',),
    THERMIQUE=('FLUX_ELNO', 'FLUX_NOEU'),
)


# =====================================================
# 9. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\WE-04b\\WE-04b_verif_results.xml', '<WORKDIR>\\WE-04b\\WE-04b.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    failures=globals().get('_bz_events'),
    precision='single', static=False, fields=['temperature', 'heat_flux'])


# =====================================================
# 10. MED (ParaView / Salome), only with the setting "med_export";
# UNITE=80 = 'F rmed ... R 80'
# =====================================================
#-- no MED export (setting med_export off) --


FIN()
