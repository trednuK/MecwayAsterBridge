    386.85, 4352400.0,
    396.85, 4375800.0,
    406.85, 4399200.0,
    416.85, 4422600.0,
    426.85, 4446000.0,
    436.85, 4469400.0,
    446.85, 4492800.0,
    456.85, 4516200.0,
