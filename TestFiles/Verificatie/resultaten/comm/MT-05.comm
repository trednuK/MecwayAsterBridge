res = THER_LINEAIRE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    EXCIT=(
        _F(CHARGE=load_1),
    ),
    TYPE_CALCUL='TRAN',
    ETAT_INIT=_F(CHAM_NO=temp0),
