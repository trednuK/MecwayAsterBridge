# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for MODE_ITER_CYCL: modal analysis with cyclic symmetry
# (Mecway V30 with a Cyclic symmetry constraint). Filled in via
# str.format() from bridge_cyclic.py (build_cyclic_modes).
#
# Placeholders (name between single braces):
#   defigroup_block    -> DEFI_GROUP / MODI_MAILLAGE (as in MECA_STATIQUE)
#   rotate_block       -> symmetry axis X/Y: rotate the mesh to the Z axis
#   model_block        -> AFFE_MODELE per elset
#   cara_elem_block    -> AFFE_CARA_ELEM (point masses)
#   materials_block    -> DEFI_MATERIAU per material (with RHO)
#   fieldmat_block     -> AFFE_MATERIAU assignment
#   loads_block        -> AFFE_CHAR_MECA's (supports; with prestress
#                         also the loads)
#   cyclic_loads_block -> cut faces fixed (cycl_if), relations ND 0 for the
#                         prestress (cycl_rel)
#   static_block       -> prestress: MECA_STATIQUE and SIEF_ELGA
#   assemblage_block   -> ASSEMBLAGE (K, M; with prestress K + Kg)
#   base_block         -> sector modes, DEFI_INTERF_DYNA, DEFI_BASE_MODALE
#   cycl_block         -> MODE_ITER_CYCL, REST_SOUS_STRUC, aster_cyclic
#   export_block       -> aster_results_export (one <mode> per mode)
#   impr_resu_block    -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# Symmetry axis X -> Z: MODE_ITER_CYCL needs the Z axis (U4.52.05
# par. 1). The mesh file is already in the computation frame (cyclic
# permutation of the axes = rotation -120.0 degrees about (1, 1, 1),
# bridge_cyclic._rewrite_mesh), and so are the loads
# (_permute_charges); aster_cyclic rotates mesh and shapes back.


# =====================================================
# 2. MODEL, SECTIONS, MATERIALS (as in MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Ring', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


#-- not used in this analysis --


# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7800.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Ring', MATER=MAT_1),
    ),
)


# =====================================================
# 3. BOUNDARY CONDITIONS AND CUT FACES
# =====================================================
#-- no boundary conditions or loads --


# Cyclic symmetry (bridge_cyclic): cut faces fixed for the
# sector basis (Craig-Bampton, U4.52.05; test case sdlv134a).
cycl_if = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=_F(
    GROUP_NO=('BRCYC_D', 'BRCYC_G',), DX=0.0, DY=0.0, DZ=0.0))


# =====================================================
# 4. PRESTRESS (STATIC, CYCLICALLY SYMMETRIC)
# =====================================================
#-- not applicable (no prestress) --


# =====================================================
# 5. MATRICES OF THE SECTOR WITH FIXED CUT FACES (ASSEMBLAGE)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CHARGE=(cycl_if,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


# =====================================================
# 6. BASIS OF THE SECTOR (CALC_MODES, DEFI_INTERF_DYNA, DEFI_BASE_MODALE)
# =====================================================
# Sector modes with fixed cut faces (basis for the cyclic
# substructuring)
modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=20),
    CHAM_MATER=fieldmat,
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
lint = DEFI_INTERF_DYNA(
    NUME_DDL=numedd,
    INTERFACE=(
        _F(NOM='DROITE', TYPE='CRAIGB', GROUP_NO='BRCYC_D'),
        _F(NOM='GAUCHE', TYPE='CRAIGB', GROUP_NO='BRCYC_G'),
    ),
)
# Basis: the sector modes plus the static modes of the cut faces
bamo = DEFI_BASE_MODALE(CLASSIQUE=_F(INTERF_DYNA=lint, MODE_MECA=modes, NMAX_MODE=20))


# =====================================================
# 7. CYCLIC MODES (MODE_ITER_CYCL, U4.52.05)
# =====================================================
modcyc = MODE_ITER_CYCL(
    BASE_MODALE=bamo,
    NB_MODE=20,
    NB_SECTEUR=12,
    LIAISON=_F(DROITE='DROITE', GAUCHE='GAUCHE'),
    CALCUL=_F(NB_DIAM=(0, 1, 2, 3, 4, 5, 6), NMAX_FREQ=2),
)
# Modes on sector 1 (field DEPL per mode)
modsec = REST_SOUS_STRUC(RESU_GENE=modcyc, SECTEUR=1, NOM_CHAM='DEPL')
# The whole wheel (setting cyclic_full_wheel): skeleton with the N
# sectors and the modes on it; otherwise only the sector.
try:
    squel = DEFI_SQUELETTE(CYCLIQUE=_F(MODE_CYCL=modcyc),
                           SECTEUR=_F(TOUT='OUI'))
    modwiel = REST_SOUS_STRUC(RESU_GENE=modcyc, SQUELETTE=squel,
                              NOM_CHAM='DEPL')
except Exception as exc:
    print('aster_cyclic: WAARSCHUWING: skelet van het hele wiel niet gemaakt: %r' % (exc,))
    squel = modwiel = None
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_cyclic
res = aster_cyclic.collect(modsec, mesh, numedd, 12, 2, [0, 1, 2, 3, 4, 5, 6], axis='X', angle=-120.0, wheel=modwiel, skeleton=squel, liml='<WORKDIR>\\CY-03\\CY-03.liml')


# =====================================================
# 8. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\CY-03\\CY-03_verif_results.xml', '<WORKDIR>\\CY-03\\CY-03.liml',
    fields=['displacements'], precision='double',
    cyclic={'axis': 0, 'segments': 12})


#-- no MED export (setting med_export off) --


FIN()
