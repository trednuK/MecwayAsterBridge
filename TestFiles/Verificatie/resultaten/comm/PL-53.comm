    95.16, 95.355, 95.55, 95.745, 95.94, 96.135, 96.33, 96.525,
    96.72, 96.915, 97.11, 97.305, 97.5,
))
temp0 = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MODELE=model,
    AFFE=(
        _F(TOUT='OUI', NOM_CMP='TEMP', VALE=-273.15),
        _F(GROUP_NO='Alle', NOM_CMP='TEMP', VALE=119.85),
    ),
)


# =====================================================
# 6. BOUNDARY CONDITIONS AND LOADS
# Each Mecway load gets its own load (EXCIT adds them up); prescribed
# temperatures together in the first load(s). All sources as a function
# (SOURCE in AFFE_CHAR_THER_F) together in one load, per part of the mesh the
# sum (Code-Aster 17.4 computes two such loads as the first;
# bridge_thermal._Thermal.add_func_source).
# =====================================================
load_1 = AFFE_CHAR_THER(
    MODELE=model,
    TEMP_IMPO=(
        _F(GROUP_MA='Oppervlak', TEMP=19.85),
    ),
)


# =====================================================
# 7. SOLVE
# =====================================================
res = THER_LINEAIRE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    EXCIT=(
        _F(CHARGE=load_1),
    ),
    TYPE_CALCUL='TRAN',
    ETAT_INIT=_F(CHAM_NO=temp0),
    SCHEMA_TEMPS=_F(SCHEMA='THETA', THETA=0.57),
    INCREMENT=_F(LIST_INST=times),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
# time for the post-processing and the export after the solve, once (bridge_failure.late_time)
_pe_late = False
try:
    import os as _pe_os
    from code_aster.Utilities import ExecutionParameter as _pe_xp
    _pe_el = _bt_time.time() - _bt_t0
    _pe_tp = float(_pe_xp().get_option('tpmax'))
    _pe_tp0 = float(_pe_os.environ.get('BRIDGE_TPMAX0') or _pe_tp)
    _pe_os.environ['BRIDGE_TPMAX0'] = repr(_pe_tp0)
    _pe_late = _pe_el > _pe_tp0
    _pe_new = max(_pe_tp0 + max(600.0, _pe_tp0),
                  _pe_el + max(600.0, _pe_tp0))
    if _pe_tp < _pe_new:
        _pe_xp().set_option('tpmax', _pe_new)
        if _pe_late:
            print('BRIDGE_TIJD_EXTRA %r' % (_pe_new - _pe_tp))
    if _pe_late:
        print('BRIDGE_TIJD_LAAT', 'THER_LINEAIRE', round(_pe_el, 1))
except Exception as _pe_err:
    if _pe_late:
        print('BRIDGE_TIJD_EXTRA_FOUT', repr(_pe_err))


# =====================================================
# 8. HEAT FLUX
# =====================================================
res_flux = CALC_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Cilinder',),
    THERMIQUE=('FLUX_ELGA',),
)
res_flux = CALC_CHAMP(
    reuse=res_flux,
    RESULTAT=res_flux,
    GROUP_MA=('Cilinder',),
    THERMIQUE=('FLUX_ELNO', 'FLUX_NOEU'),
)


# ---- BRIDGE_ADAPT_END ----

# =====================================================
# 9. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\PL-53\\PL-53_verif_results.xml', '<WORKDIR>\\PL-53\\PL-53.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    failures=globals().get('_bz_events'),
    precision='single', static=False, fields=['temperature', 'heat_flux'])


# =====================================================
