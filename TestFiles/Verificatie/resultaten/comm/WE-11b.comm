# =====================================================
# 6. BOUNDARY CONDITIONS AND LOADS
# Each Mecway load gets its own load (EXCIT adds them up); prescribed
# temperatures together in the first load(s). All sources as a function
# (SOURCE in AFFE_CHAR_THER_F) together in one load, per part of the mesh the
# sum (Code-Aster 17.4 computes two such loads as the first;
# bridge_thermal._Thermal.add_func_source).
# =====================================================
# --- Welding sources (#ASTER-LASBRON, bridge_welding.py) ---
# Moving welding source (bridge_welding.py): Goldak double ellipsoid along
# a path. P = (t0, v, L, points, cum. lengths, coordinate frames, qf, qr,
# af, ar, b, c, cut-off); q in W/m3.
def _lb_goldak(X, Y, Z, INST, P):
    t0, v, L, pts, cum, frames, qf, qr, af, ar, b, c, cut = P
    s = v * (INST - t0)
    # on in [t0, t_end], also at t_end itself (margin for rounding:
    # v (t_end - t0) was just above L in a test, S4c)
    if s < 0.0 or s > L * (1.0 + 1.0e-9):
        return 0.0
    k = 0
    while k < len(cum) - 2 and s > cum[k + 1]:
        k += 1
    e, w, n = frames[k]
    p = pts[k]
    d = s - cum[k]
    dx = X - (p[0] + d * e[0])
    dy = Y - (p[1] + d * e[1])
    dz = Z - (p[2] + d * e[2])
    if dx * dx + dy * dy + dz * dz > cut:
        return 0.0
    xi = dx * e[0] + dy * e[1] + dz * e[2]
    et = dx * w[0] + dy * w[1] + dz * w[2]
    ze = dx * n[0] + dy * n[1] + dz * n[2]
    if xi >= 0.0:
        return qf * _lb_exp(-3.0 * ((xi / af) ** 2 + (et / b) ** 2 +
                                    (ze / c) ** 2))
    return qr * _lb_exp(-3.0 * ((xi / ar) ** 2 + (et / b) ** 2 +
                                (ze / c) ** 2))
import math as _lb_math
_lb_exp = _lb_math.exp

# Birth of filler material (bridge_welding.py, S4c): 1 if the point
# (X, Y, Z) is already born at time INST: INST > tb = max(t0, t0 + (s -
# lead) / v), s = arc length of the nearest point of the path;
# never if tb lies after the end of the source. B = (t0, v, lead, t_end,
# points, cum. lengths).
def _lb_arc(X, Y, Z, pts, cum):
    # extended beyond the end of the path (s > L): the source does not get
    # there, so that material is never born (further than the lead)
    best, s_best = None, 0.0
    last = len(pts) - 2
    for k in range(len(pts) - 1):
        a, b = pts[k], pts[k + 1]
        ab = (b[0] - a[0], b[1] - a[1], b[2] - a[2])
        ll = ab[0] * ab[0] + ab[1] * ab[1] + ab[2] * ab[2]
        u = ur = 0.0
        if ll > 0.0:
            ur = ((X - a[0]) * ab[0] + (Y - a[1]) * ab[1] +
                  (Z - a[2]) * ab[2]) / ll
            u = min(1.0, max(0.0, ur))
        d = ((X - a[0] - u * ab[0]) ** 2 + (Y - a[1] - u * ab[1]) ** 2 +
             (Z - a[2] - u * ab[2]) ** 2)
        if best is None or d < best:
            if k == last and ur > 1.0:
                u = ur
            best, s_best = d, cum[k] + u * (cum[k + 1] - cum[k])
    return s_best
def _lb_tborn(X, Y, Z, B):
    t0, v, lead, tstop, pts, cum = B
    return max(t0, t0 + (_lb_arc(X, Y, Z, pts, cum) - lead) / v)
def _lb_born(X, Y, Z, INST, B):
    tb = _lb_tborn(X, Y, Z, B)
    if tb > B[3]:
        return 0.0
    if INST > tb:
        return 1.0
    # born at the start of the source (tb = t0): from t0 itself
    return 1.0 if (tb <= B[0] and INST >= B[0] - 1.0e-9) else 0.0

