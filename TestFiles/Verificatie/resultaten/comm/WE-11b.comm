    13: [('TH11', MTH1)],
    14: [('TH12', MTH1)],
    16: [('TH13', MTH1)],
    17: [('TH14', MTH1)],
    40: [('TH15', MTH1)],
    41: [('TH16', MTH1)],
    42: [('TH17', MTH1)],
    44: [('TH18', MTH1)],
    45: [('TH19', MTH1)],
    47: [('TH20', MTH1)],
    48: [('TH21', MTH1)],
    49: [('TH22', MTH1)],
    51: [('TH23', MTH1)],
    53: [('TH24', MTH1)],
    54: [('TH25', MTH1)],
    56: [('TH26', MTH1)],
    57: [('TH27', MTH1)],
}
_gb_t = list(times.getValues())
_gb_alive = []
_gb_start = 0
res = None
for _gb_k in sorted(_gb_born) + [len(_gb_t)]:
    _gb_stop = min(_gb_k - 1, len(_gb_t) - 1)
    if _gb_stop > _gb_start:
        _gb_cm = AFFE_MATERIAU(MAILLAGE=mesh, MODELE=model, AFFE=tuple(
            _gb_affe + [_F(GROUP_MA=_g, MATER=_m) for _g, _m in _gb_alive]))
        _gb_kw = dict(ETAT_INIT=_F(CHAM_NO=temp0)) if res is None else dict(
            reuse=res, RESULTAT=res, ETAT_INIT=_F(EVOL_THER=res))
        res = THER_NON_LINE(
            CHAM_MATER=_gb_cm,
            INCREMENT=_F(LIST_INST=times, INST_INIT=_gb_t[_gb_start], INST_FIN=_gb_t[_gb_stop]),
            MODELE=model,
            EXCIT=(
        _F(CHARGE=lasbron),
    ),
            TYPE_CALCUL='TRAN',
            SCHEMA_TEMPS=_F(SCHEMA='THETA', THETA=0.57),
            SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
            NEWTON=_F(REAC_ITER=1),
            CONVERGENCE=_F(RESI_GLOB_RELA=1.0e-06, ITER_GLOB_MAXI=20),
            **_gb_kw)
        _gb_start = _gb_stop
    if _gb_k < len(_gb_t):
        _gb_alive += _gb_born[_gb_k]
print('BRIDGE_GEBOORTE_THER %d' % len(_gb_alive))


# =====================================================
# 8. HEAT FLUX
# =====================================================
# Energy check welding source (bridge_welding._energy_block)
nu_lb = NUME_DDL(MODELE=model)
for _t in (0.18, 0.54, 0.9, 1.26, 1.62,):
    _ve = CALC_VECT_ELEM(OPTION='CHAR_THER', CHARGE=lasbron_1, INST=_t)
    _va = ASSE_VECTEUR(VECT_ELEM=_ve, NUME_DDL=nu_lb)
    print('BRIDGE_LASBRON %d %r %r %r' % (1, _t, float(sum(_va.getValues())), 250.0))
print('BRIDGE_GEBOORTE %d %d %r %r %d' % (1, 120, 0.0, 1.65, 0))
for _t in (4.18, 4.54, 4.9, 5.26, 5.62,):
    _ve = CALC_VECT_ELEM(OPTION='CHAR_THER', CHARGE=lasbron_2, INST=_t)
    _va = ASSE_VECTEUR(VECT_ELEM=_ve, NUME_DDL=nu_lb)
    print('BRIDGE_LASBRON %d %r %r %r' % (2, _t, float(sum(_va.getValues())), 250.0))
print('BRIDGE_GEBOORTE %d %d %r %r %d' % (2, 120, 4.0, 5.65, 0))
res_flux = CALC_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Plaat', 'LASNAAD_1', 'LASNAAD_2',),
    THERMIQUE=('FLUX_ELGA',),
)
res_flux = CALC_CHAMP(
    reuse=res_flux,
    RESULTAT=res_flux,
    GROUP_MA=('Plaat', 'LASNAAD_1', 'LASNAAD_2',),
    THERMIQUE=('FLUX_ELNO', 'FLUX_NOEU'),
)


