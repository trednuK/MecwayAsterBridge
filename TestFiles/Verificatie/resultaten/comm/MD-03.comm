# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for the response on a modal basis (Mecway Dynamic Response D30 with
# Mode superposition): eigenmodes (CALC_MODES), projection of mass,
# stiffness and loads onto the modes (PROJ_BASE), the modal equations
# in time (DYNA_VIBRA BASE_CALCUL='GENE') and back to the nodes
# (REST_GENE_PHYS). Filled in via str.format() from bridge_dyna_modal.py.
#
# Placeholders (name between single braces):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (beams, shells, springs, point masses)
#   materials_block   -> DEFI_MATERIAU per material (with RHO)
#   fieldmat_block    -> AFFE_MATERIAU assignment
#   load_funcs_block  -> DEFI_FONCTION per time-dependent component
#   loads_block       -> AFFE_CHAR_MECA(_F): supports and loads,
#                        plus the loads per time function (gload_*)
#   assemblage_block  -> ASSEMBLAGE: RIGI_MECA and MASS_MECA with the
#                        supports
#   calc_modes_block  -> modes = CALC_MODES(...) and the mode overview
#   projection_block  -> load vectors (CALC_VECT_ELEM, ASSE_VECTEUR)
#                        and PROJ_BASE
#   dyna_block        -> modal damping, time step, (static correction,)
#                        DYNA_VIBRA and REST_GENE_PHYS -> res
#   calc_champ_block  -> CALC_CHAMP (stresses) on res
#   export_block      -> aster_results_export (Mecway results per time step)
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# =====================================================
# 2. MODEL, SECTIONS, MATERIALS (as in MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Balk', PHENOMENE='MECANIQUE', MODELISATION='POU_D_E'),
        _F(GROUP_MA='BRMA1', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
    ),
)


cara = AFFE_CARA_ELEM(
    MODELE=model,
    POUTRE=_F(GROUP_MA='Balk',
           SECTION='RECTANGLE',
           CARA=('HY', 'HZ',),
           VALE=(0.02, 0.03,)),
    DISCRET=(
        _F(GROUP_MA='BRMA1', CARA='K_T_D_N', VALE=(0.0, 0.0, 0.0,)),
        _F(GROUP_MA='BRMA1', CARA='M_T_D_N', VALE=(10.0,)),
    ),
)


# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=1.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Balk', MATER=MAT_1),
    ),
)


