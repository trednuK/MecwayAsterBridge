load_2 = AFFE_CHAR_MECA_F(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Tip', FY=FN_Tip_FY),
)

gload_2_1 = AFFE_CHAR_MECA_F(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Tip', FY=bridge_f1),
)


# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21) AND EIGENMODES (CALC_MODES, U4.52.02)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    CHARGE=(load_1,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=3),
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    NORM_MODE=_F(NORME='MASS_GENE'),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
# Mode overview (frequency, effective mass) in the .mess
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.print_modes(modes, mass=masse)


# =====================================================
# 5. PROJECTION ONTO THE MODES (PROJ_BASE, U4.63.11)
# =====================================================
vel_1 = CALC_VECT_ELEM(OPTION='CHAR_MECA', CHARGE=gload_2_1, CHAM_MATER=fieldmat, CARA_ELEM=cara)
vec_1 = ASSE_VECTEUR(VECT_ELEM=vel_1, NUME_DDL=numedd)
PROJ_BASE(
    BASE=modes,
    STOCKAGE='DIAG',
    MATR_ASSE_GENE=(
        _F(MATRICE=CO('mgen'), MATR_ASSE=masse),
        _F(MATRICE=CO('kgen'), MATR_ASSE=rigidite),
    ),
    VECT_ASSE_GENE=(
        _F(VECTEUR=CO('fgen_1'), VECT_ASSE=vec_1, TYPE_VECT='FORC'),
    ),
)


# =====================================================
# 6. MODAL EQUATIONS IN TIME (DYNA_VIBRA GENE, U4.53.03) AND
#    BACK TO THE NODES (REST_GENE_PHYS, U4.63.31)
# =====================================================
# Modal damping: Mecway's Rayleigh damping C = alpha M + beta K is
# per mode xi_i = (alpha / w_i + beta w_i) / 2 (Mecway manual sec.
# 9.26), plus the setting modal_damping.
import math as _math
bridge_freqs = [float(_f) for _f in modes.getAccessParameters()['FREQ']]
bridge_alpha, bridge_beta, bridge_zeta = 3.54964786985977, 0.0, 0.0
bridge_xi = []
for _f in bridge_freqs:
    _w = 2.0 * _math.pi * _f
    if _w <= 0.0:
        # Rigid body motion or mechanism: Mecway does not allow it
        # either (manual sec. 6.4); bridge_run_aster reports the cause.
        print('BRIDGE_DYNA_MODAL_FOUT FREQ mode=%d f=%g' % (len(bridge_xi) + 1, _f))
        raise ValueError('mode superposition: mode met f <= 0')
    bridge_xi.append(0.5 * (bridge_alpha / _w + bridge_beta * _w) + bridge_zeta)
for _i, (_f, _x) in enumerate(zip(bridge_freqs, bridge_xi)):
    print('BRIDGE_DEMPING mode %d: %.6g Hz, xi = %.6g' % (_i + 1, _f, _x))
if max(bridge_xi) >= 1.0:
    # Mecway: xi < 1 for every mode (manual sec. 6.4, 9.26).
    print('BRIDGE_DYNA_MODAL_FOUT DEMPING mode=%d xi=%g' % (bridge_xi.index(max(bridge_xi)) + 1, max(bridge_xi)))
    raise ValueError('mode superposition: dempingsverhouding >= 1')

# Time step: 50 steps per period of the highest mode (NEWMARK,
# period error (w dt)^2 / 12), a whole number per output interval.
bridge_inc, bridge_nout = 0.005, 400
bridge_nsub = max(1, int(_math.ceil(bridge_inc * max(bridge_freqs) * 50)))
bridge_pas = bridge_inc / bridge_nsub
print('BRIDGE_DYNA_MODAL rekenstap %g s (%d per uitvoerinterval), %d stappen' % (bridge_pas, bridge_nsub, bridge_nsub * bridge_nout))

tran = DYNA_VIBRA(
    TYPE_CALCUL='TRAN',
    BASE_CALCUL='GENE',
    SCHEMA_TEMPS=_F(SCHEMA='NEWMARK'),
    MATR_MASS=mgen,
    MATR_RIGI=kgen,
    AMOR_MODAL=_F(AMOR_REDUIT=bridge_xi),
    INCREMENT=_F(PAS=bridge_pas, INST_FIN=bridge_inc * bridge_nout),
    ARCHIVAGE=_F(PAS_ARCH=bridge_nsub),
    EXCIT=(
        _F(VECT_ASSE_GENE=fgen_1, FONC_MULT=FN_Tip_FY),
    ),
)

res = REST_GENE_PHYS(
    RESU_GENE=tran,
    TOUT_INST='OUI',
    NOM_CHAM=('DEPL', 'VITE', 'ACCE',),
)


# =====================================================
# 7. STRESSES AND RESULTS TO MECWAY
# =====================================================
# Stresses on the physical response (linear in the displacements)
# Beams: extreme axial stress in the cross-section.
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    GROUP_MA=('Balk',),
    CONTRAINTE=('SIPM_ELNO', ),
)



# Results in Mecway's own format (bridge: result_route='liml')
aster_results_export.export_results(
    res, '<WORKDIR>\\MD-03\\MD-03_verif_results.xml', '<WORKDIR>\\MD-03\\MD-03.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf')
                       if k in globals()),
    precision='single', static=False, fields=['displacements', 'velocities', 'stresses', 'vonmises'])


#-- no MED export (setting med_export off) --


FIN()
