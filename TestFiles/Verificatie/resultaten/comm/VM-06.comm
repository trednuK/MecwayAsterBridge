# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for DYNA_NON_LINE (nonlinear dynamics, implicit HHT/NEWMARK
# or explicit DIFF_CENT/TCHAMWA; choice "schema" in CONFIG_BRIDGE).
# Filled in via Python str.format() from bridge_to_aster.py
# (_build_nonlin_static; same builder and placeholders as STAT_NON_LINE).
#
# Placeholders (see AsterTemplate_StatNonLine.comm for the shared ones):
#   listinst_block    -> outlist (output times from Mecway <timesteps>),
#                        listinst (implicit: DEFI_LIST_INST with automatic
#                        step cutting; explicit: per output interval equal
#                        steps below the estimated CFL limit, so that every
#                        output time is a computation step)
#                        and vite0 (initial velocity, CREA_CHAMP) if present
#   statnonline_block -> DEFI_CONTACT (if there is contact2) and the
#                        DYNA_NON_LINE call with SCHEMA_TEMPS, ETAT_INIT
#                        and ARCHIVAGE at the output times, or the failure loop
#                        (bridge_failure.build_solve_block)
#   postreleve_block  -> route 'tabel': POST_RELEVE_T over all
#                        archived time steps (TOUT_ORDRE), including
#                        velocity (VITE); route 'liml': aster_results_export
#
# NOTE braces: write a literal brace as { or }.

# Language of the messages of the job scripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. READ MESH
# FORMAT='ASTER': mesh directly from the .liml (bridge_mesh.py)
# UNITE=20 corresponds to 'F mail ... D 20' in study.export
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. CREATE STANDARD GROUPS (all elements / nodes)
# =====================================================
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

# =====================================================
# 2b. NODE GROUPS FOR BOUNDARY CONDITIONS (and mesh modifications)
# Generated by _build_defigroup_block(), same as MECA_STATIQUE.
# =====================================================
#-- not used in this analysis --

mesh = MODI_MAILLAGE(
    reuse=mesh,
    MAILLAGE=mesh,
    ORIE_PEAU=_F(GROUP_MA_PEAU=('EindX',)),
)


# =====================================================
# 3. MODEL DEFINITION
# For each elset the matching MODELISATION is chosen:
#   1D (line2)              -> POU_D_E   (Euler beam; SEG2 only)
#   2D linear (tri3/quad4)        -> DKT
#   2D quadratic (tri6/quad8)     -> COQUE_3D (after CREA_MAILLAGE MODI_MAILLE)
#   springs (1D, spring material) -> DIS_T
#   faces with pressure (on vol.) -> 3D (boundary elements)
#   loose nodes (POI1)            -> DIS_T / DIS_TR (see bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Without elsets, pressure faces and POI1 nodes TOUT='OUI',
# MODELISATION='3D' is used.
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Staaf', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='EindX', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


# =====================================================
# 3b. SECTION PROPERTIES (beams, shells, springs)
# =====================================================
#-- not used in this analysis --


# =====================================================
# 3c. PLASTIC HARDENING CURVES  (DEFI_FONCTION)
# For each material with a <plastic> block in Mecway a traction function
# is defined. Code-Aster TRACTION / VMIS_ISOT_TRAC (U4.43.01 par. 5.1.1):
#   - NOM_PARA='EPSI' : TOTAL strain
#   - NOM_RESU='SIGM' : stress
#   - The ordinate of the first point is the elastic limit; a point
#     with abscissa zero is NOT allowed. The first point is therefore
#     (sigma_y / E, sigma_y).
#
# The conversion from Mecway is done in bridge_to_aster.py
# (_to_aster_traction_curve), controlled by 'plastic_strain_definition'
# in CONFIG_BRIDGE: 'plastic' -> EPSI = eps_p + sigma/E,
# 'total' -> start point (0, 0) is dropped, 'auto' -> derived from the
# first point. Invalid curves stop the generation with an ERROR in
# bridge_log.txt.
# =====================================================
#-- no plastic curves in this model --


# =====================================================
# 4. MATERIAL DEFINITION
# DEFI_MATERIAU with ELAS (always) and TRACTION (only for plastic
# materials). RHO is always included for PESANTEUR compatibility.
# =====================================================
# material 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


# =====================================================
# 5. MATERIAL ASSIGNMENT
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Staaf', MATER=MAT_1),
    ),
)


# =====================================================
# 6a. TIME-DEPENDENT LOAD FUNCTIONS  (DEFI_FONCTION)
# For each <force> component with a time attribute a function of INST
# is defined. Extrapolation outside the defined time domain is
# constant on both sides.
# =====================================================
FN_EindX_FX = DEFI_FONCTION(
    NOM_PARA='INST',
    VALE=(0.0, 0.0,
          0.002, 300000000.0,
          0.004, -150000000.0,
          0.006, 250000000.0,
          0.008, -50000000.0,
          0.01, 0.0),
    PROL_DROITE='CONSTANT',
    PROL_GAUCHE='CONSTANT',
)


# =====================================================
# 6b. TIME DISCRETISATION AND INITIAL VELOCITY
# outlist: output times (Mecway <timesteps>); listinst: computation steps
# (see the header of this file); vite0: initial velocity.
# =====================================================
outlist = DEFI_LIST_REEL(
    VALE=(0.0001, 0.0002, 0.0003, 0.0004, 0.0005, 0.0006, 0.0007, 0.0008, 0.0009, 0.001, 0.0011, 0.0012, 0.0013, 0.0014, 0.0015, 0.0016, 0.0017, 0.0018, 0.0019, 0.002, 0.0021, 0.0022, 0.0023, 0.0024, 0.0025, 0.0026, 0.0027, 0.0028, 0.0029, 0.003, 0.0031, 0.0032, 0.0033, 0.0034, 0.0035, 0.0036, 0.0037, 0.0038, 0.0039, 0.004, 0.0041, 0.0042, 0.0043, 0.0044, 0.0045, 0.0046, 0.0047, 0.0048, 0.0049, 0.005, 0.0051, 0.0052, 0.0053, 0.0054, 0.0055, 0.0056, 0.0057, 0.0058, 0.0059, 0.006, 0.0061, 0.0062, 0.0063, 0.0064, 0.0065, 0.0066, 0.0067, 0.0068, 0.0069, 0.007, 0.0071, 0.0072, 0.0073, 0.0074, 0.0075, 0.0076, 0.0077, 0.0078, 0.0079, 0.008, 0.0081, 0.0082, 0.0083, 0.0084, 0.0085, 0.0086, 0.0087, 0.0088, 0.0089, 0.009, 0.0091, 0.0092, 0.0093, 0.0094, 0.0095, 0.0096, 0.0097, 0.0098, 0.0099, 0.01),
)

times = DEFI_LIST_REEL(
    DEBUT=0.0,
    INTERVALLE=(
        _F(JUSQU_A=0.0001, NOMBRE=1),
        _F(JUSQU_A=0.0002, NOMBRE=1),
        _F(JUSQU_A=0.0003, NOMBRE=1),
        _F(JUSQU_A=0.0004, NOMBRE=1),
        _F(JUSQU_A=0.0005, NOMBRE=1),
        _F(JUSQU_A=0.0006, NOMBRE=1),
        _F(JUSQU_A=0.0007, NOMBRE=1),
        _F(JUSQU_A=0.0008, NOMBRE=1),
        _F(JUSQU_A=0.0009, NOMBRE=1),
        _F(JUSQU_A=0.001, NOMBRE=1),
        _F(JUSQU_A=0.0011, NOMBRE=1),
        _F(JUSQU_A=0.0012, NOMBRE=1),
        _F(JUSQU_A=0.0013, NOMBRE=1),
        _F(JUSQU_A=0.0014, NOMBRE=1),
        _F(JUSQU_A=0.0015, NOMBRE=1),
        _F(JUSQU_A=0.0016, NOMBRE=1),
        _F(JUSQU_A=0.0017, NOMBRE=1),
        _F(JUSQU_A=0.0018, NOMBRE=1),
        _F(JUSQU_A=0.0019, NOMBRE=1),
        _F(JUSQU_A=0.002, NOMBRE=1),
        _F(JUSQU_A=0.0021, NOMBRE=1),
        _F(JUSQU_A=0.0022, NOMBRE=1),
        _F(JUSQU_A=0.0023, NOMBRE=1),
        _F(JUSQU_A=0.0024, NOMBRE=1),
        _F(JUSQU_A=0.0025, NOMBRE=1),
        _F(JUSQU_A=0.0026, NOMBRE=1),
        _F(JUSQU_A=0.0027, NOMBRE=1),
        _F(JUSQU_A=0.0028, NOMBRE=1),
        _F(JUSQU_A=0.0029, NOMBRE=1),
        _F(JUSQU_A=0.003, NOMBRE=1),
        _F(JUSQU_A=0.0031, NOMBRE=1),
        _F(JUSQU_A=0.0032, NOMBRE=1),
        _F(JUSQU_A=0.0033, NOMBRE=1),
        _F(JUSQU_A=0.0034, NOMBRE=1),
        _F(JUSQU_A=0.0035, NOMBRE=1),
        _F(JUSQU_A=0.0036, NOMBRE=1),
        _F(JUSQU_A=0.0037, NOMBRE=1),
        _F(JUSQU_A=0.0038, NOMBRE=1),
        _F(JUSQU_A=0.0039, NOMBRE=1),
        _F(JUSQU_A=0.004, NOMBRE=1),
        _F(JUSQU_A=0.0041, NOMBRE=1),
        _F(JUSQU_A=0.0042, NOMBRE=1),
        _F(JUSQU_A=0.0043, NOMBRE=1),
        _F(JUSQU_A=0.0044, NOMBRE=1),
        _F(JUSQU_A=0.0045, NOMBRE=1),
        _F(JUSQU_A=0.0046, NOMBRE=1),
        _F(JUSQU_A=0.0047, NOMBRE=1),
        _F(JUSQU_A=0.0048, NOMBRE=1),
        _F(JUSQU_A=0.0049, NOMBRE=1),
        _F(JUSQU_A=0.005, NOMBRE=1),
        _F(JUSQU_A=0.0051, NOMBRE=1),
        _F(JUSQU_A=0.0052, NOMBRE=1),
        _F(JUSQU_A=0.0053, NOMBRE=1),
        _F(JUSQU_A=0.0054, NOMBRE=1),
        _F(JUSQU_A=0.0055, NOMBRE=1),
        _F(JUSQU_A=0.0056, NOMBRE=1),
        _F(JUSQU_A=0.0057, NOMBRE=1),
        _F(JUSQU_A=0.0058, NOMBRE=1),
        _F(JUSQU_A=0.0059, NOMBRE=1),
        _F(JUSQU_A=0.006, NOMBRE=1),
        _F(JUSQU_A=0.0061, NOMBRE=1),
        _F(JUSQU_A=0.0062, NOMBRE=1),
        _F(JUSQU_A=0.0063, NOMBRE=1),
        _F(JUSQU_A=0.0064, NOMBRE=1),
        _F(JUSQU_A=0.0065, NOMBRE=1),
        _F(JUSQU_A=0.0066, NOMBRE=1),
        _F(JUSQU_A=0.0067, NOMBRE=1),
        _F(JUSQU_A=0.0068, NOMBRE=1),
        _F(JUSQU_A=0.0069, NOMBRE=1),
        _F(JUSQU_A=0.007, NOMBRE=1),
        _F(JUSQU_A=0.0071, NOMBRE=1),
        _F(JUSQU_A=0.0072, NOMBRE=1),
        _F(JUSQU_A=0.0073, NOMBRE=1),
        _F(JUSQU_A=0.0074, NOMBRE=1),
        _F(JUSQU_A=0.0075, NOMBRE=1),
        _F(JUSQU_A=0.0076, NOMBRE=1),
        _F(JUSQU_A=0.0077, NOMBRE=1),
        _F(JUSQU_A=0.0078, NOMBRE=1),
        _F(JUSQU_A=0.0079, NOMBRE=1),
        _F(JUSQU_A=0.008, NOMBRE=1),
        _F(JUSQU_A=0.0081, NOMBRE=1),
        _F(JUSQU_A=0.0082, NOMBRE=1),
        _F(JUSQU_A=0.0083, NOMBRE=1),
        _F(JUSQU_A=0.0084, NOMBRE=1),
        _F(JUSQU_A=0.0085, NOMBRE=1),
        _F(JUSQU_A=0.0086, NOMBRE=1),
        _F(JUSQU_A=0.0087, NOMBRE=1),
        _F(JUSQU_A=0.0088, NOMBRE=1),
        _F(JUSQU_A=0.0089, NOMBRE=1),
        _F(JUSQU_A=0.009, NOMBRE=1),
        _F(JUSQU_A=0.0091, NOMBRE=1),
        _F(JUSQU_A=0.0092, NOMBRE=1),
        _F(JUSQU_A=0.0093, NOMBRE=1),
        _F(JUSQU_A=0.0094, NOMBRE=1),
        _F(JUSQU_A=0.0095, NOMBRE=1),
        _F(JUSQU_A=0.0096, NOMBRE=1),
        _F(JUSQU_A=0.0097, NOMBRE=1),
        _F(JUSQU_A=0.0098, NOMBRE=1),
        _F(JUSQU_A=0.0099, NOMBRE=1),
        _F(JUSQU_A=0.01, NOMBRE=1),
    ),
)

listinst = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=times),
    ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE',
             SUBD_METHODE='MANUEL', SUBD_PAS=4,
             SUBD_NIVEAU=6),
)



# =====================================================
# 7. BOUNDARY CONDITIONS AND LOADS  (AFFE_CHAR_MECA / _F)
# load_1: boundary conditions (DDL_IMPO, LIAISON_*) and couplings; then one
# load per load case (FORCE_*, PRES_REP, PESANTEUR), because Code-Aster
# overwrites loads within one load instead of adding them. Components with
# a time history refer to the DEFI_FONCTION's from step 6a
# (AFFE_CHAR_MECA_F, or FONC_MULT in EXCIT for a moment on faces).
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO='SymX', DX=0.0),
        _F(GROUP_NO='SymY', DY=0.0),
        _F(GROUP_NO='SymZ', DZ=0.0),
    ),
)

load_2 = AFFE_CHAR_MECA_F(
    MODELE=model,
    FORCE_FACE=_F(GROUP_MA='EindX', FX=FN_EindX_FX),
)


# =====================================================
# 8. SOLVER: NONLINEAR DYNAMICS  (DYNA_NON_LINE)
# Implicit (HHT/NEWMARK): Newton-Raphson per time step; explicit
# (DIFF_CENT/TCHAMWA): diagonal mass, no iterations, STOP_CFL.
# Contact (DEFI_CONTACT, CONTINUE) and the initial velocity (ETAT_INIT VITE)
# are in this block if the model has them.
#
#   CARA_ELEM     - only if step 3b contains an AFFE_CARA_ELEM.
#   EXCIT         - all loads from step 7 (load_1, load_2, ...).
#   COMPORTEMENT  - per elset (and POI1 group): RELATION ('ELAS',
#                   'VMIS_ISOT_TRAC', 'VMIS_ISOT_LINE', 'VMIS_CINE_LINE',
#                   'CABLE' or for gaps 'DIS_CHOC') and DEFORMATION from
#                   CONFIG_BRIDGE ("deformation", default 'GROT_GDEP';
#                   per elset the form that Code-Aster accepts,
#                   bridge_to_aster._deformation_for). Without elsets:
#                   TOUT='OUI', 'ELAS'.
#   INCREMENT     - LIST_INST is linked to listinst (step 6b).
#   SOLVEUR       - MUMPS with NPREC from CONFIG_BRIDGE ("solver_nprec").
#   NEWTON        - REAC_ITER from CONFIG_BRIDGE ("newton_reac_iter",
#                   default 1 = tangent matrix every iteration).
#   CONVERGENCE   - RESI_GLOB_RELA and ITER_GLOB_MAXI from CONFIG_BRIDGE
#                   ("convergence_resi_rela", "newton_max_iter").
# =====================================================
try:
    res = DYNA_NON_LINE(
        MODELE=model,
        CHAM_MATER=fieldmat,
        EXCIT=(
            _F(CHARGE=load_1),
            _F(CHARGE=load_2),
        ),
        COMPORTEMENT=_F(GROUP_MA='Staaf', RELATION='ELAS', DEFORMATION='GREEN_LAGRANGE'),
        INCREMENT=_F(LIST_INST=listinst),
        SCHEMA_TEMPS=_F(SCHEMA='HHT', ALPHA=-0.1, FORMULATION='DEPLACEMENT'),
        ARCHIVAGE=_F(LIST_INST=outlist),
        SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
        NEWTON=_F(REAC_ITER=1),
        CONVERGENCE=_F(RESI_GLOB_RELA=1e-05, ITER_GLOB_MAXI=20),
    )
except Exception as err:
    _pe_id = str(getattr(err, 'id_message', '') or '')
    try:
        _pe_inst = list(res.getAccessParameters()['INST'])
    except Exception:
        _pe_inst = []
    if not _pe_id or not _pe_inst or not (
            _pe_id.startswith('MECANONLINE') or len(_pe_inst) > 1):
        raise
    print('BRIDGE_FOUT_ID', _pe_id)
    print('BRIDGE_ONVOLLEDIG', _pe_inst[-1])
t_res = res.getAccessParameters()['INST'][-1]


# =====================================================
# 9. COMPUTE POST-PROCESSING FIELDS  (CALC_CHAMP)
# Same fields as MECA_STATIQUE; if at least one material has a
# hardening curve, the following are added on the 3D elsets:
#   EPSP_NOEU  - plastic strain tensor
#   VARI_NOEU  - internal variables (V1 = eq. plastic strain)
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Stresses per element node for Mecway (result_route 'liml').
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CONTRAINTE=('SIGM_ELNO', ),
)
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CRITERES=('SIEQ_ELNO', ),
)

res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CONTRAINTE=('SIGM_NOEU', ),
    CRITERES=('SIEQ_NOEU', ),
)

# --- #ASTER-POST code from the user (Mecway custom input) ---
WH_ = DEFI_FONCTION(NOM_PARA='SIGM', INTERPOL='LOG', VALE=(100000000.0, 10000000.0, 150000000.0, 2000000.0, 250000000.0, 200000.0, 400000000.0, 10000.0))
MT_ = DEFI_MATERIAU(FATIGUE=_F(WOHLER=WH_))
DM_ = CALC_FATIGUE(TYPE_CALCUL='CUMUL_DOMMAGE', OPTION='DOMA_ELNO_SIGM', HISTOIRE=_F(RESULTAT=res, EQUI_GD='VMIS_SG'), DOMMAGE='WOHLER', MATER=MT_)
print('VERIF_CA_D', max(DM_.getValues()))
# --- end ---

# =====================================================
# FATIGUE (bridge: #ASTER-WOHLER, bridge_fatigue.py,
# docs/Vermoeiing.md): damage and life per node (Miner)
# =====================================================
import sys
sys.path.insert(0, r'<REPO>\Scripts')
import aster_fatigue
_bridge_vermoeiing = aster_fatigue.compute(
    res, r'<WORKDIR>\VM-06\VM-06.liml', r'<WORKDIR>\VM-06\VM-06_verif_vermoeiing.csv',
    [{'material': 'Staal', 'form': 'table', 'S': [100000000.0, 150000000.0, 250000000.0, 400000000.0], 'N': [10000000.0, 2000000.0, 200000.0, 10000.0], 'interpol': 'LOG', 'prol_gauche': 'EXCLU', 'prol_droite': 'LINEAIRE', 'correction': 'GEEN'}],
    {'stress': 'VMIS_SG', 'counting': 'RAINFLOW', 'repeats': 1.0, 'strain': 'PRIN', 'criterion': 'GEEN', 'loading': 'PERIODIQUE', 'projection': 'UN_AXE'},
    blocks=None, signal=None,
    shells=None)


# =====================================================
# 10. RESULT EXTRACTION
# All archived time steps: route 'liml' (default) via
# aster_results_export, route 'tabel' with POST_RELEVE_T TOUT_ORDRE='OUI'
# (the table has a column INST).
# =====================================================
#-- tables not needed (result_route='liml') --


# =====================================================
# 11. WRITE TABLES TO .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\VM-06\\VM-06_verif_results.xml', '<WORKDIR>\\VM-06\\VM-06.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    precision='single', node_fields=globals().get('_bridge_vermoeiing'))


# =====================================================
# 12. EXPORT TO MED FORMAT (ParaView / Salome), only with the
# setting "med_export" (bridge_to_aster._build_impr_resu_block;
# UNITE=80 -> 'F rmed ... R 80' in study.export). Mecway receives the
# results via the .liml or the tables, not via an export file.
# =====================================================
#-- no MED export (setting med_export off) --


FIN()
