# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for the harmonic pressure field (acoustics, analysis
# acoustic_harm_3d on a Mecway A30 model): PHENOMENE='ACOUSTIQUE',
# ASSEMBLAGE RIGI_ACOU/MASS_ACOU/AMOR_ACOU and DYNA_VIBRA
# TYPE_CALCUL='HARM' (route of test case ahlv100a). Filled in via
# str.format() from bridge_acoustic.py (build_acoustic_harm).
#
# Placeholders (name between single braces):
#   model_block       -> AFFE_MODELE (volumes and source faces 3D,
#                        absorbing faces 3D_ABSO)
#   materials_block   -> DEFI_MATERIAU FLUIDE per material (and per
#                        impedance)
#   fieldmat_block    -> AFFE_MATERIAU assignment
#   loads_block       -> AFFE_CHAR_ACOU VITE_FACE (source) / PRES_IMPO and
#                        #ASTER code
#   assemblage_block  -> ASSEMBLAGE matrices and load vectors
#   harm_block        -> frequency list and res = DYNA_VIBRA(...)
#   export_block      -> aster_acoustic_export (one <mode> per frequency,
#                        microphones)
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. MODEL AND MATERIALS (air/fluid, boundaries)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('Lucht', 'BRON_Zuiger',), PHENOMENE='ACOUSTIQUE', MODELISATION='3D'),
        _F(GROUP_MA=('ABSORBEREND_Einde',), PHENOMENE='ACOUSTIQUE', MODELISATION='3D_ABSO'),
    ),
)


# material 'Lucht'
MAC1 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.2, CELE_R=340.0))


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Lucht', MATER=MAC1),
        _F(GROUP_MA='BRON_Zuiger', MATER=MAC1),
        _F(GROUP_MA='ABSORBEREND_Einde', MATER=MAC1),
    ),
)


# =====================================================
# 3. SOURCES AND PRESCRIBED PRESSURE; faces without a condition are rigid walls
# =====================================================
# Source: normal velocity into the fluid (VITE_FACE VNOR)
ch_vite = AFFE_CHAR_ACOU(
    MODELE=model,
    VITE_FACE=(
        _F(GROUP_MA='BRON_Zuiger', VNOR=('RI', 0.001, 0.0)),  # BRON_-selectie BRON_Zuiger
    ),
)


# =====================================================
# 4. MATRICES AND LOAD VECTORS (ASSEMBLAGE, U4.61.21)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigi_c'), OPTION='RIGI_ACOU'),
        _F(MATRICE=CO('mass_c'), OPTION='MASS_ACOU'),
        _F(MATRICE=CO('amor_c'), OPTION='AMOR_ACOU'),
    ),
    VECT_ASSE=(
        _F(VECTEUR=CO('vec_v'), OPTION='CHAR_ACOU', CHARGE=ch_vite),
    ),
)


# =====================================================
# 5. HARMONIC RESPONSE (DYNA_VIBRA HARM, U4.53.03)
# =====================================================
freqs = DEFI_LIST_REEL(VALE=(100.0, 340.0, 680.0,))
res = DYNA_VIBRA(
    TYPE_CALCUL='HARM',
    BASE_CALCUL='PHYS',
    CHAM_MATER=fieldmat,
    MATR_MASS=mass_c,
    MATR_RIGI=rigi_c,
    MATR_AMOR=amor_c,
    LIST_FREQ=freqs,
    EXCIT=(
        _F(VECT_ASSE=vec_v, COEF_MULT=1.0, PUIS_PULS=1, PHAS_DEG=90.0),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)


# =====================================================
# 6. RESULTS TO MECWAY
# =====================================================
# Results in Mecway's own format (result_route 'liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_acoustic_export
aster_acoustic_export.export_harmonic(
    res, '<WORKDIR>\\AH-02b\\AH-02b_verif_results.xml', '<WORKDIR>\\AH-02b\\AH-02b.liml',
    microphones={},
    csv_path='<WORKDIR>\\AH-02b\\AH-02b_verif_microfoons.csv',
    language='nl')


#-- no MED export (setting med_export off) --


FIN()
