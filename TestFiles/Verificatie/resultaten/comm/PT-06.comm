# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for DYNA_NON_LINE (nonlinear dynamics, implicit HHT/NEWMARK
# or explicit DIFF_CENT/TCHAMWA; choice "schema" in CONFIG_BRIDGE).
# Filled in via Python str.format() from bridge_to_aster.py
# (_build_nonlin_static; same builder and placeholders as STAT_NON_LINE).
#
# Placeholders (see AsterTemplate_StatNonLine.comm for the shared ones):
#   listinst_block    -> outlist (output times from Mecway <timesteps>),
#                        listinst (implicit: DEFI_LIST_INST with automatic
#                        step cutting; explicit: per output interval equal
#                        steps below the estimated CFL limit, so that every
#                        output time is a computation step)
#                        and vite0 (initial velocity, CREA_CHAMP) if present
#   statnonline_block -> DEFI_CONTACT (if there is contact2) and the
#                        DYNA_NON_LINE call with SCHEMA_TEMPS, ETAT_INIT
#                        and ARCHIVAGE at the output times, or the failure loop
#                        (bridge_failure.build_solve_block)
#   postreleve_block  -> route 'tabel': POST_RELEVE_T over all
#                        archived time steps (TOUT_ORDRE), including
#                        velocity (VITE); route 'liml': aster_results_export
#
# NOTE braces: write a literal brace as { or }.

# Language of the messages of the job scripts (aster_*.py)
# and the setting vtu_export (aster_vtu)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
_bridge_os.environ['BRIDGE_VTU'] = '0'
DEBUT(LANG='EN')

# =====================================================
# 1. READ MESH
# FORMAT='ASTER': mesh directly from the .liml (bridge_mesh.py)
# UNITE=20 corresponds to 'F mail ... D 20' in study.export
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. CREATE STANDARD GROUPS (all elements / nodes)
# =====================================================
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

# =====================================================
# 2b. NODE GROUPS FOR BOUNDARY CONDITIONS (and mesh modifications)
# Generated by _build_defigroup_block(), same as MECA_STATIQUE.
# =====================================================
#-- not used in this analysis --


# =====================================================
# 3. MODEL DEFINITION
# For each elset the matching MODELISATION is chosen:
#   1D (line2)              -> POU_D_E   (Euler beam; SEG2 only)
#   2D linear (tri3/quad4)        -> DKT
#   2D quadratic (tri6/quad8)     -> COQUE_3D (after CREA_MAILLAGE MODI_MAILLE)
#   springs (1D, spring material) -> DIS_T
#   faces with pressure (on vol.) -> 3D (boundary elements)
#   loose nodes (POI1)            -> DIS_T / DIS_TR (see bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Without elsets, pressure faces and POI1 nodes TOUT='OUI',
# MODELISATION='3D' is used.
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Platen', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Bout', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Huls', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='BRPRET', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
    ),
)


# =====================================================
# 3b. SECTION PROPERTIES (beams, shells, springs)
# =====================================================
cara = AFFE_CARA_ELEM(
    MODELE=model,
    DISCRET=(
        _F(GROUP_MA='BRPRET',
           CARA='K_T_D_N',
           VALE=(0.0, 0.0, 0.0)),
        _F(GROUP_MA='BRPRET',
           CARA='M_T_D_N',
           VALE=(0.0,)),
    ),
)


# =====================================================
# 3c. PLASTIC HARDENING CURVES  (DEFI_FONCTION)
# For each material with a <plastic> block in Mecway a traction function
# is defined. Code-Aster TRACTION / VMIS_ISOT_TRAC (U4.43.01 par. 5.1.1):
#   - NOM_PARA='EPSI' : TOTAL strain
#   - NOM_RESU='SIGM' : stress
#   - The ordinate of the first point is the elastic limit; a point
#     with abscissa zero is NOT allowed. The first point is therefore
#     (sigma_y / E, sigma_y).
#
# The conversion from Mecway is done in bridge_to_aster.py
# (_to_aster_traction_curve), controlled by 'plastic_strain_definition'
# in CONFIG_BRIDGE: 'plastic' -> EPSI = eps_p + sigma/E,
# 'total' -> start point (0, 0) is dropped, 'auto' -> derived from the
# first point. Invalid curves stop the generation with an ERROR in
# bridge_log.txt.
# =====================================================
#-- no plastic curves in this model --


# =====================================================
# 4. MATERIAL DEFINITION
# DEFI_MATERIAU with ELAS (always) and TRACTION (only for plastic
# materials). RHO is always included for PESANTEUR compatibility.
# =====================================================
# material 'Plaat'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=200000000000000.0, NU=0.0, RHO=2000000.0),)
# material 'Kolom'
MAT_2 = DEFI_MATERIAU(ELAS=_F(E=200000000000.0, NU=0.0, RHO=7.85),)


# =====================================================
# 5. MATERIAL ASSIGNMENT
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Platen', MATER=MAT_1),
        _F(GROUP_MA='Bout', MATER=MAT_2),
        _F(GROUP_MA='Huls', MATER=MAT_2),
    ),
)


# =====================================================
# 6a. TIME-DEPENDENT LOAD FUNCTIONS  (DEFI_FONCTION)
# For each <force> component with a time attribute a function of INST
# is defined. Extrapolation outside the defined time domain is
# constant on both sides.
# =====================================================
#-- no time-dependent loads in this model --


# =====================================================
# 6b. TIME DISCRETISATION AND INITIAL VELOCITY
# outlist: output times (Mecway <timesteps>); listinst: computation steps
# (see the header of this file); vite0: initial velocity.
# =====================================================
