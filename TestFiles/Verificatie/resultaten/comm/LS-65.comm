        _F(NOEUD=('N574', 'N284',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N574', 'N284',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N574', 'N284',), DDL=('DRX', 'DRX',), COEF_MULT=(-1.0, 1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N575', 'N286', 'N286',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, -0.01,), COEF_IMPO=0.0),
        _F(NOEUD=('N575', 'N286', 'N286',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, 0.01,), COEF_IMPO=0.0),
        _F(NOEUD=('N575', 'N286',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N575', 'N286',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N575', 'N286',), DDL=('DRX', 'DRX',), COEF_MULT=(-1.0, 1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N576', 'N288', 'N288',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, -0.01,), COEF_IMPO=0.0),
        _F(NOEUD=('N576', 'N288', 'N288',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, 0.01,), COEF_IMPO=0.0),
        _F(NOEUD=('N576', 'N288',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N576', 'N288',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N576', 'N288',), DDL=('DRX', 'DRX',), COEF_MULT=(-1.0, 1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N577', 'N287', 'N287',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, -0.01,), COEF_IMPO=0.0),
        _F(NOEUD=('N577', 'N287', 'N287',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, 0.01,), COEF_IMPO=0.0),
        _F(NOEUD=('N577', 'N287',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N577', 'N287',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N577', 'N287',), DDL=('DRX', 'DRX',), COEF_MULT=(-1.0, 1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N578', 'N289', 'N289',), DDL=('DX', 'DX', 'DRY',), COEF_MULT=(1.0, -1.0, -0.01,), COEF_IMPO=0.0),
        _F(NOEUD=('N578', 'N289', 'N289',), DDL=('DY', 'DY', 'DRX',), COEF_MULT=(1.0, -1.0, 0.01,), COEF_IMPO=0.0),
        _F(NOEUD=('N578', 'N289',), DDL=('DZ', 'DZ',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N578', 'N289',), DDL=('DRY', 'DRY',), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        _F(NOEUD=('N578', 'N289',), DDL=('DRX', 'DRX',), COEF_MULT=(-1.0, 1.0,), COEF_IMPO=0.0),
    ),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Tip', FX=11.11111111111111),
)


# =====================================================
# 7. SOLVER: LINEAR STATIC
# MECA_STATIQUE solves Ku=F for linear elastic behaviour.
# CARA_ELEM=cara is included as soon as step 3b contains an AFFE_CARA_ELEM
# (beam, shell, spring sections or POI1 nodes); otherwise omitted.
# SOLVEUR (setting "lin_solver"): MUMPS (direct) with NPREC from
# "solver_nprec" (Code-Aster default 8) and RESI_RELA ("lin_solver_resi",
# default 1e-6) as the limit for the estimated error of the solution; or GCPC
# (iterative, PRE_COND='LDLT_INC') with RESI_RELA as residual criterion.
# INFO=2: solver statistics in the .mess (convergence monitor).
# =====================================================
res = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    EXCIT=(
        _F(CHARGE=load_1),
        _F(CHARGE=load_2),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8, RESI_RELA=1e-06, POSTTRAITEMENTS='FORCE'),
    INFO=2,
)

# =====================================================
# 8. COMPUTE POST-PROCESSING FIELDS  (CALC_CHAMP)
# Generated by bridge_to_aster.py based on element types.
#
# REAC_NODA:
#   Separate call without GROUP_MA (all nodes); with elastic support
#   without the springs (BRES*), so that the spring force is the reaction.
#
# SIGM_NOEU / SIEQ_NOEU:
#   Only on the 3D elsets (GROUP_MA). Shell stresses have
#   sub-points (layers) and do not fit in a NOEU field. Without
#   3D elsets (also with AFFE_MODELE TOUT='OUI') this call is dropped.
#
# Shells (DKT / COQUE_3D):
#   SIGM_ELNO -> POST_CHAMP EXTR_COQUE ('SUP', 'MOY' and 'INF')
#   -> SIEQ_ELNO -> SIEQ_NOEU in res_sup / res_moy / res_inf.
#
# Beams (POU_D_E, cross-section RECTANGLE or CERCLE):
#   SIPM_ELNO = SIXXMIN / SIXXMAX in the cross-section.
#
# Error estimator (setting error_estimator, volume elements only):
#   separate model, load and result res_err, then CALC_ERREUR ERME_ELEM /
#   ERME_ELNO / ERME_NOEU; see _error_estimator_block() and
#   docs/Foutschatter.md.
#
# See _build_calc_champ_block() in bridge_to_aster.py.
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Shells: stresses per layer (sub-points) -> extract top, middle
# and bottom surface separately (POST_CHAMP EXTR_COQUE).
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    CONTRAINTE=('SIGM_ELNO', ),
)

res_sup = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='SUP',
    ),
)
res_sup = CALC_CHAMP(reuse=res_sup, RESULTAT=res_sup, GROUP_MA=('Plaat',), CRITERES=('SIEQ_ELNO', ))
res_sup = CALC_CHAMP(reuse=res_sup, RESULTAT=res_sup, GROUP_MA=('Plaat',), CRITERES=('SIEQ_NOEU', ))

res_moy = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='MOY',
    ),
)
res_moy = CALC_CHAMP(reuse=res_moy, RESULTAT=res_moy, GROUP_MA=('Plaat',), CRITERES=('SIEQ_ELNO', ))
res_moy = CALC_CHAMP(reuse=res_moy, RESULTAT=res_moy, GROUP_MA=('Plaat',), CRITERES=('SIEQ_NOEU', ))

res_inf = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='INF',
    ),
)
res_inf = CALC_CHAMP(reuse=res_inf, RESULTAT=res_inf, GROUP_MA=('Plaat',), CRITERES=('SIEQ_ELNO', ))
res_inf = CALC_CHAMP(reuse=res_inf, RESULTAT=res_inf, GROUP_MA=('Plaat',), CRITERES=('SIEQ_NOEU', ))

# Total strain (result field strain).
res = CALC_CHAMP(reuse=res, RESULTAT=res, GROUP_MA=('Plaat',), DEFORMATION=('EPSI_ELNO', ))
eps_sup = POST_CHAMP(RESULTAT=res, GROUP_MA=('Plaat',), EXTR_COQUE=_F(NOM_CHAM=('EPSI_ELNO', ), NUME_COUCHE=1, NIVE_COUCHE='SUP'))
eps_moy = POST_CHAMP(RESULTAT=res, GROUP_MA=('Plaat',), EXTR_COQUE=_F(NOM_CHAM=('EPSI_ELNO', ), NUME_COUCHE=1, NIVE_COUCHE='MOY'))
eps_inf = POST_CHAMP(RESULTAT=res, GROUP_MA=('Plaat',), EXTR_COQUE=_F(NOM_CHAM=('EPSI_ELNO', ), NUME_COUCHE=1, NIVE_COUCHE='INF'))

# Forces and moments per length of shells (result field shell_forces).
res_efs = CALC_CHAMP(RESULTAT=res, GROUP_MA=('Plaat',), CONTRAINTE=('EFGE_ELNO', ))



# =====================================================
# 9. RESULT EXTRACTION TO TABLES  (POST_RELEVE_T)
# Generated by bridge_to_aster.py based on element types.
# Displacements and reaction forces are always extracted.
# tab_sigm / tab_vmis : 3D elsets
# tab_vmss / tab_vmsm / tab_vmsi : shells, von Mises top/middle/bottom
# tab_sipm            : beams (RECTANGLE / CERCLE), SIXXMIN / SIXXMAX
# INTITULE is at most 16 characters (Code-Aster truncates longer ones).
#
# Separate tables per field so that INTITULE (parts[0] in the parser)
# uniquely identifies the field in AsterToMecway_results()
# in bridge_from_aster.py.
# =====================================================
#-- tables not needed (result_route='liml') --


# =====================================================
# 10. WRITE TABLES TO .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# Only the tables created in step 9 are written.
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\LS-65\\LS-65_verif_results.xml', '<WORKDIR>\\LS-65\\LS-65.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    precision='double', opt_in=['shell_stresses', 'shell_forces', 'strain', 'safety_factor'], strengths={'Plaat': 250000000.0})


# =====================================================
# 11. EXPORT TO MED FORMAT (ParaView / Salome), only with the
# setting "med_export" (bridge_to_aster._build_impr_resu_block;
# UNITE=80 -> 'F rmed ... R 80' in study.export). Mecway receives the
# results via the .liml or the tables, not via an export file.
# =====================================================
#-- no MED export (setting med_export off) --


FIN()
