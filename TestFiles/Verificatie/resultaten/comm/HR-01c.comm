# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for the harmonic response of a structure in the
# frequency domain (analysis harmonic_3d; Mecway has no analysis
# type for it): eigenmodes (CALC_MODES), the frequency list with extra
# points around the resonances (DEFI_LIST_FREQ), the harmonic response on a
# modal basis (PROJ_BASE, DYNA_VIBRA TYPE_CALCUL='HARM' BASE_CALCUL='GENE',
# REST_GENE_PHYS) or directly (BASE_CALCUL='PHYS'), complex stresses
# (CALC_CHAMP) and per frequency amplitude and phase to Mecway. Filled in
# via str.format() from bridge_harmonic.py.
#
# Placeholders (name between single braces):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (beams, shells, springs, point masses)
#   materials_block   -> DEFI_MATERIAU per material (with RHO)
#   fieldmat_block    -> AFFE_MATERIAU assignment
#   load_funcs_block  -> DEFI_FONCTION per Mecway table (function of FREQ)
#   loads_block       -> AFFE_CHAR_MECA(_F): supports and loads
#   assemblage_block  -> ASSEMBLAGE: RIGI_MECA, MASS_MECA (and AMOR_MECA of
#                        dampers) with the supports
#   calc_modes_block  -> modes = CALC_MODES(...) and the mode overview
#   projection_block  -> load vectors (CALC_VECT_ELEM, ASSE_VECTEUR),
#                        PROJ_BASE (GENE) or the damping matrix (PHYS)
#   harm_block        -> modal damping, frequency list, DYNA_VIBRA HARM
#                        (and REST_GENE_PHYS) -> res
#   calc_champ_block  -> CALC_CHAMP SIGM_NOEU (complex) on res
#   export_block      -> aster_harmonic_export (Mecway results per
#                        frequency, measuring points)
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# A brace that is not a placeholder: double it ({ or }).

# Language of the messages of the job scripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# =====================================================
# 2. MODEL, SECTIONS, MATERIALS (as in MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Veer', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
        _F(GROUP_MA='BRMA1', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
    ),
)


cara = AFFE_CARA_ELEM(
    MODELE=model,
    DISCRET=(
        _F(GROUP_MA='Veer',
           CARA='K_T_D_L', REPERE='LOCAL',
           VALE=(1000.0, 0.0, 0.0)),
        _F(GROUP_MA='Veer',
           CARA='M_T_D_L',
           VALE=(0.0,)),
        _F(GROUP_MA='BRMA1', CARA='K_T_D_N', VALE=(0.0, 0.0, 0.0,)),
        _F(GROUP_MA='BRMA1', CARA='M_T_D_N', VALE=(2.0,)),
    ),
)




MAT_BRLEEG = DEFI_MATERIAU(ELAS=_F(E=1.0, NU=0.0),)
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(TOUT='OUI', MATER=MAT_BRLEEG),
    ),
)


# =====================================================
# 3. LOADS (amplitude; tables as a function of frequency)
# =====================================================
#-- no tables (amplitude constant over the frequency) --


bridge_f0 = DEFI_CONSTANTE(VALE=0.0)
bridge_f1 = DEFI_CONSTANTE(VALE=1.0)
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO='Grond', DX=0.0, DY=0.0, DZ=0.0),
        _F(GROUP_NO='Massa', DY=0.0, SANS_GROUP_NO=('Grond',)),
        _F(GROUP_NO='Massa', DZ=0.0, SANS_GROUP_NO=('Grond',)),
    ),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Last', FX=10.0),
)



# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21) AND EIGENMODES (CALC_MODES, U4.52.02)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    CHARGE=(load_1,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=1),
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    NORM_MODE=_F(NORME='MASS_GENE'),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
# Mode overview (frequency, effective mass) in the .mess
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.print_modes(modes, mass=masse)


# =====================================================
# 5. LOAD VECTORS AND PROJECTION ONTO THE MODES (PROJ_BASE, U4.63.11)
# =====================================================
vel_1 = CALC_VECT_ELEM(OPTION='CHAR_MECA', CHARGE=load_2, CHAM_MATER=fieldmat, CARA_ELEM=cara)
vec_1 = ASSE_VECTEUR(VECT_ELEM=vel_1, NUME_DDL=numedd)
# Damping matrix of the direct computation: C = alpha M + beta K (Mecway
# manual par. 9.26) + dampers (AMOR_MECA)
amor = COMB_MATR_ASSE(COMB_R=(
    _F(MATR_ASSE=masse, COEF_R=2.23606797749979),
))


# =====================================================
# 6. HARMONIC RESPONSE (DYNA_VIBRA HARM, U4.53.03) AND BACK TO THE
#    NODES (REST_GENE_PHYS, U4.63.31)
# =====================================================
# Modal damping: Mecway's Rayleigh damping C = alpha M + beta K is
# per mode xi_i = alpha / (2 w_i) + beta w_i / 2 (Mecway manual par.
# 9.26), plus the setting modal_damping (GENE only).
import math as _math
bridge_freqs = [float(_f) for _f in modes.getAccessParameters()['FREQ']]
bridge_alpha, bridge_beta, bridge_zeta = 2.23606797749979, 0.0, 0.0
bridge_xi = []
for _f in bridge_freqs:
    _w = 2.0 * _math.pi * _f
    if _w <= 0.0:
        # Rigid motion or mechanism (bridge_run_aster reports the
        # cause, as for the response on a modal basis).
        print('BRIDGE_DYNA_MODAL_FOUT FREQ mode=%d f=%g' % (len(bridge_xi) + 1, _f))
        raise ValueError('harmonisch: mode met f <= 0')
    bridge_xi.append(0.5 * (bridge_alpha / _w + bridge_beta * _w) + bridge_zeta)
for _i, (_f, _x) in enumerate(zip(bridge_freqs, bridge_xi)):
    print('BRIDGE_DEMPING mode %d: %.6g Hz, xi = %.6g' % (_i + 1, _f, _x))
if bridge_xi and max(bridge_xi) >= 1.0:
    # Overcritically damped mode: no resonance peak. Unlike the
    # response on a modal basis in time, the job does not stop;
    # bridge_harmonic.report_harmonic reports it as a WARNING.
    print('BRIDGE_HARM_WAARSCHUWING DEMPING MODE=%d XI=%.6g N=%d' % (bridge_xi.index(max(bridge_xi)) + 1, max(bridge_xi), len([_x for _x in bridge_xi if _x >= 1.0])))

# Frequencies: the range (lin/log) with 5 points per mode over the
# half-power bandwidth 2 xi f around the peak f sqrt(1 - 2 xi^2)
# (DEFI_LIST_FREQ RAFFINEMENT CRITERE='LARGEUR_3DB', test case
# sdld21b), or exactly the list harm_freq_list.
bridge_f0, bridge_f1, bridge_n = 0.5, 7.0, 27
bridge_base = [bridge_f0 + (bridge_f1 - bridge_f0) * _k / float(max(1, bridge_n - 1)) for _k in range(bridge_n)]
bridge_refine = [(_f, _x) for _f, _x in zip(bridge_freqs, bridge_xi)
                 if bridge_f0 <= _f <= bridge_f1 and 0.0 < _x < 0.5]
bridge_base = sorted(set(bridge_base))
if bridge_refine:
    bridge_lf = DEFI_LIST_FREQ(
        VALE=bridge_base,
        RAFFINEMENT=_F(LIST_RAFFINE=[_f for _f, _x in bridge_refine],
                       CRITERE='LARGEUR_3DB', NB_POINTS=5,
                       AMOR_REDUIT=[_x for _f, _x in bridge_refine]),
    )
else:
    bridge_lf = DEFI_LIST_REEL(VALE=bridge_base)
bridge_list = list(bridge_lf.getValues())
print('BRIDGE_HARM_LIJST N=%d FMIN=%.10g FMAX=%.10g VERFIJND=%d BASIS=PHYS' % (len(bridge_list), min(bridge_list), max(bridge_list), len(bridge_refine)))
if max(bridge_list) > max(bridge_freqs):
    # Modal truncation: above the top mode of the basis the response
    # no longer follows the load (docs/Respons_op_modale_basis.md).
    print('BRIDGE_HARM_WAARSCHUWING BASIS FMAX=%.10g FMODE=%.10g' % (max(bridge_list), max(bridge_freqs)))

res = DYNA_VIBRA(
    TYPE_CALCUL='HARM',
    BASE_CALCUL='PHYS',
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    MATR_MASS=masse,
    MATR_RIGI=rigidite,
    MATR_AMOR=amor,
    LIST_FREQ=bridge_lf,
    NOM_CHAM=('DEPL',),
    EXCIT=(
        _F(VECT_ASSE=vec_1, COEF_MULT=1.0, PHAS_DEG=0.0),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)


# =====================================================
# 7. STRESSES AND RESULTS TO MECWAY
# =====================================================
#-- no stresses requested (fields) --


# Results in Mecway's own format (result_route 'liml'): one
# <mode frequency> per frequency (aster_harmonic_export)
import aster_harmonic_export
aster_harmonic_export.export_harmonic(
    res, '<WORKDIR>\\HR-01c\\HR-01c_verif_results.xml', '<WORKDIR>\\HR-01c\\HR-01c.liml',
    fields=['displacements', 'accelerations'],
    probes={'MEETPUNT_Massa': [2]},
    csv_path='<WORKDIR>\\HR-01c\\HR-01c_verif_meetpunten.csv',
    language='nl',
    basis='PHYS')


#-- no MED export (setting med_export off) --


FIN()
