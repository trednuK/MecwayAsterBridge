# Code_Aster Command File - Generated by MecwayAsterBridge
# Template for MECA_STATIQUE (linear static analysis).
# Compatible with Code-Aster v16 and v17.
# Filled in via Python str.format() from bridge_to_aster.py
# (_build_lin_static).
#
# Placeholders (filled in by bridge_to_aster.py via str.format).
# In this source file they appear as a name between single braces; in the
# generated study.comm they are replaced by the actual Code-Aster code:
#
#   defigroup_block   -> DEFI_GROUP (coupling slaves, node groups per
#                        direction, groups for tables), possibly CREA_MAILLAGE
#                        and MODI_MAILLAGE ORIE_PEAU (or a comment)
#   model_block       -> AFFE_MODELE per elset (POU_D_E / DKT / COQUE_3D /
#                        3D / DIS_T / DIS_TR)
#   cara_elem_block   -> AFFE_CARA_ELEM beam, shell, spring and POI1
#                        properties (or a comment)
#   materials_block   -> DEFI_MATERIAU per material (incl. RHO)
#   fieldmat_block    -> AFFE_MATERIAU assignment
#   loads_block       -> AFFE_CHAR_MECA's: load_1 with boundary conditions and
#                        couplings, then one per load
#   excit_clause      -> EXCIT with all loads
#   cara_elem_ref     -> "    CARA_ELEM=cara,\n" or "" in MECA_STATIQUE
#   solveur_ref       -> "    SOLVEUR=_F(METHODE=.., ..),\n    INFO=2,\n"
#   calc_champ_block  -> CALC_CHAMP (+ POST_CHAMP for shells), fields
#                        depending on element types
#   postreleve_block  -> POST_RELEVE_T tables
#   impr_table_block  -> IMPR_TABLE calls
#   impr_resu_block   -> IMPR_RESU MED (only with "med_export")
#
# NOTE braces in this source file:
#   Code-Aster .comm syntax uses NO braces, so normally nothing
#   needs to be escaped. If you ever add a brace that is
#   NOT a placeholder, double it ({ or }) so that str.format()
#   does not raise a KeyError on it.

# Language of the messages of the job scripts (aster_*.py)
# and the setting vtu_export (aster_vtu)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
_bridge_os.environ['BRIDGE_VTU'] = '0'
DEBUT(LANG='EN')

# =====================================================
# 1. READ MESH
# FORMAT='ASTER': mesh directly from the .liml (bridge_mesh.py)
# UNITE=20 corresponds to 'F mail ... D 20' in study.export
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. CREATE STANDARD GROUPS (all elements / nodes)
# 'all_nodes' (derived from 'all_elems') is used by POST_RELEVE_T
# to export all nodes to the .resu file.
# DEFI_GROUP must come AFTER LIRE_MAILLAGE and BEFORE AFFE_MODELE.
# =====================================================
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

# =====================================================
# 2b. NODE GROUPS FOR BOUNDARY CONDITIONS (and mesh modifications)
# Generated by _build_defigroup_block() in bridge_to_aster.py:
#   - CREA_GROUP_NO per coupling slave on a faceselection
#     (GROUP_MA=face group) and for beam tables; the Mecway selections
#     themselves are already groups in the mesh (bridge_mesh.py)
#   - CREA_MAILLAGE MODI_MAILLE (QUAD8_9 / TRIA6_7) for COQUE_3D
#   - MODI_MAILLAGE ORIE_PEAU for pressure faces on volume elements
# Multiple entries are written as a tuple: CREA_GROUP_NO=(_F(...), _F(...),)
# If none of this applies, this section contains:
#   #-- not used in this analysis --
# =====================================================
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_NO=(
        _F(NOM='BRFR1', NOEUD=('N357',)),
        _F(NOM='BRFR2', NOEUD=('N359',)),
        _F(NOM='BRFR3', NOEUD=('N358',)),
        _F(NOM='BRFR4', NOEUD=('N362',)),
        _F(NOM='BRFR5', NOEUD=('N361',)),
        _F(NOM='BRFR6', NOEUD=('N365',)),
        _F(NOM='BRFR7', NOEUD=('N364',)),
        _F(NOM='BRFR8', NOEUD=('N368',)),
        _F(NOM='BRFR9', NOEUD=('N367',)),
        _F(NOM='BRFR10', NOEUD=('N371',)),
        _F(NOM='BRFR11', NOEUD=('N370',)),
        _F(NOM='BRFR12', NOEUD=('N374',)),
        _F(NOM='BRFR13', NOEUD=('N373',)),
        _F(NOM='BRFR14', NOEUD=('N377',)),
        _F(NOM='BRFR15', NOEUD=('N376',)),
        _F(NOM='BRFR16', NOEUD=('N380',)),
        _F(NOM='BRFR17', NOEUD=('N379',)),
        _F(NOM='BRFR18', NOEUD=('N503',)),
        _F(NOM='BRFR19', NOEUD=('N502',)),
        _F(NOM='BRFR20', NOEUD=('N506',)),
        _F(NOM='BRFR21', NOEUD=('N505',)),
        _F(NOM='BRFR22', NOEUD=('N509',)),
        _F(NOM='BRFR23', NOEUD=('N508',)),
        _F(NOM='BRFR24', NOEUD=('N512',)),
        _F(NOM='BRFR25', NOEUD=('N511',)),
        _F(NOM='BRFR26', NOEUD=('N515',)),
        _F(NOM='BRFR27', NOEUD=('N514',)),
        _F(NOM='BRFR28', NOEUD=('N518',)),
        _F(NOM='BRFR29', NOEUD=('N517',)),
        _F(NOM='BRFR30', NOEUD=('N521',)),
        _F(NOM='BRFR31', NOEUD=('N520',)),
        _F(NOM='BRFR32', NOEUD=('N524',)),
        _F(NOM='BRFR33', NOEUD=('N523',)),
        _F(NOM='BRFR34', NOEUD=('N647',)),
        _F(NOM='BRFR35', NOEUD=('N646',)),
        _F(NOM='BRFR36', NOEUD=('N650',)),
        _F(NOM='BRFR37', NOEUD=('N649',)),
        _F(NOM='BRFR38', NOEUD=('N653',)),
        _F(NOM='BRFR39', NOEUD=('N652',)),
        _F(NOM='BRFR40', NOEUD=('N656',)),
        _F(NOM='BRFR41', NOEUD=('N655',)),
        _F(NOM='BRFR42', NOEUD=('N659',)),
        _F(NOM='BRFR43', NOEUD=('N658',)),
        _F(NOM='BRFR44', NOEUD=('N662',)),
        _F(NOM='BRFR45', NOEUD=('N661',)),
        _F(NOM='BRFR46', NOEUD=('N665',)),
        _F(NOM='BRFR47', NOEUD=('N664',)),
        _F(NOM='BRFR48', NOEUD=('N668',)),
        _F(NOM='BRFR49', NOEUD=('N667',)),
        _F(NOM='BRFR50', NOEUD=('N781',)),
        _F(NOM='BRFR51', NOEUD=('N780',)),
        _F(NOM='BRFR52', NOEUD=('N784',)),
        _F(NOM='BRFR53', NOEUD=('N783',)),
        _F(NOM='BRFR54', NOEUD=('N787',)),
        _F(NOM='BRFR55', NOEUD=('N786',)),
        _F(NOM='BRFR56', NOEUD=('N790',)),
        _F(NOM='BRFR57', NOEUD=('N789',)),
        _F(NOM='BRFR58', NOEUD=('N793',)),
        _F(NOM='BRFR59', NOEUD=('N792',)),
        _F(NOM='BRFR60', NOEUD=('N796',)),
        _F(NOM='BRFR61', NOEUD=('N795',)),
        _F(NOM='BRFR62', NOEUD=('N799',)),
        _F(NOM='BRFR63', NOEUD=('N798',)),
        _F(NOM='BRFR64', NOEUD=('N801',)),
    ),
)

mesh = CREA_MAILLAGE(
    MAILLAGE=mesh,
    MODI_MAILLE=(
        _F(GROUP_MA='Plaat', OPTION='QUAD8_9'),
    ),
)


# =====================================================
# 3. MODEL DEFINITION
# Generated by bridge_to_aster.py based on elset dimensions.
# For each elset the matching MODELISATION is chosen:
#   1D (line2)              -> POU_D_E   (Euler beam; SEG2 only)
#   2D linear (tri3/quad4)        -> DKT
#   2D quadratic (tri6/quad8)     -> COQUE_3D (after CREA_MAILLAGE MODI_MAILLE)
#   springs (1D, spring material) -> DIS_T
#   faces with pressure (on vol.) -> 3D (boundary elements)
#   loose nodes (POI1)            -> DIS_T / DIS_TR (see bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Without elsets, pressure faces and POI1 nodes TOUT='OUI',
# MODELISATION='3D' is used.
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Plaat', PHENOMENE='MECANIQUE', MODELISATION='COQUE_3D'),
    ),
)


# =====================================================
# 3b. SECTION PROPERTIES (beams, shells, springs)
# Generated by bridge_to_aster.py based on Mecway <geometric> data.
#
# POUTRE: beam cross-sections (CERCLE, RECTANGLE, ...) per GROUP_MA
#   Example: _F(GROUP_MA='Beam1', SECTION='CERCLE', CARA=('R',), VALE=(0.005,))
#   Beam orientation: every beam gets Mecway's V axis as
#   ORIENTATION CARA='VECT_Y' (model_data["beam_vect_y"]): own orientation
#   (element properties or Element orientation card) or Mecway's default.
#
# COQUE: plate/shell thicknesses per GROUP_MA
#   Example: _F(GROUP_MA='Plate1', EPAIS=0.001)
#
# DISCRET: spring elements (DIS_T with K_T_D_L stiffness matrix) and
#          loose nodes (POI1, K_T_D_N / K_TR_D_N with stiffness 0),
#          each with a separate mass entry 0 (M_T_D_L / M_T_D_N / M_TR_D_N)
#   Example: _F(GROUP_MA='Spring1', CARA='K_T_D_L', VALE=(4231.0, 0.0, 0.0))
#
# Without beam, shell or spring sections and without POI1 nodes this contains:
#   #-- not used in this analysis --
# =====================================================
cara = AFFE_CARA_ELEM(
    MODELE=model,
    COQUE=_F(GROUP_MA='Plaat', EPAIS=0.001),
)


# =====================================================
# 4. MATERIAL DEFINITION
# Generated by bridge_to_aster.py based on Mecway materials.
# All values in SI units (Pa, kg/m3, dimensionless).
# RHO is always included (default 0.0) for compatibility with
# PESANTEUR.
# Concept names MAT_1, MAT_2, ... with the Mecway name as a comment above.
# Example: MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)
# =====================================================
# material 'Plaat1'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


# =====================================================
# 5. MATERIAL ASSIGNMENT
# Assigns materials to element sets (GROUP_MA) or, if there are
# no elsets, the first material to all elements (TOUT='OUI').
# DISCRET elsets (springs) are skipped; their properties are
# only in AFFE_CARA_ELEM.
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Plaat', MATER=MAT_1),
    ),
)


# =====================================================
# 6. BOUNDARY CONDITIONS AND LOADS
# Generated by bridge_to_aster.py from model_data["bcs"] and
# model_data["couplings"]. Supported Code-Aster keywords:
#   DDL_IMPO       - fixed support, prescribed displacement/rotation
#   FORCE_NODALE   - point forces
#   PRES_REP       - surface pressure
#   PESANTEUR      - gravity (requires RHO in the material)
#   LIAISON_SOLIDE - rigid body coupling (RBE2)
#   LIAISON_RBE3   - distributing coupling (RBE3)
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    LIAISON_OBLIQUE=(
        _F(GROUP_NO='BRFR1', ANGL_NAUT=(-45.0, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR2', ANGL_NAUT=(-33.74999999980065, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR3', ANGL_NAUT=(-39.37500000017579, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR4', ANGL_NAUT=(-22.499999999816605, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR5', ANGL_NAUT=(-28.12500000039498, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR6', ANGL_NAUT=(-11.250000000191275, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR7', ANGL_NAUT=(-16.87499999994463, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR8', ANGL_NAUT=(0.0, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR9', ANGL_NAUT=(-5.624999999774097, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR10', ANGL_NAUT=(11.250000000191276, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR11', ANGL_NAUT=(5.624999999774099, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR12', ANGL_NAUT=(22.499999999816605, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR13', ANGL_NAUT=(16.87499999994463, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR14', ANGL_NAUT=(33.74999999980065, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR15', ANGL_NAUT=(28.125000000394984, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR16', ANGL_NAUT=(45.0, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR17', ANGL_NAUT=(39.37500000017579, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR18', ANGL_NAUT=(56.25000000019935, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR19', ANGL_NAUT=(50.62499999982421, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR20', ANGL_NAUT=(67.50000000018339, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR21', ANGL_NAUT=(61.874999999605016, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR22', ANGL_NAUT=(78.74999999980872, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR23', ANGL_NAUT=(73.12500000005538, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR24', ANGL_NAUT=(90.0, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR25', ANGL_NAUT=(84.3750000002259, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR26', ANGL_NAUT=(101.25000000019128, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR27', ANGL_NAUT=(95.6249999997741, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR28', ANGL_NAUT=(112.49999999981661, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR29', ANGL_NAUT=(106.87499999994462, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR30', ANGL_NAUT=(123.74999999980065, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR31', ANGL_NAUT=(118.12500000039498, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR32', ANGL_NAUT=(135.0, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR33', ANGL_NAUT=(129.3750000001758, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR34', ANGL_NAUT=(146.25000000019935, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR35', ANGL_NAUT=(140.6249999998242, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR36', ANGL_NAUT=(157.5000000001834, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR37', ANGL_NAUT=(151.87499999960502, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR38', ANGL_NAUT=(168.74999999980872, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR39', ANGL_NAUT=(163.12500000005537, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR40', ANGL_NAUT=(180.0, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR41', ANGL_NAUT=(174.37500000022592, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR42', ANGL_NAUT=(-168.74999999980872, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR43', ANGL_NAUT=(-174.37500000022592, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR44', ANGL_NAUT=(-157.5000000001834, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR45', ANGL_NAUT=(-163.12500000005537, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR46', ANGL_NAUT=(-146.25000000019935, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR47', ANGL_NAUT=(-151.87499999960502, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR48', ANGL_NAUT=(-135.0, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR49', ANGL_NAUT=(-140.6249999998242, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR50', ANGL_NAUT=(-123.74999999980065, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR51', ANGL_NAUT=(-129.3750000001758, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR52', ANGL_NAUT=(-112.49999999981661, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR53', ANGL_NAUT=(-118.12500000039498, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR54', ANGL_NAUT=(-101.25000000019128, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR55', ANGL_NAUT=(-106.87499999994462, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR56', ANGL_NAUT=(-90.0, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR57', ANGL_NAUT=(-95.6249999997741, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR58', ANGL_NAUT=(-78.74999999980872, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR59', ANGL_NAUT=(-84.37500000022591, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR60', ANGL_NAUT=(-67.5000000001834, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR61', ANGL_NAUT=(-73.12500000005538, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR62', ANGL_NAUT=(-56.25000000019935, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR63', ANGL_NAUT=(-61.874999999605016, -0.0, 0.0), DRY=0.0),
        _F(GROUP_NO='BRFR64', ANGL_NAUT=(-50.62499999982422, -0.0, 0.0), DRY=0.0),
    ),
    DDL_IMPO=(
        _F(GROUP_NO='RandKnopen', DX=0.0),
        _F(GROUP_NO='RandKnopen', DY=0.0),
        _F(GROUP_NO='RandKnopen', DZ=0.0),
    ),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    PRES_REP=_F(GROUP_MA='Vlak', PRES=10.0),
)


# =====================================================
# 7. SOLVER: LINEAR STATIC
# MECA_STATIQUE solves Ku=F for linear elastic behaviour.
# CARA_ELEM=cara is included as soon as step 3b contains an AFFE_CARA_ELEM
# (beam, shell, spring sections or POI1 nodes); otherwise omitted.
# SOLVEUR (setting "lin_solver"): MUMPS (direct) with NPREC from
# "solver_nprec" (Code-Aster default 8) and RESI_RELA ("lin_solver_resi",
# default 1e-6) as the limit for the estimated error of the solution; or GCPC
# (iterative, PRE_COND='LDLT_INC') with RESI_RELA as residual criterion.
# INFO=2: solver statistics in the .mess (convergence monitor).
# =====================================================
res = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    EXCIT=(
        _F(CHARGE=load_1),
        _F(CHARGE=load_2),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8, RESI_RELA=1e-06),
    INFO=2,
)

# =====================================================
# 8. COMPUTE POST-PROCESSING FIELDS  (CALC_CHAMP)
# Generated by bridge_to_aster.py based on element types.
#
# REAC_NODA:
#   Separate call without GROUP_MA (all nodes); with elastic support
#   without the springs (BRES*), so that the spring force is the reaction.
#
# SIGM_NOEU / SIEQ_NOEU:
#   Only on the 3D elsets (GROUP_MA). Shell stresses have
#   sub-points (layers) and do not fit in a NOEU field. Without
#   3D elsets (also with AFFE_MODELE TOUT='OUI') this call is dropped.
#
# Shells (DKT / COQUE_3D):
#   SIGM_ELNO -> POST_CHAMP EXTR_COQUE ('SUP', 'MOY' and 'INF')
#   -> SIEQ_ELNO -> SIEQ_NOEU in res_sup / res_moy / res_inf.
#
# Beams (POU_D_E, cross-section RECTANGLE or CERCLE):
#   SIPM_ELNO = SIXXMIN / SIXXMAX in the cross-section.
#
# Error estimator (setting error_estimator, volume elements only):
#   separate model, load and result res_err, then CALC_ERREUR ERME_ELEM /
#   ERME_ELNO / ERME_NOEU; see _error_estimator_block() and
#   docs/Foutschatter.md.
#
# See _build_calc_champ_block() in bridge_to_aster.py.
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Shells: stresses per layer (sub-points) -> extract top, middle
# and bottom surface separately (POST_CHAMP EXTR_COQUE).
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    CONTRAINTE=('SIGM_ELNO', ),
)

res_sup = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='SUP',
    ),
)
res_sup = CALC_CHAMP(reuse=res_sup, RESULTAT=res_sup, GROUP_MA=('Plaat',), CRITERES=('SIEQ_ELNO', ))
res_sup = CALC_CHAMP(reuse=res_sup, RESULTAT=res_sup, GROUP_MA=('Plaat',), CRITERES=('SIEQ_NOEU', ))

res_moy = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='MOY',
    ),
)
res_moy = CALC_CHAMP(reuse=res_moy, RESULTAT=res_moy, GROUP_MA=('Plaat',), CRITERES=('SIEQ_ELNO', ))
res_moy = CALC_CHAMP(reuse=res_moy, RESULTAT=res_moy, GROUP_MA=('Plaat',), CRITERES=('SIEQ_NOEU', ))

res_inf = POST_CHAMP(
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    EXTR_COQUE=_F(
        NOM_CHAM=('SIGM_ELNO', ),
        NUME_COUCHE=1,
        NIVE_COUCHE='INF',
    ),
)
res_inf = CALC_CHAMP(reuse=res_inf, RESULTAT=res_inf, GROUP_MA=('Plaat',), CRITERES=('SIEQ_ELNO', ))
res_inf = CALC_CHAMP(reuse=res_inf, RESULTAT=res_inf, GROUP_MA=('Plaat',), CRITERES=('SIEQ_NOEU', ))

# Forces and moments per length of shells (result field shell_forces).
res_efs = CALC_CHAMP(RESULTAT=res, GROUP_MA=('Plaat',), CONTRAINTE=('EFGE_ELNO', ))

# Mass and reaction check (Aubry 2019, par. 4.13-4.14): mass,
# centre of gravity and sum of REAC_NODA in the .mess
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
try:
    aster_results_export.print_static_check(res, model, fieldmat,
                                            globals().get('cara'),
                                            mass=True)
except Exception as _sc_err:
    print('BRIDGE_STATCHECK_SKIPPED',
          getattr(_sc_err, 'id_message', '') or _sc_err)



# =====================================================
# 9. RESULT EXTRACTION TO TABLES  (POST_RELEVE_T)
# Generated by bridge_to_aster.py based on element types.
# Displacements and reaction forces are always extracted.
# tab_sigm / tab_vmis : 3D elsets
# tab_vmss / tab_vmsm / tab_vmsi : shells, von Mises top/middle/bottom
# tab_sipm            : beams (RECTANGLE / CERCLE), SIXXMIN / SIXXMAX
# INTITULE is at most 16 characters (Code-Aster truncates longer ones).
#
# Separate tables per field so that INTITULE (parts[0] in the parser)
# uniquely identifies the field in AsterToMecway_results()
# in bridge_from_aster.py.
# =====================================================
#-- tables not needed (result_route='liml') --


# =====================================================
# 10. WRITE TABLES TO .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# Only the tables created in step 9 are written.
# =====================================================
# Results in Mecway's own format (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\LS-83\\LS-83_verif_results.xml', '<WORKDIR>\\LS-83\\LS-83.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err', 'eps_sup', 'eps_moy',
                        'eps_inf', 'res_efs')
                       if k in globals()),
    failures=globals().get('_bz_events'),
    precision='double', opt_in=['shell_forces'])


# =====================================================
# 11. EXPORT TO MED FORMAT (ParaView / Salome), only with the
# setting "med_export" (bridge_to_aster._build_impr_resu_block;
