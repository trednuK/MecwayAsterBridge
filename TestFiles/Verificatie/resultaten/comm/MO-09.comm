# =====================================================
# 2. MODEL, SECTIONS, MATERIALS (as in MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Plaat', PHENOMENE='MECANIQUE', MODELISATION='COQUE_3D'),
    ),
)


cara = AFFE_CARA_ELEM(
    MODELE=model,
    COQUE=_F(GROUP_MA='Plaat', EPAIS=0.001),
)


# material 'Plaat1'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Plaat', MATER=MAT_1),
    ),
)


