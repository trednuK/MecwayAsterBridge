MAT_1_Q_RHO = DEFI_CONSTANTE(VALE=7800.0)
MAT_1_Q_SY = DEFI_FONCTION(NOM_PARA='TEMP', VALE=(
    20.0, 355000000.0,
    200.0, 300000000.0,
    400.0, 250000000.0,
    600.0, 150000000.0,
    800.0, 50000000.0,
    1000.0, 25000000.0,
    1200.0, 15000000.0,
    1500.0, 10000000.0,
), PROL_GAUCHE='CONSTANT', PROL_DROITE='CONSTANT')
MAT_1_Q_ET = DEFI_FONCTION(NOM_PARA='TEMP', VALE=(
    20.0, 99526.0663507109,
    200.0, 99502.4875621891,
    400.0, 99447.5138121547,
    600.0, 99173.5537190083,
    800.0, 98360.6557377049,
