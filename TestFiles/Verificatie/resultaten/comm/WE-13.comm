    1500.0, 90909.0909090909,
), PROL_GAUCHE='CONSTANT', PROL_DROITE='CONSTANT')
MAT_1_Q = DEFI_MATERIAU(
    ELAS_FO=_F(E=MAT_1_Q_E, NU=MAT_1_Q_NU, RHO=MAT_1_Q_RHO, ALPHA=MAT_1_Q_ALPHA, TEMP_DEF_ALPHA=20.0),
    ECRO_LINE_FO=_F(D_SIGM_EPSI=MAT_1_Q_ET, SY=MAT_1_Q_SY),
)

fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Plaat', MATER=MAT_1),
        _F(GROUP_MA='LASNAAD_1', MATER=MAT_1),
        _F(GROUP_MA='LASNAAD_2', MATER=MAT_1),
        _F(GROUP_MA='TH39', MATER=MAT_1_Q),
    ),
    AFFE_VARC=(
        _F(TOUT='OUI', NOM_VARC='TEMP', EVOL=res_ther, NOM_CHAM='TEMP', VALE_REF=20.0),
    ),
)


# =====================================================
# 11. MECHANICAL BOUNDARY CONDITIONS, LOADS AND TIME STEPS
# =====================================================
#-- no time-dependent loads in this model --
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_MA='Sym', DY=0.0),
        _F(GROUP_NO='A', DX=0.0),
        _F(GROUP_NO='A', DZ=0.0),
        _F(GROUP_NO='B', DZ=0.0),
    ),
)

# Mechanical steps = the thermal times; on divergence cut the step (ECHEC DECOUPE)
listinst = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=times),
    ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE',
             SUBD_METHODE='MANUEL', SUBD_PAS=4, SUBD_NIVEAU=6),
)


# =====================================================
# 12. MECHANICAL SOLVE (STAT_NON_LINE at the thermal times)
# =====================================================
# --- Filler material (bridge_thermomech._birth_solve): STAT_NON_LINE per birth step ---
_gm_affe = [
    _F(GROUP_MA='Plaat', MATER=MAT_1),
    _F(GROUP_MA='LASNAAD_1', MATER=MAT_1),
    _F(GROUP_MA='LASNAAD_2', MATER=MAT_1),
    _F(GROUP_MA='TH39', MATER=MAT_1_Q),
]
_gm_born = {
    1: [('TH3', MAT_1)],
    3: [('TH4', MAT_1)],
    5: [('TH5', MAT_1)],
    6: [('TH6', MAT_1)],
    7: [('TH7', MAT_1)],
    9: [('TH8', MAT_1)],
    10: [('TH9', MAT_1)],
    11: [('TH10', MAT_1)],
    12: [('TH11', MAT_1)],
    14: [('TH12', MAT_1)],
    15: [('TH13', MAT_1)],
    16: [('TH14', MAT_1)],
    17: [('TH15', MAT_1)],
    18: [('TH16', MAT_1)],
    20: [('TH17', MAT_1)],
    21: [('TH18', MAT_1)],
    30: [('TH19', MAT_1)],
    31: [('TH20', MAT_1)],
    33: [('TH21', MAT_1)],
    34: [('TH22', MAT_1)],
    35: [('TH23', MAT_1)],
    36: [('TH24', MAT_1)],
    37: [('TH25', MAT_1)],
    39: [('TH26', MAT_1)],
    40: [('TH27', MAT_1)],
    41: [('TH28', MAT_1)],
    42: [('TH29', MAT_1)],
    44: [('TH30', MAT_1)],
    45: [('TH31', MAT_1)],
    46: [('TH32', MAT_1)],
    47: [('TH33', MAT_1)],
    48: [('TH34', MAT_1)],
    49: [('TH35', MAT_1)],
    50: [('TH36', MAT_1)],
    51: [('TH37', MAT_1)],
}
_gm_t = list(times.getValues())
_gm_alive = []
_gm_new = []
_gm_start = 0
res = None
try:
    for _gm_k in sorted(_gm_born) + [len(_gm_t)]:
        _gm_stop = min(_gm_k - 1, len(_gm_t) - 1)
        if _gm_stop > _gm_start:
            _gm_fm = AFFE_MATERIAU(MAILLAGE=mesh, MODELE=model, AFFE=tuple(
                _gm_affe + [_F(GROUP_MA=_g, MATER=_m) for _g, _m in _gm_alive]),
                AFFE_VARC=(
        _F(TOUT='OUI', NOM_VARC='TEMP', EVOL=res_ther, NOM_CHAM='TEMP', VALE_REF=20.0),
    ))
            _gm_pred = 'TANGENTE'
            _gm_kw = {}
            if res is not None and _gm_new:
                # newly born: stress and internal variables to zero
                _gm_last = res.getLastIndex()
                _gm_s = res.getField('SIEF_ELGA', _gm_last)
                _gm_ei = dict(DEPL=res.getField('DEPL', _gm_last), SIGM=CREA_CHAMP(
                    OPERATION='ASSE', TYPE_CHAM='ELGA_SIEF_R', MODELE=model, PROL_ZERO='OUI',
                    ASSE=(_F(CHAM_GD=_gm_s, TOUT='OUI'),
                          _F(CHAM_GD=_gm_s, GROUP_MA=tuple(_gm_new), COEF_R=0.0))))
                _gm_v = res.getField('VARI_ELGA', _gm_last)
                _gm_ei['VARI'] = CREA_CHAMP(
                    OPERATION='ASSE', TYPE_CHAM='ELGA_VARI_R', MODELE=model, PROL_ZERO='OUI',
                    ASSE=(_F(CHAM_GD=_gm_v, TOUT='OUI'),
                          _F(CHAM_GD=_gm_v, GROUP_MA=tuple(_gm_new), COEF_R=0.0)))
                _gm_kw = dict(reuse=res, RESULTAT=res, ETAT_INIT=_F(**_gm_ei))
                _gm_pred = 'ELASTIQUE'
            elif res is not None:
                _gm_kw = dict(reuse=res, RESULTAT=res, ETAT_INIT=_F(EVOL_NOLI=res))
            res = STAT_NON_LINE(
                MODELE=model,
                CHAM_MATER=_gm_fm,
                EXCIT=_F(CHARGE=load_1),
                COMPORTEMENT=(
                    _F(GROUP_MA='Plaat', RELATION='VMIS_ISOT_LINE', DEFORMATION='PETIT'),
                    _F(GROUP_MA='LASNAAD_1', RELATION='VMIS_ISOT_LINE', DEFORMATION='PETIT'),
                    _F(GROUP_MA='LASNAAD_2', RELATION='VMIS_ISOT_LINE', DEFORMATION='PETIT'),
                ),
                INCREMENT=_F(LIST_INST=listinst, INST_INIT=_gm_t[_gm_start],
                             INST_FIN=_gm_t[_gm_stop]),
                ARCHIVAGE=_F(LIST_INST=times),
                SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
                NEWTON=_F(REAC_ITER=1, PREDICTION=_gm_pred),
                RECH_LINEAIRE=_F(ITER_LINE_MAXI=5),
                CONVERGENCE=_F(RESI_GLOB_RELA=1e-06, ITER_GLOB_MAXI=20),
                **_gm_kw)
            _gm_start = _gm_stop
            _gm_new = []
        if _gm_k < len(_gm_t):
            _gm_alive += _gm_born[_gm_k]
            _gm_new += [_g for _g, _m in _gm_born[_gm_k]]
except Exception as err:
    if not str(getattr(err, 'id_message', '')).startswith('MECANONLINE'):
        raise
    print('BRIDGE_ONVOLLEDIG', res.getAccessParameters()['INST'][-1])
print('BRIDGE_GEBOORTE_MECA %d' % len(_gm_alive))
t_res = res.getAccessParameters()['INST'][-1]


# =====================================================
# 13. STRESSES, PLASTIC STRAIN AND SUMMARY
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Stresses per element node for Mecway (result_route 'liml').
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Plaat', 'LASNAAD_1', 'LASNAAD_2',),
    CONTRAINTE=('SIGM_ELNO', ),
)
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Plaat', 'LASNAAD_1', 'LASNAAD_2',),
    CRITERES=('SIEQ_ELNO', ),
)

res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Plaat', 'LASNAAD_1', 'LASNAAD_2',),
    CONTRAINTE=('SIGM_NOEU', ),
    CRITERES=('SIEQ_NOEU', ),
    DEFORMATION=('EPSP_NOEU', ),
    VARI_INTERNE=('VARI_NOEU', ),
)

# Thermomechanical summary (bridge_thermomech): residual stress and
# deformation at the last time, lines BRIDGE_THERMOMECA in the .mess.
def _bridge_tm_report(res, res_ther, n_nodes):
    import numpy as np
    out = []
    try:
        acc = res.getAccessParameters()
        idx, t = acc['NUME_ORDRE'][-1], acc['INST'][-1]
        out.append(('t', t))
        acc_t = res_ther.getAccessParameters()
        ok = list(acc_t['INST'][:len(acc['INST'])]) == list(acc['INST'])
        if not ok:
            print('BRIDGE_THERMOMECA_TIJDEN', len(acc['INST']),
                  len(acc_t['INST']))
        idx_t = acc_t['NUME_ORDRE'][acc_t['INST'].index(t)] \
            if t in acc_t['INST'] else acc_t['NUME_ORDRE'][-1]

        def vals(r, name, i):
            sf = r.getField(name, i).toSimpleFieldOnNodes()
            v, m = sf.getValues()
            return list(sf.getComponents()), v[:n_nodes], m[:n_nodes]
        c, v, m = vals(res_ther, 'TEMP', idx_t)
        k = c.index('TEMP')
        out += [('T_min', float(v[m[:, k], k].min()) + 273.15),
                ('T_max', float(v[m[:, k], k].max()) + 273.15)]
        c, v, m = vals(res, 'DEPL', idx)
        uu = np.zeros(v.shape[0])
        for name in ('DX', 'DY', 'DZ'):
            k = c.index(name)
            out += [(name + '_min', float(v[m[:, k], k].min())),
                    (name + '_max', float(v[m[:, k], k].max()))]
            uu += np.where(m[:, k], v[:, k], 0.0) ** 2
        out.append(('U_max', float(np.sqrt(uu.max()))))
        c, v, m = vals(res, 'SIGM_NOEU', idx)
        for name in ('SIXX', 'SIYY', 'SIZZ'):
            k = c.index(name)
            out += [(name + '_min', float(v[m[:, k], k].min())),
                    (name + '_max', float(v[m[:, k], k].max()))]
        c, v, m = vals(res, 'SIEQ_NOEU', idx)
        k = c.index('VMIS')
        out.append(('VMIS_max', float(v[m[:, k], k].max())))
        if 'V1' and 'VARI_NOEU' in res.getFieldsNames():
            c, v, m = vals(res, 'VARI_NOEU', idx)
            k = c.index('V1')
            out.append(('P_max', float(v[m[:, k], k].max())))
            vmax = 0.0
            for i in acc['NUME_ORDRE']:
                c, v, m = vals(res, 'VARI_NOEU', i)
                vmax = max(vmax, float(v[m[:, k], k].max()))
            out.append(('P_max_all', vmax))
    except Exception as exc:
        print('BRIDGE_THERMOMECA_FOUT', repr(exc))
    for key, value in out:
        print('BRIDGE_THERMOMECA %s %r' % (key, value))
_bridge_tm_report(res, res_ther, 1674)


